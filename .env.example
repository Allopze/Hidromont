# -----------------------------------------------------------------------------
# Formulario de Contacto (FormSubmit.co)
# -----------------------------------------------------------------------------

# Correos en copia (CC) para cada envío del formulario. Hasta 4 direcciones.
# Dejar vacío para no incluir en copia.
FORMSUBMIT_CC_1=contacto@empresa.com
FORMSUBMIT_CC_2=
FORMSUBMIT_CC_3=
FORMSUBMIT_CC_4=

# Correo destinatario principal del formulario de contacto.
# Si se deja vacío en la compilación, se utiliza el valor por defecto en código.
PUBLIC_CONTACT_EMAIL=contacto@hidromont.cl

# -----------------------------------------------------------------------------
# Configuración del CMS (Fastify + SQLite)
# -----------------------------------------------------------------------------

# Host y puerto en el que escuchará el servidor backend del CMS.
# Usa 127.0.0.1 para local únicamente. Si necesitas LAN, usa 0.0.0.0 y cambia CMS_ADMIN_PASSWORD.
CMS_HOST=127.0.0.1
CMS_STATIC_DIR=dist
CMS_PORT=8787

# Ruta absoluta o relativa al archivo de base de datos SQLite del CMS.
CMS_DATABASE_PATH=./cms/data/hidromont-cms.sqlite

# Orígenes permitidos (CORS) separados por comas para comunicarse con el API del CMS.
# Para operar desde otro equipo en LAN, agrega explícitamente el origen del sitio de edición.
CMS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Nombre de la cookie de sesión del administrador del CMS.
CMS_COOKIE_NAME=hidromont_cms_session

# Duración en días de la sesión del administrador.
CMS_SESSION_DAYS=7

# Habilita X-Forwarded-For para el rate-limit de login y los logs de auditoría.
# Actívalo SOLO si el CMS corre detrás de un reverse proxy de confianza que fija
# esa cabecera él mismo — de lo contrario cualquier cliente puede falsificarla
# para evadir el rate-limit o ensuciar el log de auditoría con una IP falsa.
CMS_TRUST_PROXY=0

# Límite de tamaño de subida para imágenes de la biblioteca de medios (en bytes).
# Por defecto: 8 MB (8 * 1024 * 1024 = 8388608).
CMS_UPLOAD_MAX_BYTES=8388608
# Tope de un video subido (60 MB). El host del editor en deploy/Caddyfile acepta 64 MB.
CMS_VIDEO_MAX_BYTES=62914560

# Directorio local donde se guardarán las imágenes subidas por el CMS.
# IMPORTANTE: debe quedar FUERA de public/. Astro copia public/ entero a dist/
# en cada build, así que apuntarlo ahí arrastraría los 2+ GB de originales.
# La ruta se resuelve contra la raíz del repo, no contra el CWD del proceso.
# El servidor del CMS los sirve en /uploads/cms (ver cms/staticSite.ts).
CMS_UPLOAD_DIR=./uploads/cms

# Comando que Publicar ejecuta tras exportar, como gate antes de dar el publish
# por exitoso (DOC-3: este es también el default real en cms/config/unifiedConfig.ts
# si la variable no está definida). `npm run build` valida el sitio completo
# (astro check + astro build); `npm run check` por sí solo no detecta errores
# de build que astro check no cubre.
CMS_PUBLISH_CHECK_COMMAND=npm run build

# Tiempo máximo del comando anterior. 120 s bastaban para `astro check`, pero
# no para un `npm run build` completo con procesado de imágenes, que es lo que
# hace falta para que publicar actualice el sitio servido.
CMS_PUBLISH_TIMEOUT_MS=600000

# Define si la cookie de sesión del CMS exige HTTPS (secure: true).
# Por defecto se activa en producción. Configura a 0 para pruebas locales/LAN sin SSL.
CMS_COOKIE_SECURE=1

# Escape hatch para LAN: permite arrancar el CMS expuesto (CMS_HOST=0.0.0.0) sin HTTPS.
# Por defecto el guard de arranque bloquea host expuesto + cookie insegura. Solo activar
# en redes de confianza explícitamente.
CMS_ALLOW_INSECURE_COOKIE=

# Habilita el editor visual inline del CMS en el frontend compilado (1 para activar, 0 o vacío para desactivar).
PUBLIC_ENABLE_CMS=0

# URL base del API del CMS al que se conectará el frontend (vacío para detección automática).
PUBLIC_CMS_API_BASE=http://localhost:8787

# -----------------------------------------------------------------------------
# Credenciales del Administrador del CMS
# -----------------------------------------------------------------------------
CMS_ADMIN_EMAIL=admin@hidromont.local
# La contraseña por defecto solo funciona con CMS_HOST local. El CMS falla al iniciar si se expone a la red con este valor.
CMS_ADMIN_PASSWORD=Hidromont-Admin-ChangeMe

# -----------------------------------------------------------------------------
# Monitoreo de Errores (Opcional - Sentry)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
