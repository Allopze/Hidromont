# El botón «Run NPM Install» de cPanel corre con NODE_ENV=production, y en ese
# modo npm se salta las devDependencies. Astro y @astrojs/* están ahí, así que
# sin esto el servidor instala sin poder compilar. Comprobado con npm 11.16.
include=dev

# El primer intento en el servidor murió a mitad de la extracción, tras bajar
# 975 paquetes con descargas de hasta 184 s. Estas tres opciones quitan trabajo
# de red en los reintentos, que es lo que hace que quepan en el límite de
# tiempo del panel:
#
#   prefer-offline  usa lo que ya está en la caché sin comprobar si caducó, y
#                   solo pide a la red lo que de verdad falta. Con los 975
#                   paquetes ya cacheados, eso es casi todo.
#   audit           evita la consulta de vulnerabilidades al final, que es una
#                   petición más y no aporta nada durante un despliegue.
#   fund            suprime el recuento de patrocinios.
prefer-offline=true
audit=false
fund=false

# B-06 (auditoría 2026-09-28): npm 11 avisa de los scripts de instalación que
# no están aprobados y las versiones siguientes los bloquearán por defecto. Sin
# el de better-sqlite3 no hay binario y el CMS no arranca en el VPS. La lista
# vive en `allowScripts` de package.json, por nombre y no por versión, para que
# una actualización no la invalide: better-sqlite3 y esbuild, sí; fsevents (solo
# macOS) trae su binario compilado y no necesita el suyo.
