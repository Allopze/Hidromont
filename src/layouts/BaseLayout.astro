---
import '../styles/global.css';
import { company } from '../data/company';
import CmsOverlay from '../components/cms/CmsOverlay.astro';

import { safeJsonForScript } from '../utils/safeJson';

/**
 * El editor solo entra en el build cuando corresponde, y la decisión vive
 * aquí: Astro incluye los scripts de un componente solo si ese componente
 * llega a renderizarse, así que este condicional es lo que mantiene `dist/`
 * limpio en el perfil público. Dentro de CmsOverlay no serviría: el compilador
 * descarta los `<script>` que quedan bajo una condición, y lo hace sin avisar.
 */
const cmsHabilitado = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = company.descripcionCorta,
  image = '/og/og-default.jpg',
  canonical,
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${company.nombre}` : company.nombre;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(image, Astro.site).toString();

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.nombre,
  url: company.sitioWeb,
  logo: new URL('/logo.png', Astro.site).toString(),
  telephone: company.telefono,
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.domicilio,
    addressLocality: 'Los Ángeles',
    addressRegion: 'Biobío',
    addressCountry: 'CL',
  },
  foundingDate: '1983',
  description: company.descripcionCorta,
};

const allJsonLd = [
  organizationJsonLd,
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="es-CL">
  <head>
    <!-- .js flag added first — motion.css gates initial-hidden states on html.js -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <!-- UIUX-11 fix: motion.ts is what actually adds `.is-visible` to
         [data-reveal] elements; if that separate bundle fails to load or
         throws before running (network hiccup, CSP block, an unrelated
         bundle error), those elements stay opacity:0 forever. motion.ts
         marks documentElement[data-motion-ready] the instant it starts — if
         that never happens within a generous grace period, force everything
         visible so content isn't silently lost. -->
    <script is:inline>
      setTimeout(() => {
        if (document.documentElement.hasAttribute('data-motion-ready')) return;
        document
          .querySelectorAll('[data-reveal], [data-reveal-group], [data-reveal-cinematic]')
          .forEach((el) => el.classList.add('is-visible'));
        // [data-count] stats are hidden the same way (html.js [data-count])
        // until motion.ts's counter animation reveals them — same failure
        // mode, same fallback: show the plain (unanimated) value.
        document.querySelectorAll('[data-count]').forEach((el) => {
          if (el instanceof HTMLElement) el.style.visibility = 'visible';
        });
      }, 4000);
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- Preload fonts: heading (Roboto Condensed Bold) + body (Inter variable) para
         evitar FOUT/fallback en el primer paint. B1-001: Inter ahora va con preload
         además de font-display: optional, para que el body no caiga a Arial en
         conexiones lentas (48 KB, variable font en un solo archivo). -->
    <link rel="preload" href="/fonts/rc-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-vf.woff2" as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={company.nombre} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- JSON-LD -->
    {
      allJsonLd.map((ld) => (
        <script is:inline type="application/ld+json" set:html={safeJsonForScript(ld)} />
      ))
    }
  </head>
  <body>
    <slot />
    {cmsHabilitado && <CmsOverlay />}
  </body>
</html>
