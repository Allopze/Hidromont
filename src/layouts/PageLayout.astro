---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  currentPath?: string;
  headerOverlay?: boolean;
  hideFooterMap?: boolean;
}

const { currentPath, headerOverlay = false, hideFooterMap = false, ...baseProps } = Astro.props;
---

<BaseLayout {...baseProps}>
  {/* Skip-to-content: visible on focus for keyboard / screen reader users */}
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:font-semibold focus:shadow-md focus:outline focus:outline-[3px] focus:outline-primary/30"
  >
    Ir al contenido principal
  </a>
  <Header currentPath={currentPath ?? Astro.url.pathname} overlay={headerOverlay} />
  <main id="main">
    <slot />
  </main>
  <Footer hideMap={hideFooterMap} />
  <!-- Motion: scroll reveals, parallax, counters -->
  <script src="../scripts/motion.ts"></script>
</BaseLayout>

