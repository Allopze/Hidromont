---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  currentPath?: string;
  headerOverlay?: boolean;
}

const { currentPath, headerOverlay = false, ...baseProps } = Astro.props;
---

<BaseLayout {...baseProps}>
  <Header currentPath={currentPath ?? Astro.url.pathname} overlay={headerOverlay} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <!-- Motion: scroll reveals, parallax, counters -->
  <script src="../scripts/motion.ts"></script>
</BaseLayout>
