---
import PageLayout from '../layouts/PageLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import ContactInfo from '../components/contact/ContactInfo.astro';
import { getCmsText } from '../data/cms';
import EditableText from '../components/cms/EditableText.astro';
---

<PageLayout
  title="Contacto"
  description="Contáctese con el equipo técnico de Hidromont Chile S.A. para consultas de ingeniería, fabricación o montaje de equipos hidromecánicos."
  hideFooterMap
>
  <div class="grid grid-cols-1 lg:grid-cols-2 items-stretch min-h-[calc(100vh-80px)] bg-background">
    <!-- Formulario & Info -->
    <div class="flex justify-center items-start pt-12 lg:pt-24 pb-12 lg:pb-16 px-6 lg:px-12 bg-background">
      <div class="w-full max-w-[570px] flex flex-col gap-12">
        <!-- Formulario -->
        <div>
          <Eyebrow>
            <EditableText entry="contacto.sections" field="formEyebrow">
              {getCmsText('contacto.sections', 'formEyebrow', 'Formulario de contacto')}
            </EditableText>
          </Eyebrow>
          <EditableText as="h2" entry="contacto.sections" field="formTitle" class="font-heading font-semibold text-primary-dark mb-6" style="font-size: var(--font-size-h3);">
            {getCmsText('contacto.sections', 'formTitle', 'Envíe su consulta')}
          </EditableText>
          <ContactForm />
        </div>

        <!-- Info lateral -->
        <div>
          <Eyebrow>
            <EditableText entry="contacto.sections" field="infoEyebrow">
              {getCmsText('contacto.sections', 'infoEyebrow', 'Datos de contacto')}
            </EditableText>
          </Eyebrow>
          <ContactInfo />
        </div>
      </div>
    </div>

    <!-- Mapa -->
    <div class="w-full min-h-[450px] lg:min-h-full">
      <iframe
        src="https://maps.google.com/maps?q=Hidromont%20Chile%20S.A.,%20Avenida%20Las%20Industrias%2010950,%20Los%20Angeles,%20Chile&t=&z=15&ie=UTF8&iwloc=&output=embed"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        title="Ubicación de Hidromont Chile S.A. — Avenida Las Industrias 10950, Los Ángeles, Biobío"
        class="w-full h-full min-h-[450px] lg:min-h-full"
      ></iframe>
    </div>
  </div>
</PageLayout>
