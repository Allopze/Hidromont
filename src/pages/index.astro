---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/home/Hero.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import CapabilitiesBlock from '../components/home/CapabilitiesBlock.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import ClientsStrip from '../components/home/ClientsStrip.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import EditableImage from '../components/cms/EditableImage.astro';
import EditableText from '../components/cms/EditableText.astro';
import { getCollection, getEntry } from 'astro:content';
import { getCmsText } from '../data/cms';

const servicios = await getCollection('servicios');
servicios.sort((a, b) => a.data.orden - b.data.orden);

const proyectosDestacados = await getCollection(
  'proyectos',
  ({ data }) => data.tipo === 'destacado'
);
proyectosDestacados.sort((a, b) => a.data.orden - b.data.orden);

const clientesEntry = await getEntry('clientes', 'clientes');

const instalaciones = [
  { title: 'Taller industrial', description: '3.000 m² equipado para fabricación de equipos de gran dimensión', value: '3.000 m²' },
  { title: 'Oficinas e ingeniería', description: '320 m² con equipo técnico especializado en proyectos hidromecánicos', value: '320 m²' },
  { title: 'Capacidad de izaje', description: 'Puentes grúa de hasta 20 toneladas para maniobras de gran peso', value: '20 Tn' },
  { title: 'Corte plasma', description: 'Mesa de corte ESAB SHARK CS de 12×3 m, plasma hasta 32 mm', value: '12 m' },
];

const propuestaValor = [
  {
    title: 'Especialización sectorial',
    description: 'Empresa enfocada exclusivamente en soluciones hidromecánicas e hidroeléctricas.',
  },
  {
    title: 'EPC / Llave en mano',
    description: 'Diseño, ingeniería, fabricación, suministro, montaje, mantenimiento y rehabilitación.',
  },
  {
    title: 'Calidad certificada',
    description: 'Sistema de gestión basado en norma ISO 9001 y mejora continua.',
  },
  {
    title: 'Experiencia internacional',
    description: 'Proyectos ejecutados en Chile, España, Honduras, Costa Rica y otros países.',
  },
];
---

<PageLayout
  title="Ingeniería y Montaje de Equipos Hidromecánicos"
  description="Hidromont Chile S.A. — Especialistas en ingeniería, fabricación y montaje de equipos hidromecánicos para embalses y centrales hidroeléctricas desde 1983."
  headerOverlay={true}
>
  <!-- Hero -->
  <Hero
    eyebrow={getCmsText('home.hero', 'eyebrow', 'Especialistas en equipos hidromecánicos')}
    title={getCmsText('home.hero', 'title', 'Ingeniería, fabricación y montaje de equipos hidromecánicos')}
    subtitle={getCmsText('home.hero', 'subtitle', 'Más de 40 años de trayectoria en proyectos hidráulicos e hidroeléctricos en Chile y el exterior. Especialistas en soluciones técnicas de alta complejidad desde 1983.')}
    ctaPrimary={{ label: getCmsText('home.hero', 'primaryLabel', 'Conocer nuestros servicios'), href: '/servicios' }}
    ctaSecondary={{ label: getCmsText('home.hero', 'secondaryLabel', 'Ver proyectos'), href: '/proyectos' }}
    cmsEntry="home.hero"
  />

  <!-- Servicios principales -->
  <Section variant="default" id="servicios">
    <Container>
      <div class="text-center mb-12">
        <Eyebrow><EditableText entry="home.services" field="eyebrow">Servicios</EditableText></Eyebrow>
        <EditableText as="h2" entry="home.services" field="title" class="font-heading font-bold text-primary-dark mb-4" style="font-size: var(--font-size-h2);">
          {getCmsText('home.services', 'title', 'Soluciones hidromecánicas llave en mano')}
        </EditableText>
        <EditableText as="p" entry="home.services" field="subtitle" type="textarea" class="text-text-muted max-w-2xl mx-auto" style="font-size: var(--font-size-body-lg);">
          {getCmsText('home.services', 'subtitle', 'Cubrimos toda la cadena de valor de los proyectos hidromecánicos: desde ingeniería y fabricación hasta montaje, mantenimiento y rehabilitación en terreno.')}
        </EditableText>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-group>
        {servicios.map((s) => (
          <ServiceCard
            title={s.data.titulo}
            description={s.data.resumen}
            href={`/servicios/${s.slug}`}
            icon={s.data.icono}
            bullets={s.data.tipos?.slice(0, 3)}
          />
        ))}
      </div>
    </Container>
  </Section>

  <!-- Propuesta de valor / capacidades -->
  <Section variant="alt">
    <CapabilitiesBlock
      eyebrow={getCmsText('home.capabilities', 'eyebrow', 'Por qué elegirnos')}
      title={getCmsText('home.capabilities', 'title', 'Capacidad técnica y experiencia comprobada')}
      subtitle={getCmsText('home.capabilities', 'subtitle', 'Más de 40 años de trayectoria en proyectos hidráulicos nacionales e internacionales.')}
      items={propuestaValor}
      columns={4}
      cmsEntry="home.capabilities"
    />
  </Section>

  <!-- Instalaciones -->
  <Section variant="strong">
    <Container size="2xl">
      <div class="mb-10">
        <div class="relative overflow-hidden rounded-lg" style="border: 1px solid rgba(255,255,255,0.08);">
          <div
            class="absolute inset-0 z-10 rounded-lg pointer-events-none"
            style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.12), inset 0 -1px 0 rgba(0,0,0,0.2);"
            aria-hidden="true"
          ></div>
          <EditableImage
            entry="home.installations"
            field="image"
            altField="imageAlt"
            src={getCmsText('home.installations', 'image', '/fotos/curadas/fabricacion-tuberias-taller.webp')}
            alt={getCmsText('home.installations', 'imageAlt', 'Fabricación de tuberías forzadas de gran diámetro en el taller de Hidromont')}
            width="1834"
            height="858"
            loading="lazy"
            decoding="async"
            class="block w-full h-auto object-cover"
            style="max-height: 420px;"
          />
        </div>
      </div>
    </Container>
    <CapabilitiesBlock
      eyebrow={getCmsText('home.installations', 'eyebrow', 'Instalaciones y medios productivos')}
      title={getCmsText('home.installations', 'title', 'Taller propio en Los Ángeles, Biobío')}
      subtitle={getCmsText('home.installations', 'subtitle', 'Infraestructura especializada para responder a proyectos complejos con rapidez y precisión.')}
      items={instalaciones}
      columns={4}
      light
      cmsEntry="home.installations"
    />
  </Section>

  <!-- Proyectos destacados -->
  {proyectosDestacados.length > 0 && (
    <Section variant="default" id="proyectos">
      <Container>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
          <div>
            <Eyebrow><EditableText entry="home.projects" field="eyebrow">Experiencia</EditableText></Eyebrow>
            <EditableText as="h2" entry="home.projects" field="title" class="font-heading font-bold text-primary-dark" style="font-size: var(--font-size-h2);">
              {getCmsText('home.projects', 'title', 'Proyectos destacados')}
            </EditableText>
          </div>
          <Button href="/proyectos" variant="secondary">{getCmsText('home.projects', 'buttonLabel', 'Ver todos los proyectos')}</Button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-group>
          {proyectosDestacados.slice(0, 6).map((p) => (
            <ProjectCard proyecto={p} />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- Clientes -->
  <Section variant="alt">
    <ClientsStrip clientes={clientesEntry} />
  </Section>

  <!-- CTA final -->
  <Section variant="strong">
    <Container size="md">
      <div class="text-center">
        <Eyebrow light><EditableText entry="home.cta" field="eyebrow">Contáctenos</EditableText></Eyebrow>
        <EditableText as="h2" entry="home.cta" field="title" class="font-heading font-bold text-white mb-4" style="font-size: var(--font-size-h2);">
          {getCmsText('home.cta', 'title', '¿Quiere saber más sobre nuestra empresa?')}
        </EditableText>
        <EditableText as="p" entry="home.cta" field="subtitle" type="textarea" class="text-white/70 mb-8" style="font-size: var(--font-size-body-lg);">
          {getCmsText('home.cta', 'subtitle', 'Estamos disponibles para presentar nuestra trayectoria, capacidades técnicas y experiencia en proyectos hidromecánicos nacionales e internacionales.')}
        </EditableText>
        <div class="flex flex-wrap justify-center gap-4">
          <Button href="/contacto" size="lg">{getCmsText('home.cta', 'primaryLabel', 'Ponerse en contacto')}</Button>
          <Button href="/empresa" variant="secondary-light" size="lg">
            {getCmsText('home.cta', 'secondaryLabel', 'Conocer la empresa')}
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</PageLayout>
