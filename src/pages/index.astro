---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/home/Hero.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import CapabilitiesBlock from '../components/home/CapabilitiesBlock.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import ClientsStrip from '../components/home/ClientsStrip.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import { getCollection, getEntry } from 'astro:content';

const servicios = await getCollection('servicios');
servicios.sort((a, b) => a.data.orden - b.data.orden);

const proyectosDestacados = await getCollection(
  'proyectos',
  ({ data }) => data.tipo === 'destacado'
);
proyectosDestacados.sort((a, b) => a.data.orden - b.data.orden);

const clientesEntry = await getEntry('clientes', 'clientes');

const instalaciones = [
  { title: 'Taller industrial', description: '3.000 m² equipado para fabricación de equipos de gran dimensión', value: '3.000 m²' },
  { title: 'Oficinas e ingeniería', description: '320 m² con equipo técnico especializado en proyectos hidromecánicos', value: '320 m²' },
  { title: 'Capacidad de izaje', description: 'Puentes grúa de hasta 20 toneladas para maniobras de gran peso', value: '20 Tn' },
  { title: 'Corte plasma', description: 'Mesa de corte ESAB SHARK CS de 12×3 m, plasma hasta 32 mm', value: '12 m' },
];

const propuestaValor = [
  {
    title: 'Especialización sectorial',
    description: 'Empresa enfocada exclusivamente en soluciones hidromecánicas e hidroeléctricas.',
  },
  {
    title: 'EPC / Llave en mano',
    description: 'Diseño, ingeniería, fabricación, suministro, montaje, mantenimiento y rehabilitación.',
  },
  {
    title: 'Calidad certificada',
    description: 'Sistema de gestión basado en norma ISO 9001 y mejora continua.',
  },
  {
    title: 'Experiencia internacional',
    description: 'Proyectos ejecutados en Chile, España, Honduras, Costa Rica y otros países.',
  },
];
---

<PageLayout
  title="Ingeniería y Montaje de Equipos Hidromecánicos"
  description="Hidromont Chile S.A. — Especialistas en ingeniería, fabricación y montaje de equipos hidromecánicos para embalses y centrales hidroeléctricas desde 1983."
>
  <!-- Hero -->
  <Hero
    title="Ingeniería, fabricación y montaje de equipos hidromecánicos"
    subtitle="Más de 40 años de trayectoria en proyectos hidráulicos e hidroeléctricos en Chile y el exterior. Especialistas en soluciones técnicas de alta complejidad desde 1983."
    ctaPrimary={{ label: 'Conocer nuestros servicios', href: '/servicios' }}
    ctaSecondary={{ label: 'Ver proyectos', href: '/proyectos' }}
    imageSrc="/fotos/hero-bg.jpg"
  />

  <!-- Servicios principales -->
  <Section variant="default" id="servicios">
    <Container>
      <div class="text-center mb-12">
        <Eyebrow>Servicios</Eyebrow>
        <h2 class="font-heading font-bold text-primary-dark mb-4" style="font-size: var(--font-size-h2);">
          Soluciones hidromecánicas llave en mano
        </h2>
        <p class="text-text-muted max-w-2xl mx-auto" style="font-size: var(--font-size-body-lg);">
          Cubrimos toda la cadena de valor de los proyectos hidromecánicos: desde ingeniería y fabricación hasta montaje, mantenimiento y rehabilitación en terreno.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicios.map((s) => (
          <ServiceCard
            title={s.data.titulo}
            description={s.data.resumen}
            href={`/servicios/${s.slug}`}
            icon={s.data.icono}
            bullets={s.data.tipos?.slice(0, 3)}
          />
        ))}
      </div>
    </Container>
  </Section>

  <!-- Propuesta de valor / capacidades -->
  <Section variant="alt">
    <CapabilitiesBlock
      eyebrow="Por qué elegirnos"
      title="Capacidad técnica y experiencia comprobada"
      subtitle="Más de 40 años de trayectoria en proyectos hidráulicos nacionales e internacionales."
      items={propuestaValor}
      columns={4}
    />
  </Section>

  <!-- Instalaciones -->
  <Section variant="strong">
    <CapabilitiesBlock
      eyebrow="Instalaciones y medios productivos"
      title="Taller propio en Los Ángeles, Biobío"
      subtitle="Infraestructura especializada para responder a proyectos complejos con rapidez y precisión."
      items={instalaciones}
      columns={4}
      light
    />
  </Section>

  <!-- Proyectos destacados -->
  {proyectosDestacados.length > 0 && (
    <Section variant="default" id="proyectos">
      <Container>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
          <div>
            <Eyebrow>Experiencia</Eyebrow>
            <h2 class="font-heading font-bold text-primary-dark" style="font-size: var(--font-size-h2);">
              Proyectos destacados
            </h2>
          </div>
          <Button href="/proyectos" variant="secondary">Ver todos los proyectos</Button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {proyectosDestacados.slice(0, 6).map((p) => (
            <ProjectCard proyecto={p} />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- Clientes -->
  <Section variant="alt">
    <ClientsStrip clientes={clientesEntry} />
  </Section>

  <!-- CTA final -->
  <Section variant="strong">
    <Container size="md">
      <div class="text-center">
        <Eyebrow light>Contáctenos</Eyebrow>
        <h2 class="font-heading font-bold text-white mb-4" style="font-size: var(--font-size-h2);">
          ¿Quiere saber más sobre nuestra empresa?
        </h2>
        <p class="text-white/70 mb-8" style="font-size: var(--font-size-body-lg);">
          Estamos disponibles para presentar nuestra trayectoria, capacidades técnicas y experiencia
          en proyectos hidromecánicos nacionales e internacionales.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <Button href="/contacto" size="lg">Ponerse en contacto</Button>
          <Button href="/empresa" variant="secondary" size="lg" class="!text-white !border-white/60 hover:!bg-white/10">
            Conocer la empresa
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</PageLayout>
