---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/home/Hero.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import CapabilitiesBlock from '../components/home/CapabilitiesBlock.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import ClientsStrip from '../components/home/ClientsStrip.astro';
import CTASection from '../components/ui/CTASection.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import EditableImage from '../components/cms/EditableImage.astro';
import EditableText from '../components/cms/EditableText.astro';
import { getCollection, getEntry } from 'astro:content';
import { getCmsText } from '../data/cms';
import { entrySlug } from '../utils/contentId';

const servicios = await getCollection('servicios');
// ESTRUCT-5 fix: usar `orden` (misma fuente que /servicios) en vez de orden
// alfabético, para que ambas páginas muestren las tarjetas en el mismo orden.
servicios.sort((a, b) => a.data.orden - b.data.orden);

const proyectosDestacados = await getCollection(
  'proyectos',
  ({ data }) => data.tipo === 'destacado'
);
proyectosDestacados.sort((a, b) => a.data.orden - b.data.orden);

const clientesEntry = await getEntry('clientes', 'clientes');

const instalaciones = [
  {
    title: 'Trayectoria',
    description: 'Fundada en 1983 en España',
    value: '40+ años',
  },
  {
    title: 'Taller industrial',
    description: 'Calderería, mecanizado y pintura industrial bajo un mismo techo, en Los Ángeles',
    value: '2.000 m²',
  },
  {
    title: 'Presencia internacional',
    description: 'Proyectos en Chile, España, Honduras y Costa Rica',
    value: '4 países',
  },
];

const propuestaValor = [
  {
    title: 'Especialización sectorial',
    description: 'Equipos para embalses y centrales hidroeléctricas.',
  },
  {
    title: 'Alcance de servicios',
    description: 'Diseño, ingeniería, fabricación, suministro, montaje y mantenimiento.',
  },
  {
    title: 'Experiencia internacional',
    description: 'Experiencia en Chile, España, Honduras y Costa Rica.',
  },
];
---

<PageLayout
  title="Ingeniería y Montaje de Equipos Hidromecánicos"
  description="Hidromont Chile — Especialistas en ingeniería, fabricación y montaje de equipos hidromecánicos para embalses y centrales hidroeléctricas desde 1983."
  headerOverlay={true}
>
  <!-- Hero -->
  <Hero
    eyebrow={getCmsText('home.hero', 'eyebrow', 'Especialistas en equipos hidromecánicos')}
    title={getCmsText(
      'home.hero',
      'title',
      'Ingeniería, fabricación y montaje de equipos hidromecánicos'
    )}
    subtitle={getCmsText(
      'home.hero',
      'subtitle',
      'Desde 1983 trabajamos en proyectos hidráulicos e hidroeléctricos en Chile y el extranjero.'
    )}
    ctaPrimary={{
      label: getCmsText('home.hero', 'primaryLabel', 'Conocer nuestros servicios'),
      href: '/servicios',
    }}
    ctaSecondary={{
      label: getCmsText('home.hero', 'secondaryLabel', 'Ver proyectos'),
      href: '/proyectos',
    }}
    cmsEntry="home.hero"
  />

  <!-- Servicios principales -->
  <Section variant="default" id="servicios">
    <Container>
      <div class="text-center mb-12">
        <Eyebrow
          ><EditableText entry="home.services" field="eyebrow">Servicios</EditableText></Eyebrow
        >
        <EditableText
          as="h2"
          entry="home.services"
          field="title"
          class="font-heading font-bold text-primary-dark mb-4"
          style="font-size: var(--font-size-h2);"
        >
          {getCmsText('home.services', 'title', 'Servicios para proyectos hidromecánicos')}
        </EditableText>
        <EditableText
          as="p"
          entry="home.services"
          field="subtitle"
          type="textarea"
          class="text-text-muted max-w-2xl mx-auto"
          style="font-size: var(--font-size-lead);"
        >
          {
            getCmsText(
              'home.services',
              'subtitle',
              'Realizamos ingeniería, fabricación, montaje, mantenimiento y rehabilitación de equipos hidromecánicos.'
            )
          }
        </EditableText>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6" data-reveal-group>
        {
          servicios.map((s) => (
            <ServiceCard
              title={s.data.titulo}
              description={s.data.resumen}
              href={`/servicios/${entrySlug(s.id)}`}
              icon={s.data.icono}
              bullets={s.data.tipos?.slice(0, 3)}
              compact
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Propuesta de valor / capacidades -->
  <Section variant="alt" divider>
    <CapabilitiesBlock
      eyebrow={getCmsText('home.capabilities', 'eyebrow', 'Por qué elegirnos')}
      title={getCmsText(
        'home.capabilities',
        'title',
        'Experiencia y medios para proyectos hidromecánicos'
      )}
      subtitle={getCmsText(
        'home.capabilities',
        'subtitle',
        'Trayectoria en proyectos hidráulicos en Chile y otros países.'
      )}
      items={propuestaValor}
      columns={3}
      cmsEntry="home.capabilities"
    />
  </Section>

  <!-- Instalaciones -->
  <Section variant="strong" divider>
    <Container size="2xl">
      <div class="mb-10">
        <div class="relative overflow-hidden rounded-none border border-white/10">
          <div
            class="absolute inset-0 z-10 rounded-none pointer-events-none shadow-[inset_0_1px_0_rgba(255,255,255,0.12),inset_0_-1px_0_rgba(0,0,0,0.2)]"
            aria-hidden="true"
          >
          </div>
          <EditableImage
            entry="home.installations"
            field="image"
            altField="imageAlt"
            src={getCmsText(
              'home.installations',
              'image',
              '/fotos/curadas/fabricacion-tuberias-taller.webp'
            )}
            alt={getCmsText(
              'home.installations',
              'imageAlt',
              'Fabricación de tuberías forzadas de gran diámetro en el taller de Hidromont'
            )}
            width="1834"
            height="858"
            loading="lazy"
            decoding="async"
            class="block w-full h-auto object-cover max-h-[420px]"
          />
        </div>
      </div>
    </Container>
    <CapabilitiesBlock
      eyebrow={getCmsText('home.installations', 'eyebrow', 'Instalaciones y medios productivos')}
      title={getCmsText(
        'home.installations',
        'title',
        'Taller y medios para fabricación y montaje'
      )}
      subtitle={getCmsText(
        'home.installations',
        'subtitle',
        'Desde 1983 diseñamos, fabricamos y montamos equipos hidromecánicos.'
      )}
      items={instalaciones}
      columns={3}
      light
      cmsEntry="home.installations"
    />
  </Section>

  <!-- Proyectos destacados -->
  {
    proyectosDestacados.length > 0 ? (
      <Section variant="default" id="proyectos" divider>
        <Container>
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
            <div>
              <Eyebrow>
                <EditableText entry="home.projects" field="eyebrow">
                  Experiencia
                </EditableText>
              </Eyebrow>
              <EditableText
                as="h2"
                entry="home.projects"
                field="title"
                class="font-heading font-bold text-primary-dark"
                style="font-size: var(--font-size-h2);"
              >
                {getCmsText('home.projects', 'title', 'Proyectos destacados')}
              </EditableText>
            </div>
            <Button href="/proyectos" variant="secondary">
              {getCmsText('home.projects', 'buttonLabel', 'Ver todos los proyectos')}
            </Button>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-group>
            {proyectosDestacados.slice(0, 6).map((p) => (
              <ProjectCard proyecto={p} />
            ))}
          </div>
        </Container>
      </Section>
    ) : (
      <Section variant="default" id="proyectos" divider>
        <Container size="md">
          <div class="text-center py-10">
            <Eyebrow>
              <EditableText entry="home.projects" field="eyebrow">
                Experiencia
              </EditableText>
            </Eyebrow>
            <EditableText
              as="h2"
              entry="home.projects"
              field="title"
              class="font-heading font-bold text-primary-dark mb-3"
              style="font-size: var(--font-size-h2);"
            >
              {getCmsText('home.projects', 'title', 'Proyectos destacados')}
            </EditableText>
            <p class="text-text-muted mb-6" style="font-size: var(--font-size-lead);">
              Estamos actualizando nuestro catálogo de proyectos. Pronto podrá consultar nuestra
              experiencia completa en esta sección.
            </p>
            <Button href="/contacto" variant="secondary">
              Consultar experiencia técnica
            </Button>
          </div>
        </Container>
      </Section>
    )
  }

  <!-- Clientes -->
  <Section variant="alt" divider>
    <ClientsStrip clientes={clientesEntry} />
  </Section>

  <!-- CTA final -->
  <CTASection
    cmsEntry="home.cta"
    title={getCmsText('home.cta', 'title', '¿Quiere saber más sobre nuestra empresa?')}
    subtitle={getCmsText(
      'home.cta',
      'subtitle',
      'Cuéntenos el alcance de su proyecto. Revisaremos las alternativas de fabricación y montaje que correspondan.'
    )}
    primary={{ label: getCmsText('home.cta', 'primaryLabel', 'Contacto'), href: '/contacto' }}
    secondary={{
      label: getCmsText('home.cta', 'secondaryLabel', 'Conocer la empresa'),
      href: '/empresa',
    }}
  />
</PageLayout>
