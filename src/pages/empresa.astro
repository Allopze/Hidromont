---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import PageHero from '../components/ui/PageHero.astro';
import CTASection from '../components/ui/CTASection.astro';
import EditableText from '../components/cms/EditableText.astro';
import { getCmsText } from '../data/cms';
import { company } from '../data/company';
---

<PageLayout
  title="Empresa"
  description="Hidromont Chile — Especialistas en ingeniería hidromecánica desde 1983. Sede en Los Ángeles, Biobío, con instalaciones propias y equipo técnico especializado."
>
  <PageHero
    title={getCmsText('empresa.hero', 'title', 'Empresa')}
    subtitle={getCmsText(
      'empresa.hero',
      'subtitle',
      'Desde 1983. Con presencia en Chile desde 1997 y foco en ingeniería hidromecánica.'
    )}
    imageSrc={getCmsText('empresa.hero', 'image', '/fotos/curadas/taller-nave.webp')}
    imageAlt={getCmsText(
      'empresa.hero',
      'imageAlt',
      'Nave del taller industrial de Hidromont con grúa pórtico de 20 toneladas'
    )}
    imageWidth={1536}
    imageHeight={1024}
    breadcrumbs={[{ label: 'Empresa' }]}
    cmsEntry="empresa.hero"
  />

  <!-- Historia y descripción -->
  <Section variant="default">
    <Container size="lg">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <Eyebrow>
            <EditableText entry="empresa.historia" field="eyebrow">
              {getCmsText('empresa.historia', 'eyebrow', 'Historia')}
            </EditableText>
          </Eyebrow>
          <EditableText
            as="h2"
            entry="empresa.historia"
            field="title"
            class="font-heading font-bold text-primary-dark mb-6"
            style="font-size: var(--font-size-h2);"
          >
            {
              getCmsText(
                'empresa.historia',
                'title',
                'Más de 40 años en infraestructura hidráulica'
              )
            }
          </EditableText>
          <div
            class="space-y-4 text-text-muted"
            style="font-size: var(--font-size-lead); line-height: 1.7;"
          >
            <EditableText as="p" entry="empresa.historia" field="p1" type="textarea">
              {
                getCmsText(
                  'empresa.historia',
                  'p1',
                  'Hidromont Chile S.A. forma parte de una empresa de origen español fundada en 1983. Desde 1997 tiene sede en la Región del Biobío y participa en la construcción y rehabilitación de proyectos hidráulicos en Chile y en el extranjero.'
                )
              }
            </EditableText>
            <EditableText as="p" entry="empresa.historia" field="p2" type="textarea">
              {
                getCmsText(
                  'empresa.historia',
                  'p2',
                  'Diseñamos, fabricamos y montamos equipos hidromecánicos para embalses y centrales hidroeléctricas. El trabajo incluye tuberías forzadas, blindajes, compuertas, válvulas, turbinas y limpiarrejas.'
                )
              }
            </EditableText>
            <EditableText as="p" entry="empresa.historia" field="p3" type="textarea">
              {
                getCmsText(
                  'empresa.historia',
                  'p3',
                  'Según el alcance de cada obra, coordinamos la ingeniería, la fabricación en taller y el montaje en terreno bajo modalidad llave en mano.'
                )
              }
            </EditableText>
          </div>
        </div>

        <div class="space-y-6">
          <dl class="grid grid-cols-2 gap-4">
            {
              ([1, 2, 3] as const).map((i) => (
                <div class="flex flex-col p-5 border border-border rounded-none bg-surface">
                  {/* UIUX-15 fix: DOM order now puts <dt> before its <dd>s (a
                     dl requires the term to precede its definitions); the
                     existing `order-*` flex classes keep the visual stacking
                     (value → label → description) unchanged. */}
                  <EditableText
                    as="dt"
                    entry="empresa.metricas"
                    field={`card${i}Label`}
                    class="order-2 font-semibold text-text text-sm mt-1"
                  >
                    {getCmsText(
                      'empresa.metricas',
                      `card${i}Label`,
                      ['Fundación', 'Modalidad', 'Calidad'][i - 1]
                    )}
                  </EditableText>
                  <EditableText
                    as="dd"
                    entry="empresa.metricas"
                    field={`card${i}Value`}
                    class={`order-1 ${i <= 1 ? 'font-mono' : 'font-heading'} font-bold text-primary text-2xl`}
                  >
                    {getCmsText(
                      'empresa.metricas',
                      `card${i}Value`,
                      ['1983', 'EPC', 'ISO 9001'][i - 1]
                    )}
                  </EditableText>
                  <EditableText
                    as="dd"
                    entry="empresa.metricas"
                    field={`card${i}Desc`}
                    class="order-3 text-text-muted text-xs mt-0.5"
                  >
                    {getCmsText(
                      'empresa.metricas',
                      `card${i}Desc`,
                      ['Origen español', 'Ingeniería, fabricación y montaje', 'Sistema de gestión'][
                        i - 1
                      ]
                    )}
                  </EditableText>
                </div>
              ))
            }
          </dl>

          <div class="p-6 bg-surface border border-border rounded-none">
            <EditableText
              as="h3"
              entry="empresa.metricas"
              field="ubicacionTitle"
              class="font-heading font-semibold text-primary-dark mb-3"
            >
              {getCmsText('empresa.metricas', 'ubicacionTitle', 'Ubicación')}
            </EditableText>
            <p class="text-sm text-text-muted">
              <EditableText entry="site.company" field="domicilio">{company.domicilio}</EditableText
              ><br />
              <EditableText entry="site.company" field="ciudad">{company.ciudad}</EditableText>
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Instalaciones -->
  <Section variant="alt">
    <Container>
      <div class="text-center mb-12">
        <Eyebrow>
          <EditableText entry="empresa.instalaciones" field="eyebrow">
            {getCmsText('empresa.instalaciones', 'eyebrow', 'Infraestructura')}
          </EditableText>
        </Eyebrow>
        <EditableText
          as="h2"
          entry="empresa.instalaciones"
          field="title"
          class="font-heading font-bold text-primary-dark mb-4"
          style="font-size: var(--font-size-h2);"
        >
          {getCmsText('empresa.instalaciones', 'title', 'Instalaciones y medios productivos')}
        </EditableText>
        <EditableText
          as="p"
          entry="empresa.instalaciones"
          field="subtitle"
          type="textarea"
          class="text-text-muted max-w-2xl mx-auto"
          style="font-size: var(--font-size-lead);"
        >
          {
            getCmsText(
              'empresa.instalaciones',
              'subtitle',
              'Taller propio de calderería, mecanizado y pintura industrial, equipado para fabricar piezas de gran escala y responder a plazos de obra ajustados.'
            )
          }
        </EditableText>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
        {
          [
            {
              key: 1,
              val: '11.000 m²',
              title: 'Superficie de terreno',
              desc: 'Terreno destinado a acopio, premontaje y logística de estructuras de gran tamaño.',
            },
            {
              key: 2,
              val: '2.000 m²',
              title: 'Taller industrial',
              desc: 'Línea de fabricación de compuertas, tuberías forzadas y estructuras hidromecánicas, con capacidad para suministros urgentes.',
            },
            {
              key: 3,
              val: '320 m²',
              title: 'Oficinas e ingeniería',
              desc: 'Equipo técnico dedicado a ingeniería de proyectos, cálculo y control de calidad.',
            },
            {
              key: 4,
              val: '65 mm',
              title: 'Cilindradora hidráulica',
              desc: 'Cilindradora MG: ancho útil 3 m y espesor hasta 65 mm de placa.',
            },
            {
              key: 5,
              val: '5 unidades',
              title: 'Puentes grúa',
              desc: '5 puentes grúa de 10 a 20 t para maniobras de fabricación y montaje.',
            },
          ].map((item) => (
            <div class="p-6 bg-surface border border-border rounded-none">
              <EditableText
                as="p"
                entry="empresa.instalaciones"
                field={`item${item.key}Value`}
                class="font-mono font-bold text-primary text-2xl mb-1"
              >
                {getCmsText('empresa.instalaciones', `item${item.key}Value`, item.val)}
              </EditableText>
              <EditableText
                as="h3"
                entry="empresa.instalaciones"
                field={`item${item.key}Title`}
                class="font-heading font-semibold text-primary-dark text-sm mb-2"
              >
                {getCmsText('empresa.instalaciones', `item${item.key}Title`, item.title)}
              </EditableText>
              <EditableText
                as="p"
                entry="empresa.instalaciones"
                field={`item${item.key}Desc`}
                type="textarea"
                class="text-xs text-text-muted leading-relaxed"
              >
                {getCmsText('empresa.instalaciones', `item${item.key}Desc`, item.desc)}
              </EditableText>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Maquinaria + Medios de obra -->
  <Section variant="default">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <Eyebrow>
            <EditableText entry="empresa.maquinaria" field="eyebrow">
              {getCmsText('empresa.maquinaria', 'eyebrow', 'Equipamiento')}
            </EditableText>
          </Eyebrow>
          <EditableText
            as="h2"
            entry="empresa.maquinaria"
            field="title"
            class="font-heading font-bold text-primary-dark mb-6"
            style="font-size: var(--font-size-h2);"
          >
            {getCmsText('empresa.maquinaria', 'title', 'Maquinaria especializada')}
          </EditableText>
          <EditableText
            as="p"
            entry="empresa.maquinaria"
            field="subtitle"
            type="textarea"
            class="text-text-muted mb-6"
            style="font-size: var(--font-size-lead);"
          >
            {
              getCmsText(
                'empresa.maquinaria',
                'subtitle',
                'Contamos con maquinaria para fabricar, mecanizar, soldar y cortar los equipos descritos en nuestras líneas de servicio.'
              )
            }
          </EditableText>
          <ul class="space-y-2.5">
            {
              ([1, 2, 3, 4, 5, 6, 7, 8] as const).map((i) => (
                <li class="flex items-start gap-2.5 text-sm text-text-muted">
                  <span
                    class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-primary"
                    aria-hidden="true"
                  />
                  <EditableText entry="empresa.maquinaria" field={`item${i}`}>
                    {getCmsText(
                      'empresa.maquinaria',
                      `item${i}`,
                      [
                        'Estaciones de soldadura automática de arco sumergido (4 unidades)',
                        'Fresadora DYE600 de carrera 7 m',
                        'Tornos paralelos de 2 m y 6 m',
                        'Torno al aire con volteo 4,5 m',
                        'Cizalla LOIRE 3 m/16 mm',
                        'Mesa de corte ESAB SHARK CS 12 m × 3 m, plasma hasta 32 mm',
                        'Plegadora MEBUSA 200 t × 3 m',
                        'Oxicorte hasta 100 mm',
                      ][i - 1]
                    )}
                  </EditableText>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <Eyebrow>
            <EditableText entry="empresa.mediosdeobra" field="eyebrow">
              {getCmsText('empresa.mediosdeobra', 'eyebrow', 'Capacidad de montaje')}
            </EditableText>
          </Eyebrow>
          <EditableText
            as="h2"
            entry="empresa.mediosdeobra"
            field="title"
            class="font-heading font-bold text-primary-dark mb-6"
            style="font-size: var(--font-size-h2);"
          >
            {getCmsText('empresa.mediosdeobra', 'title', 'Medios de obra')}
          </EditableText>
          <EditableText
            as="p"
            entry="empresa.mediosdeobra"
            field="subtitle"
            type="textarea"
            class="text-text-muted mb-6"
            style="font-size: var(--font-size-lead);"
          >
            {
              getCmsText(
                'empresa.mediosdeobra',
                'subtitle',
                'Disponemos de medios propios para ejecutar montajes en terreno, incluyendo obras de acceso difícil que requieren medios especiales de transporte.'
              )
            }
          </EditableText>
          <ul class="space-y-2.5">
            {
              ([1, 2, 3, 4, 5, 6, 7, 8] as const).map((i) => (
                <li class="flex items-start gap-2.5 text-sm text-text-muted">
                  <span
                    class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-primary"
                    aria-hidden="true"
                  />
                  <EditableText entry="empresa.mediosdeobra" field={`item${i}`}>
                    {getCmsText(
                      'empresa.mediosdeobra',
                      `item${i}`,
                      [
                        'Grúa autopropulsada 50 t',
                        'Camiones pluma de hasta 9.000 kg de capacidad de levante',
                        'Vehículos Pick-Up 4×4 para acceso a terreno',
                        'Grupos electrógenos de 100 a 200 kVA',
                        'Equipos de arenado y pintura industrial',
                        'Bastidores y equipos de armado para tuberías de mediano y gran diámetro',
                        'Plataformas y teleférico para montajes en pendiente',
                        'Winches de alto tonelaje',
                      ][i - 1]
                    )}
                  </EditableText>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  <!-- CTA -->
  <CTASection
    cmsEntry="empresa.cta"
    title={getCmsText('empresa.cta', 'title', '¿Quiere conocer nuestras capacidades?')}
    subtitle={getCmsText(
      'empresa.cta',
      'subtitle',
      'Cuéntenos el alcance de su obra y revisamos qué parte podemos ejecutar en el taller de Los Ángeles y qué parte en terreno.'
    )}
    primary={{
      label: getCmsText('empresa.cta', 'buttonLabel', 'Contactar equipo técnico'),
      href: '/contacto',
    }}
  />
</PageLayout>
