---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import CTASection from '../../components/ui/CTASection.astro';
import EditableText from '../../components/cms/EditableText.astro';
import EditableImage from '../../components/cms/EditableImage.astro';
import { getCollection } from 'astro:content';
import { getCmsText } from '../../data/cms';
import { entrySlug } from '../../utils/contentId';

const servicios = await getCollection('servicios');
servicios.sort((a, b) => a.data.orden - b.data.orden);
---

<PageLayout
  title="Servicios"
  description="Servicios hidromecánicos de Hidromont Chile: tuberías forzadas, compuertas, válvulas, turbinas, limpiarrejas y montajes especiales. Proyectos EPC."
>
  <PageHero
    title={getCmsText('servicios.index.hero', 'title', 'Servicios hidromecánicos')}
    subtitle={getCmsText(
      'servicios.index.hero',
      'subtitle',
      'Ingeniería, fabricación y montaje de tuberías forzadas, compuertas, válvulas, turbinas, limpiarrejas y equipos especiales.'
    )}
    imageSrc={getCmsText('servicios.index.hero', 'image', '/fotos/curadas/otros-montajes.jpg')}
    imageAlt={getCmsText(
      'servicios.index.hero',
      'imageAlt',
      'Fabricación de grandes equipos hidromecánicos en taller'
    )}
    imageWidth={471}
    imageHeight={629}
    breadcrumbs={[{ label: 'Servicios' }]}
    cmsEntry="servicios.index.hero"
  />

  <Section variant="default">
    <Container>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">
        {
          /* UIUX-L10 fix: was slice(0, 4) here vs slice(0, 3) on the home
             page's ServiceCard grid — same component, same grid layout,
             inconsistent truncation. Unified to 3. */
        }
        {
          servicios.map((s) => (
            <ServiceCard
              title={s.data.titulo}
              description={s.data.resumen}
              href={`/servicios/${entrySlug(s.id)}`}
              icon={s.data.icono}
              bullets={s.data.tipos?.slice(0, 3)}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Banner de Infraestructura y Estándares -->
  <Section variant="strong" divider>
    <Container size="xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <Eyebrow light>
            <EditableText entry="servicios.index.banner" field="eyebrow">
              {getCmsText('servicios.index.banner', 'eyebrow', 'Capacidad Industrial')}
            </EditableText>
          </Eyebrow>
          <EditableText
            as="h2"
            entry="servicios.index.banner"
            field="title"
            class="font-heading font-bold text-white mb-4"
            style="font-size: var(--font-size-h2);"
          >
            {getCmsText('servicios.index.banner', 'title', 'Taller y medios de fabricación')}
          </EditableText>
          <EditableText
            as="p"
            entry="servicios.index.banner"
            field="subtitle"
            type="textarea"
            class="text-white/90 mb-6"
            style="font-size: var(--font-size-lead);"
          >
            {
              getCmsText(
                'servicios.index.banner',
                'subtitle',
                'En Los Ángeles contamos con terreno para acopio y premontaje, además de talleres de calderería, mecanizado y pintura industrial.'
              )
            }
          </EditableText>
          <div class="grid grid-cols-3 gap-4 pt-4 border-t border-white/10">
            <div>
              <p class="font-mono font-bold text-accent text-xl">2.000 m²</p>
              <p class="text-xs text-white/70">Taller industrial</p>
            </div>
            <div>
              <p class="font-mono font-bold text-accent text-xl">5 Puentes</p>
              <p class="text-xs text-white/70">Grúa 10–20 Tn</p>
            </div>
            <div>
              <p class="font-mono font-bold text-accent text-xl">Soldadura</p>
              <p class="text-xs text-white/70">Procesos en taller</p>
            </div>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-none border border-white/10 shadow-lg">
          <EditableImage
            entry="servicios.index.banner"
            field="image"
            altField="imageAlt"
            src={getCmsText(
              'servicios.index.banner',
              'image',
              '/fotos/curadas/fabricacion-tuberias-taller.webp'
            )}
            alt={getCmsText(
              'servicios.index.banner',
              'imageAlt',
              'Proceso de fabricacion y caldereria hidromecanica en taller'
            )}
            width="1200"
            height="675"
            loading="lazy"
            decoding="async"
            class="block w-full h-auto object-cover max-h-[380px]"
          />
        </div>
      </div>
    </Container>
  </Section>

  <Section variant="alt">
    <Container size="md">
      <div class="text-center">
        <Eyebrow>
          <EditableText entry="servicios.index.metodologia" field="eyebrow">
            {getCmsText('servicios.index.metodologia', 'eyebrow', 'Metodología')}
          </EditableText>
        </Eyebrow>
        <EditableText
          as="h2"
          entry="servicios.index.metodologia"
          field="title"
          class="font-heading font-bold text-primary-dark mb-4"
          style="font-size: var(--font-size-h2);"
        >
          {getCmsText('servicios.index.metodologia', 'title', 'Actividades transversales')}
        </EditableText>
        <EditableText
          as="p"
          entry="servicios.index.metodologia"
          field="subtitle"
          type="textarea"
          class="text-text-muted mb-8"
          style="font-size: var(--font-size-lead);"
        >
          {
            getCmsText(
              'servicios.index.metodologia',
              'subtitle',
              'El alcance de cada servicio puede incluir desmontaje, fabricación, reparación, montaje u obturación, según las necesidades de la obra.'
            )
          }
        </EditableText>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 text-left">
          {
            ([1, 2, 3, 4, 5, 6] as const).map((i) => (
              <div class="p-4 bg-surface border border-border rounded-none">
                <EditableText
                  as="h3"
                  entry="servicios.index.metodologia"
                  field={`item${i}Title`}
                  class="font-semibold text-primary-dark text-sm mb-1"
                >
                  {getCmsText(
                    'servicios.index.metodologia',
                    `item${i}Title`,
                    [
                      'Desmontajes',
                      'Fabricación',
                      'Reparaciones',
                      'Mantenimiento de turbinas',
                      'Montajes',
                      'Obturaciones',
                    ][i - 1]
                  )}
                </EditableText>
                <EditableText
                  as="p"
                  entry="servicios.index.metodologia"
                  field={`item${i}Desc`}
                  type="textarea"
                  class="text-xs text-text-muted leading-relaxed"
                >
                  {getCmsText(
                    'servicios.index.metodologia',
                    `item${i}Desc`,
                    [
                      'Desmontaje controlado de equipos para reparación o sustitución.',
                      'Oxicorte, plegado, armado, soldadura, mecanizado y ensamblado.',
                      'Limpieza, tratamiento superficial, juntas y sistemas de accionamiento.',
                      'Recuperación de rodetes por cavitación, alineaciones y mecanizados.',
                      'Procedimientos específicos con análisis de medios y tiempos.',
                      'Diseño, fabricación y montaje de obturaciones especiales.',
                    ][i - 1]
                  )}
                </EditableText>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  <CTASection
    cmsEntry="servicios.index.cta"
    title={getCmsText('servicios.index.cta', 'title', '¿Necesita un servicio específico?')}
    subtitle={getCmsText(
      'servicios.index.cta',
      'subtitle',
      'Cuéntenos el alcance de su obra y revisaremos las alternativas de fabricación y montaje.'
    )}
    primary={{
      label: getCmsText('servicios.index.cta', 'buttonLabel', 'Contacto'),
      href: '/contacto',
    }}
  />
</PageLayout>
