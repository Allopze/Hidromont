---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { getCollection } from 'astro:content';
import { serviceImages } from '../../data/service-images';
import { serviceGalleries } from '../../data/service-galleries';
import EditableImage from '../../components/cms/EditableImage.astro';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((s) => ({
    params: { slug: s.slug },
    props: { servicio: s },
  }));
}

const { servicio } = Astro.props;
const { titulo, resumen, tipos, aplicaciones, normas } = servicio.data;
const { Content } = await servicio.render();
const serviceImageEntry = `service-image.${servicio.slug}`;
const heroImg = serviceImages[servicio.slug];
const gallery = serviceGalleries[servicio.slug];
const galleryEntryId = `service-gallery.${servicio.slug}`;
const cmsEditingEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: titulo,
    description: resumen,
    provider: {
      '@type': 'Organization',
      name: 'Hidromont Chile',
      url: 'https://hidromont.cl',
    },
    areaServed: 'CL',
    serviceType: titulo,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://hidromont.cl/' },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://hidromont.cl/servicios/' },
      { '@type': 'ListItem', position: 3, name: titulo },
    ],
  },
];
---

<PageLayout
  title={titulo}
  description={resumen}
  jsonLd={jsonLd}
>
  <PageHero
    badge="Servicio"
    title={titulo}
    subtitle={resumen}
    imageSrc={heroImg?.src}
    imageAlt={heroImg?.alt}
    imageWidth={heroImg?.width}
    imageHeight={heroImg?.height}
    breadcrumbs={[{ label: 'Servicios', href: '/servicios' }, { label: titulo }]}
    cmsEntry={`servicios.${servicio.slug}`}
    cmsEyebrowField={false}
    cmsTitleField="titulo"
    cmsSubtitleField="resumen"
    cmsImageEntry={serviceImageEntry}
  />

  <Section variant="default">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contenido principal -->
        <div class="lg:col-span-2">
          <div class="prose prose-lg max-w-none">
            <Content />
          </div>
        </div>

        <!-- Sidebar técnico -->
        <aside class="space-y-6">
          {tipos && tipos.length > 0 && (
            <div class="p-5 border border-border rounded-lg bg-surface">
              <h3 class="font-heading font-semibold text-primary-dark text-sm uppercase tracking-wide mb-3">Tipos</h3>
              <ul class="space-y-1.5">
                {tipos.map((t: string) => (
                  <li class="flex items-start gap-2 text-sm text-text-muted">
                    <span class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true" />
                    {t}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {aplicaciones && aplicaciones.length > 0 && (
            <div class="p-5 border border-border rounded-lg bg-primary-light">
              <h3 class="font-heading font-semibold text-primary-dark text-sm uppercase tracking-wide mb-3">Aplicaciones</h3>
              <ul class="space-y-1.5">
                {aplicaciones.map((a: string) => (
                  <li class="flex items-start gap-2 text-sm text-text-muted">
                    <span class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true" />
                    {a}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {normas && normas.length > 0 && (
            <div class="p-5 border border-border rounded-lg bg-background-alt">
              <h3 class="font-heading font-semibold text-primary-dark text-sm uppercase tracking-wide mb-3">Normas de referencia</h3>
              <div class="flex flex-wrap gap-2">
                {normas.map((n: string) => (
                  <Badge variant="muted">{n}</Badge>
                ))}
              </div>
            </div>
          )}

          <!-- Contacto (corporate presence — no sales language) -->
          <div class="p-5 bg-primary rounded-lg text-white">
            <p class="font-semibold text-sm mb-3">¿Trabaja en proyectos de este tipo?</p>
            <p class="text-white/80 text-xs mb-4 leading-relaxed">
              Converse con nuestro equipo técnico sobre las capacidades y experiencia de Hidromont.
            </p>
            <Button href="/contacto" variant="secondary-light" class="w-full justify-center">
              Contactar
            </Button>
          </div>
        </aside>
      </div>


    </Container>
  </Section>

  {(gallery?.images.length > 0 || cmsEditingEnabled) && (
    <Section variant="default">
      <Container>
        <h2 class="font-heading font-bold text-primary-dark mb-8" style="font-size: var(--font-size-h2);">
          Galería de imágenes
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[1, 2, 3].map((n) => {
            const img = gallery?.images[n - 1];
            return (
              <div class="aspect-video overflow-hidden rounded-lg bg-background-alt border border-border">
                {img ? (
                  <EditableImage
                    entry={galleryEntryId}
                    field={`gallery${n}`}
                    altField={`gallery${n}Alt`}
                    src={img.src}
                    alt={img.alt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : cmsEditingEnabled ? (
                  <div
                    class="w-full h-full flex items-center justify-center text-text-muted text-sm cursor-crosshair"
                    data-cms-entry={galleryEntryId}
                    data-cms-field={`gallery${n}`}
                    data-cms-alt-field={`gallery${n}Alt`}
                    data-cms-type="image"
                  >
                    + Agregar imagen {n}
                  </div>
                ) : null}
              </div>
            );
          })}
        </div>
      </Container>
    </Section>
  )}

  <Section variant="strong">
    <Container size="md">
      <div class="text-center">
        <h2 class="font-heading font-bold text-white mb-4" style="font-size: var(--font-size-h2);">
          Vea nuestra experiencia en {titulo.toLowerCase()}
        </h2>
        <div class="flex flex-wrap justify-center gap-4">
          <Button href="/proyectos" size="lg">Ver proyectos</Button>
          <Button href="/contacto" variant="secondary-light" size="lg">
            Contacto
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</PageLayout>
