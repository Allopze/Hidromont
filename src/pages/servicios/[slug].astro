---
import ProjectCard from '../../components/projects/ProjectCard.astro';
import { CATEGORIA_DE_SERVICIO, proyectosDelServicio } from '../../data/servicio-proyectos';
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { getCollection, render } from 'astro:content';
import { serviceImages } from '../../data/service-images';
import { serviceGalleries } from '../../data/service-galleries';
import Lightbox from '../../components/gallery/Lightbox.astro';
import EditableImage from '../../components/cms/EditableImage.astro';
import EditableText from '../../components/cms/EditableText.astro';
import { getCmsText } from '../../data/cms';
import { soloEditor } from '../../utils/soloEditor';
import { entrySlug } from '../../utils/contentId';
// El dominio vive en `site` de astro.config.mjs y de ahí lo toman también el
// sitemap y el canónico. Repetirlo aquí fue la causa de que ocho sitios
// declararan hidromont.cl cuando el sitio se sirve en hidromontchile.cl.
// Sin barra final, que es como se concatena más abajo.
const SITIO = Astro.site!.href.replace(/\/$/, '');

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((s) => ({
    params: { slug: entrySlug(s.id) },
    props: { servicio: s },
  }));
}

const { servicio } = Astro.props;
const { titulo, resumen, tipos, aplicaciones, normas } = servicio.data;
const { Content } = await render(servicio);
const slug = entrySlug(servicio.id);
const serviceImageEntry = `service-image.${slug}`;
const heroImg = serviceImages[slug];
const gallery = serviceGalleries[slug];
const galleryEntryId = `service-gallery.${slug}`;
const cmsEntry = `servicios.${slug}`;
// Rótulos comunes a las ocho fichas (Páginas → Fichas de servicio — rótulos).
const rotulo = {
  etiqueta: getCmsText('plantilla.servicio', 'etiquetaServicio', 'Servicio'),
  tipos: getCmsText('plantilla.servicio', 'tituloTipos', 'Tipos'),
  aplicaciones: getCmsText('plantilla.servicio', 'tituloAplicaciones', 'Aplicaciones'),
  normas: getCmsText('plantilla.servicio', 'tituloNormas', 'Normas de referencia'),
  galeria: getCmsText('plantilla.servicio', 'tituloGaleria', 'Galería de imágenes'),
  obras: getCmsText('plantilla.servicio', 'obrasPrefijo', 'Obras ejecutadas en'),
  verProyectos: getCmsText('plantilla.servicio', 'botonProyectos', 'Ver proyectos'),
  contacto: getCmsText('plantilla.servicio', 'botonContacto', 'Contacto'),
};
const cmsEditingEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';
// P2-34 (auditoría 2026-09): las obras del servicio, enlazadas, y el botón al
// listado ya filtrado por su categoría.
const proyectosRelacionados = proyectosDelServicio(await getCollection('proyectos'), slug).slice(
  0,
  3
);
const categoriaDelServicio = CATEGORIA_DE_SERVICIO[slug];
const hrefProyectos = categoriaDelServicio
  ? `/proyectos/?cat=${categoriaDelServicio}`
  : '/proyectos/';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: titulo,
    description: resumen,
    // P3-06: remite a la organización del sitio (BaseLayout) en vez de repetir
    // otro nombre («Hidromont Chile» frente a «Hidromont Chile S.A.»).
    provider: { '@id': `${SITIO}/#organizacion` },
    areaServed: 'CL',
    serviceType: titulo,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITIO + '/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Servicios',
        item: SITIO + '/servicios/',
      },
      { '@type': 'ListItem', position: 3, name: titulo },
    ],
  },
];
---

<PageLayout title={titulo} description={resumen} jsonLd={jsonLd} image={heroImg?.src}>
  <PageHero
    badge={rotulo.etiqueta}
    title={titulo}
    subtitle={resumen}
    imageSrc={heroImg?.src}
    imageAlt={heroImg?.alt}
    imageWidth={heroImg?.width}
    imageHeight={heroImg?.height}
    breadcrumbs={[{ label: 'Servicios', href: '/servicios' }, { label: titulo }]}
    cmsEntry={cmsEntry}
    cmsEyebrowField={false}
    cmsTitleField="titulo"
    cmsSubtitleField="resumen"
    cmsImageEntry={serviceImageEntry}
  />

  <Section variant="default">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contenido principal -->
        <div class="lg:col-span-2">
          <EditableText
            as="div"
            entry={cmsEntry}
            field="body"
            type="richtext"
            class="prose prose-lg max-w-none"
          >
            <Content />
          </EditableText>
        </div>

        <!-- Sidebar técnico -->
        <aside class="space-y-6">
          {
            tipos && tipos.length > 0 && (
              <div class="p-5 border border-border rounded-none bg-surface">
                <EditableText
                  as="h3"
                  entry="plantilla.servicio"
                  field="tituloTipos"
                  class="font-heading font-semibold text-primary-dark text-sm uppercase tracking-wide mb-3"
                >
                  {rotulo.tipos}
                </EditableText>
                <EditableText
                  as="ul"
                  entry={cmsEntry}
                  field="tipos"
                  type="list"
                  class="space-y-1.5"
                >
                  {tipos.map((t: string) => (
                    <li class="flex items-start gap-2 text-sm text-text-muted">
                      <span
                        class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-primary"
                        aria-hidden="true"
                      />
                      {t}
                    </li>
                  ))}
                </EditableText>
              </div>
            )
          }

          {
            aplicaciones && aplicaciones.length > 0 && (
              <div class="p-5 border border-border rounded-none bg-primary-light">
                <EditableText
                  as="h3"
                  entry="plantilla.servicio"
                  field="tituloAplicaciones"
                  class="font-heading font-semibold text-primary-dark text-sm uppercase tracking-wide mb-3"
                >
                  {rotulo.aplicaciones}
                </EditableText>
                <EditableText
                  as="ul"
                  entry={cmsEntry}
                  field="aplicaciones"
                  type="list"
                  class="space-y-1.5"
                >
                  {aplicaciones.map((a: string) => (
                    <li class="flex items-start gap-2 text-sm text-text-muted">
                      <span
                        class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-accent"
                        aria-hidden="true"
                      />
                      {a}
                    </li>
                  ))}
                </EditableText>
              </div>
            )
          }

          {
            normas && normas.length > 0 && (
              <div class="p-5 border border-border rounded-none bg-background-alt">
                <EditableText
                  as="h3"
                  entry="plantilla.servicio"
                  field="tituloNormas"
                  class="font-heading font-semibold text-primary-dark text-sm uppercase tracking-wide mb-3"
                >
                  {rotulo.normas}
                </EditableText>
                <EditableText
                  as="div"
                  entry={cmsEntry}
                  field="normas"
                  type="list"
                  class="flex flex-wrap gap-2"
                >
                  {normas.map((n: string) => (
                    <Badge variant="muted">{n}</Badge>
                  ))}
                </EditableText>
              </div>
            )
          }

          <!-- Contacto (corporate presence — no sales language) -->
          <div class="p-5 bg-primary rounded-none text-white">
            <EditableText
              as="p"
              entry="servicios.detalle.contacto"
              field="title"
              class="font-semibold text-sm mb-3"
            >
              {
                getCmsText(
                  'servicios.detalle.contacto',
                  'title',
                  '¿Trabaja en proyectos de este tipo?'
                )
              }
            </EditableText>
            <EditableText
              as="p"
              entry="servicios.detalle.contacto"
              field="text"
              type="textarea"
              class="text-white/80 text-xs mb-4 leading-relaxed"
            >
              {
                getCmsText(
                  'servicios.detalle.contacto',
                  'text',
                  'Cuéntenos el alcance de su obra y revisaremos las alternativas de fabricación y montaje.'
                )
              }
            </EditableText>
            <Button href="/contacto" variant="secondary-light" class="w-full justify-center">
              <EditableText entry="servicios.detalle.contacto" field="buttonLabel">
                {getCmsText('servicios.detalle.contacto', 'buttonLabel', 'Contactar')}
              </EditableText>
            </Button>
          </div>
        </aside>
      </div>
    </Container>
  </Section>

  {
    /* Limpiarrejas ya no se excluye: la galería es donde viven los esquemas del
       modelo de utilidad patentado y las instalaciones, que el video del hero
       no muestra. */
    (gallery?.images.length > 0 || cmsEditingEnabled) && (
      <div {...soloEditor(!gallery?.images.length)}>
        <Section variant="default">
          <Container>
            <EditableText
              as="h2"
              entry="plantilla.servicio"
              field="tituloGaleria"
              class="font-heading font-bold text-primary-dark mb-8"
              style="font-size: var(--font-size-h2);"
            >
              {rotulo.galeria}
            </EditableText>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {/* UIUX-12 fix: the wrapper used to render unconditionally for all
               3 slots, leaving empty bordered boxes in production whenever a
               service had fewer than 3 gallery photos. */}
              {[1, 2, 3].map((n) => {
                const img = gallery?.images.find((i) => i.campo === n);
                if (!img && !cmsEditingEnabled) return null;
                return (
                  <div
                    class:list={[
                      'aspect-video overflow-hidden rounded-none bg-background-alt border border-border',
                      // P3-13 (auditoría 2026-09): las fotos de la ficha no se
                      // podían ampliar. Se abren en el mismo visor de /galeria.
                      img && 'cursor-zoom-in',
                    ]}
                    {...(img
                      ? {
                          'data-visor': '',
                          'data-item-id': `${galleryEntryId}-${n}`,
                          role: 'button',
                          tabindex: 0,
                          'aria-label': `Ampliar: ${img.alt}`,
                        }
                      : {})}
                    {...soloEditor(!img)}
                  >
                    {img ? (
                      <EditableImage
                        entry={galleryEntryId}
                        field={`gallery${n}`}
                        altField={`gallery${n}Alt`}
                        src={img.src}
                        alt={img.alt}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    ) : (
                      <div
                        class="w-full h-full flex items-center justify-center text-text-muted text-sm cursor-crosshair"
                        data-cms-entry={galleryEntryId}
                        data-cms-field={`gallery${n}`}
                        data-cms-alt-field={`gallery${n}Alt`}
                        data-cms-type="image"
                      >
                        + Agregar imagen {n}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </Container>
        </Section>
      </div>
    )
  }

  <Section variant="strong">
    <Container size={proyectosRelacionados.length > 0 ? 'xl' : 'md'}>
      <div class="text-center">
        <h2 class="font-heading font-bold text-white mb-4" style="font-size: var(--font-size-h2);">
          <EditableText entry="plantilla.servicio" field="obrasPrefijo">{rotulo.obras}</EditableText
          >
          {titulo.toLowerCase()}
        </h2>
        {
          proyectosRelacionados.length > 0 && (
            <div
              class="flex flex-wrap justify-center gap-6 text-left my-10"
              data-proyectos-del-servicio
            >
              {proyectosRelacionados.map((p) => (
                <div class="w-full md:w-[calc((100%-3rem)/3)] flex">
                  <ProjectCard proyecto={p} />
                </div>
              ))}
            </div>
          )
        }
        <div class="flex flex-wrap justify-center gap-4">
          <Button href={hrefProyectos} size="lg">
            <EditableText entry="plantilla.servicio" field="botonProyectos">
              {rotulo.verProyectos}
            </EditableText>
          </Button>
          <Button href="/contacto" variant="secondary-light" size="lg">
            <EditableText entry="plantilla.servicio" field="botonContacto">
              {rotulo.contacto}
            </EditableText>
          </Button>
        </div>
      </div>
    </Container>
  </Section>
  {(gallery?.images.length ?? 0) > 0 && <Lightbox slot="overlay" />}
</PageLayout>
