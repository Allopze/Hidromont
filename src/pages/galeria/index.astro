---
/**
 * /galeria — Curated gallery page.
 *
 * Reads from gallery.json (exported by CMS) instead of scanning public/uploads.
 * Uses GalleryGrid + Lightbox components for intentional layout and accessible viewing.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import PageHero from '../../components/ui/PageHero.astro';
import GalleryGrid from '../../components/gallery/GalleryGrid.astro';
import Lightbox from '../../components/gallery/Lightbox.astro';
import { getCmsText } from '../../data/cms';
import { getGalleryCategories, getGalleryItems, getCategoryCounts } from '../../data/gallery';

const categories = getGalleryCategories();
const allItems = getGalleryItems();
const categoryCounts = getCategoryCounts();
const totalCount = allItems.length;

// Build filter list with counts — hide categories that have no images
const filters = [
  { slug: 'all', name: 'Todas', count: totalCount },
  ...categories
    .map((cat) => ({
      slug: cat.slug,
      name: cat.name,
      count: categoryCounts[cat.slug] ?? 0,
    }))
    .filter((cat) => cat.count > 0),
];

// Only count non-empty categories (exclude the "Todas" pseudo-filter)
const categoryCount = filters.length - 1;
---

<PageLayout
  title={getCmsText('page.galeria', 'title', 'Galería') + ' | Hidromont Chile'}
  description={getCmsText('page.galeria', 'subtitle', 'Imágenes de nuestros proyectos, instalaciones y equipo.')}
>
  <PageHero
    title={getCmsText('page.galeria', 'title', 'Galería')}
    subtitle={getCmsText('page.galeria', 'subtitle', 'Imágenes de nuestros proyectos, instalaciones y equipo.')}
    imageSrc={getCmsText('page.galeria', 'image', '') || undefined}
    imageAlt={getCmsText('page.galeria', 'imageAlt', 'Galería de proyectos Hidromont Chile')}
    breadcrumbs={[{ label: 'Galería' }]}
    cmsEntry="page.galeria"
    compact
  />

  <Section padding="tight" class="bg-background">
    {allItems.length === 0 ? (
      <Container>
        <div class="text-center py-20" data-reveal>
          <p class="text-text-muted text-lg">
            Próximamente se añadirán imágenes a esta galería.
          </p>
        </div>
      </Container>
    ) : (
      <div class="w-full px-4 md:px-6">
        {/* Full-width wrapper: header + grid share one gutter so left/right
            margins stay symmetric and aligned */}
        {/* ── Editorial header + segmented filter control ── */}
        <div class="mb-8 md:mb-10" data-reveal>
          {/* Meta line */}
          <p class="text-xs text-text-muted font-mono uppercase tracking-wider mb-3">
            {totalCount} imágenes · {categoryCount} {categoryCount === 1 ? 'categoría' : 'categorías'}
          </p>

          {/* Segmented control — full width, equal segments, connected */}
          <nav
            aria-label="Filtrar por categoría"
            class="w-full border border-border overflow-x-auto scrollbar-hide"
            id="filter-container"
          >
            <div class="flex min-w-max" role="radiogroup">
              {filters.map((filter) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={filter.slug === 'all' ? 'true' : 'false'}
                  data-filter={filter.slug}
                  class={`gallery-filter-btn relative flex-1 px-3 py-2.5 text-[10px] md:text-[11px] font-mono font-semibold uppercase tracking-wider transition-all duration-150 ease-out cursor-pointer border-r border-border last:border-r-0 whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset text-center ${
                    filter.slug === 'all'
                      ? 'bg-primary text-white'
                      : 'bg-background text-text-muted hover:bg-background-alt hover:text-text'
                  }`}
                >
                  {filter.name}
                  <span class="ml-1 opacity-60">{filter.count}</span>
                </button>
              ))}
            </div>
          </nav>
        </div>

        {/* ── Gallery grid — spans the full page width ── */}
        <GalleryGrid items={allItems} />
      </div>
    )}
  </Section>

  {/* ── Lightbox (progressive enhancement — hidden until JS activates) ── */}
  <Lightbox />
</PageLayout>

<script>
  // ── Filter system with ARIA radio group keyboard navigation ──
  (() => {
    const container = document.getElementById('filter-container');
    const buttons = container?.querySelectorAll('[data-filter]');
    const cards = document.querySelectorAll('.gallery-card');
    if (!buttons?.length || !cards.length) return;

    const btnArray = Array.from(buttons) as HTMLElement[];

    function applyFilter(slug: string) {
      btnArray.forEach((btn) => {
        const isActive = btn.getAttribute('data-filter') === slug;
        btn.setAttribute('aria-checked', String(isActive));

        if (isActive) {
          btn.classList.add('bg-primary', 'text-white');
          btn.classList.remove('bg-background', 'text-text-muted');
        } else {
          btn.classList.remove('bg-primary', 'text-white');
          btn.classList.add('bg-background', 'text-text-muted');
        }
      });

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const cat = el.getAttribute('data-category') ?? '';
        const show = slug === 'all' || cat === slug;

        if (show) {
          el.style.removeProperty('display');
          el.offsetHeight; // force reflow
          el.style.opacity = '1';
          el.style.transform = 'scale(1)';
        } else {
          el.style.opacity = '0';
          el.style.transform = 'scale(0.95)';
          const onEnd = (e: Event) => {
            if ((e as TransitionEvent).propertyName === 'opacity') {
              el.style.display = 'none';
              el.removeEventListener('transitionend', onEnd);
            }
          };
          el.addEventListener('transitionend', onEnd);
        }
      });
    }

    // Click handlers
    btnArray.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-filter');
        if (slug) applyFilter(slug);
      });
    });

    // Arrow key navigation (ARIA radio group pattern)
    container?.addEventListener('keydown', (e: KeyboardEvent) => {
      const current = document.activeElement as HTMLElement;
      const idx = btnArray.indexOf(current);
      if (idx === -1) return;

      let next = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        next = (idx + 1) % btnArray.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        next = (idx - 1 + btnArray.length) % btnArray.length;
      }

      if (next !== -1) {
        e.preventDefault();
        btnArray[next].focus();
        const slug = btnArray[next].getAttribute('data-filter');
        if (slug) applyFilter(slug);
      }
    });
  })();
</script>

<style>
  /* Gallery cards transition for filter animations */
  .gallery-card {
    transition:
      opacity 200ms ease-out,
      transform 200ms ease-out,
      border-color 150ms ease,
      box-shadow 150ms ease;
  }
</style>
