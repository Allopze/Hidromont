---
/**
 * /galeria — Project-based Gallery Page.
 *
 * Configurable 100% from CMS (gallery.json export).
 * Groups photos into Project Album cards with search bar and category filtering.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ProjectAlbumCard from '../../components/gallery/ProjectAlbumCard.astro';
import Lightbox from '../../components/gallery/Lightbox.astro';
import { getCmsText } from '../../data/cms';
import {
  getGalleryCategories,
  getGalleryItems,
  getCategoryCounts,
  getProjectAlbums,
} from '../../data/gallery';

const categories = getGalleryCategories();
const allItems = getGalleryItems();
const albums = getProjectAlbums();
const categoryCounts = getCategoryCounts();
const totalCount = allItems.length;

// Filter list by category
const filters = [
  { slug: 'all', name: 'Todas las Categorías', count: totalCount },
  ...categories
    .map((cat) => ({
      slug: cat.slug,
      name: cat.name,
      count: categoryCounts[cat.slug] ?? 0,
    }))
    .filter((cat) => cat.count > 0),
];
---

<PageLayout
  title={getCmsText('page.galeria', 'title', 'Galería de Proyectos') + ' | Hidromont Chile'}
  description={getCmsText('page.galeria', 'subtitle', 'Proyectos, instalaciones y equipos hidromecánicos fabricados por Hidromont Chile.')}
>
  <PageHero
    title={getCmsText('page.galeria', 'title', 'Galería de Proyectos')}
    subtitle={getCmsText('page.galeria', 'subtitle', 'Proyectos, instalaciones y equipos hidromecánicos fabricados por Hidromont Chile.')}
    imageSrc={getCmsText('page.galeria', 'image', '') || undefined}
    imageAlt={getCmsText('page.galeria', 'imageAlt', 'Galería de proyectos Hidromont Chile')}
    breadcrumbs={[{ label: 'Galería' }]}
    cmsEntry="page.galeria"
    compact
  />

  <Section padding="tight" class="bg-background">
    {albums.length === 0 ? (
      <Container>
        <div class="text-center py-20" data-reveal>
          <p class="text-text-muted text-lg">
            Próximamente se añadirán proyectos a esta galería.
          </p>
        </div>
      </Container>
    ) : (
      <div class="w-full px-4 md:px-8 max-w-7xl mx-auto">
        {/* ── Search & Filter Controls Bar ── */}
        <div class="mb-8 md:mb-10 space-y-4" data-reveal>
          {/* Search input */}
          <div class="flex flex-col sm:flex-row sm:items-center justify-end gap-4">
            {/* Real-time Search Field */}
            <div class="relative w-full sm:w-72 md:w-80">
              <input
                type="text"
                id="gallery-search"
                placeholder="Buscar proyecto o cliente..."
                aria-label="Buscar proyecto en galería"
                class="w-full bg-background-alt text-text text-xs md:text-sm px-3.5 py-2.5 pl-9 border border-border focus:border-accent focus:outline-none transition-colors font-mono"
              />
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-4 h-4 text-text-muted absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
                />
              </svg>
            </div>
          </div>

          {/* Category Filter Pills — full width responsive bar */}
          <nav
            aria-label="Filtrar por categoría de servicio"
            class="w-full border border-border overflow-x-auto scrollbar-hide bg-background-alt"
            id="filter-container"
          >
            <div class="flex min-w-max" role="radiogroup">
              {filters.map((filter) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={filter.slug === 'all' ? 'true' : 'false'}
                  data-filter={filter.slug}
                  class={`gallery-filter-btn relative px-3.5 py-2.5 text-[10px] md:text-[11px] font-mono font-semibold uppercase tracking-wider transition-all duration-150 ease-out cursor-pointer border-r border-border last:border-r-0 whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset text-center ${
                    filter.slug === 'all'
                      ? 'bg-primary text-white'
                      : 'bg-background-alt text-text-muted hover:bg-background hover:text-text'
                  }`}
                >
                  {filter.name}
                  <span class="ml-1 opacity-60">({filter.count})</span>
                </button>
              ))}
            </div>
          </nav>
        </div>

        {/* ── Project Albums Grid ── */}
        <div
          id="album-grid"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 items-stretch"
        >
          {albums.map((album, index) => (
            <ProjectAlbumCard album={album} index={index} />
          ))}
        </div>

        {/* Empty state message when search yields no results */}
        <div id="no-results" class="hidden text-center py-16">
          <p class="text-text-muted text-base font-mono">
            No se encontraron proyectos coincidentes con tu búsqueda.
          </p>
        </div>

        {/* ── Data payload for Lightbox ── */}
        <script id="lightbox-data" type="application/json" is:inline set:html={JSON.stringify(allItems)} />
      </div>
    )}
  </Section>

  {/* ── Lightbox (interactive modal viewer) ── */}
  <Lightbox />
</PageLayout>

<script>
  (() => {
    const searchInput = document.getElementById('gallery-search') as HTMLInputElement | null;
    const container = document.getElementById('filter-container');
    const buttons = container?.querySelectorAll('[data-filter]');
    const albumCards = document.querySelectorAll('.project-album-card');
    const noResults = document.getElementById('no-results');

    if (!albumCards.length) return;

    let activeCategory = 'all';
    let searchQuery = '';

    const btnArray = Array.from(buttons || []) as HTMLElement[];

    function updateFilter() {
      let visibleCount = 0;

      albumCards.forEach((card) => {
        const el = card as HTMLElement;
        const cat = el.getAttribute('data-category') ?? '';
        const name = (el.getAttribute('data-project-name') ?? '').toLowerCase();

        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        const matchesSearch = !searchQuery || name.includes(searchQuery);

        const show = matchesCat && matchesSearch;

        if (show) {
          visibleCount++;
          el.style.removeProperty('display');
          el.offsetHeight; // force reflow
          el.style.opacity = '1';
          el.style.transform = 'scale(1)';
        } else {
          el.style.opacity = '0';
          el.style.transform = 'scale(0.95)';
          const onEnd = (e: Event) => {
            if ((e as TransitionEvent).propertyName === 'opacity') {
              el.style.display = 'none';
              el.removeEventListener('transitionend', onEnd);
            }
          };
          el.addEventListener('transitionend', onEnd);
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    // Category button clicks
    btnArray.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-filter') || 'all';
        activeCategory = slug;

        btnArray.forEach((b) => {
          const isActive = b.getAttribute('data-filter') === slug;
          b.setAttribute('aria-checked', String(isActive));
          if (isActive) {
            b.classList.add('bg-primary', 'text-white');
            b.classList.remove('bg-background-alt', 'text-text-muted');
          } else {
            b.classList.remove('bg-primary', 'text-white');
            b.classList.add('bg-background-alt', 'text-text-muted');
          }
        });

        updateFilter();
      });
    });

    // Real-time search input event
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      updateFilter();
    });

    // ARIA Radio group arrow navigation
    container?.addEventListener('keydown', (e: KeyboardEvent) => {
      const current = document.activeElement as HTMLElement;
      const idx = btnArray.indexOf(current);
      if (idx === -1) return;

      let next = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        next = (idx + 1) % btnArray.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        next = (idx - 1 + btnArray.length) % btnArray.length;
      }

      if (next !== -1) {
        e.preventDefault();
        btnArray[next].focus();
        btnArray[next].click();
      }
    });
  })();
</script>

<style>
  .project-album-card {
    transition: opacity 200ms ease-out, transform 200ms ease-out;
  }
</style>
