---
/**
 * /galeria — Project-based Gallery Page.
 *
 * Configurable 100% from CMS (gallery.json export).
 * Groups photos into Project Album cards with search bar and category filtering.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Lightbox from '../../components/gallery/Lightbox.astro';
import { getCmsText } from '../../data/cms';
import { safeJsonForScript } from '../../utils/safeJson';
import { entrySlug } from '../../utils/contentId';
import {
  getGalleryCategories,
  getGalleryItems,
  getCategoryCounts,
  getAlbumName,
} from '../../data/gallery';

const categories = getGalleryCategories();
const allItems = getGalleryItems();
const categoryCounts = getCategoryCounts();

// La galería no agrupa en álbumes: siempre es un muro de fotos individuales
// (solicitud expresa del usuario). La mezcla es un round-robin determinista
// entre proyectos — una foto de cada uno por turno — para que fotos
// consecutivas vengan de proyectos distintos sin depender de aleatoriedad (el
// build queda reproducible), tanto viendo "todas las categorías" como al
// filtrar por una sola: el filtro simplemente recorta este mismo orden.
const itemsByAlbum = new Map<string, typeof allItems>();
for (const item of allItems) {
  const key = item.projectSlug || 'general';
  const bucket = itemsByAlbum.get(key);
  if (bucket) bucket.push(item);
  else itemsByAlbum.set(key, [item]);
}
const albumBuckets = [...itemsByAlbum.values()];
const mixedItems: typeof allItems = [];
for (let i = 0; albumBuckets.some((bucket) => i < bucket.length); i++) {
  for (const bucket of albumBuckets) {
    if (i < bucket.length) mixedItems.push(bucket[i]);
  }
}

// Nombre del proyecto por slug, para el índice de búsqueda de cada foto.
const gallerySearchText = (item: (typeof allItems)[number]) =>
  [
    item.projectSlug ? getAlbumName(item.projectSlug) : '',
    (item.projectSlug ?? '').replaceAll('-', ' '),
    item.categoryName ?? '',
    item.alt,
  ]
    .join(' ')
    .toLowerCase();

// ESTRUCT-2 fix: only project detail pages for `tipo: destacado` entries are
// actually built (see proyectos/[slug].astro's getStaticPaths). Gallery items
// can reference other projectSlugs (used for album grouping) that have no
// page, which would 404 if the Lightbox's "Ver Proyecto" CTA linked to them.
// This set lets the client hide that CTA unless the slug is provably buildable.
const buildableProjectSlugs = (
  await getCollection('proyectos', ({ data }) => data.tipo === 'destacado')
).map((p) => entrySlug(p.id));

// Filter list by category
// B-5: el título NO lleva el nombre de la empresa concatenado — BaseLayout ya
// lo añade. Hacerlo aquí producía «Galería de Proyectos | Hidromont Chile |
// Hidromont Chile S.A.», y era la única ruta de las trece que lo hacía.
const filters = [
  { slug: 'all', name: 'Todas las Categorías', count: mixedItems.length },
  ...categories
    .map((cat) => ({
      slug: cat.slug,
      name: cat.name,
      count: categoryCounts[cat.slug] ?? 0,
    }))
    .filter((cat) => cat.count > 0),
];
---

<PageLayout
  title={getCmsText('page.galeria', 'seoTitle', 'Galería de Proyectos')}
  description={getCmsText(
    'page.galeria',
    'seoDescription',
    'Proyectos, instalaciones y equipos hidromecánicos fabricados por Hidromont Chile.'
  )}
>
  <PageHero
    title={getCmsText('page.galeria', 'title', 'Galería de Proyectos')}
    subtitle={getCmsText(
      'page.galeria',
      'subtitle',
      'Proyectos, instalaciones y equipos hidromecánicos fabricados por Hidromont Chile.'
    )}
    imageSrc={getCmsText('page.galeria', 'image', '') || undefined}
    imageAlt={getCmsText('page.galeria', 'imageAlt', 'Galería de proyectos Hidromont Chile')}
    breadcrumbs={[{ label: 'Galería' }]}
    cmsEntry="page.galeria"
    compact
  />

  <Section padding="tight" class="bg-background">
    {
      allItems.length === 0 ? (
        <Container>
          <div class="text-center py-20" data-reveal>
            <p class="text-text-muted text-lg">
              {getCmsText(
                'page.galeria',
                'emptyState',
                'Próximamente se añadirán proyectos a esta galería.'
              )}
            </p>
          </div>
        </Container>
      ) : (
        <div class="w-full px-4 md:px-8 max-w-7xl mx-auto">
          {/* UIUX-16 fix: the page h1 (PageHero) needs an h2 before the photo
               grid for a correct heading hierarchy. Visually hidden since the
               PageHero title already covers this visually. */}
          <h2 class="sr-only">Fotos</h2>
          {/* ── Search & Filter Toolbar — one bordered container so both
               controls read as a single filtering system instead of two
               stacked, unrelated bars. ── */}
          <div class="relative z-40 mb-8 md:mb-10 flex flex-col md:inline-flex md:flex-row md:items-stretch border border-border bg-background-alt">
            {/* Real-time Search Field */}
            <div class="relative shrink-0 border-b md:border-b-0 md:border-r border-border md:w-64 lg:w-72">
              <input
                type="text"
                id="gallery-search"
                placeholder={getCmsText('page.galeria', 'searchPlaceholder', 'Buscar proyecto...')}
                aria-label="Buscar proyecto en galería"
                class="w-full bg-transparent text-text text-xs md:text-sm px-3.5 py-2.5 pl-9 pr-9 focus:outline-none focus:bg-background transition-colors font-mono"
              />
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-4 h-4 text-text-muted absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
                />
              </svg>
              {/* GAL-27: limpiar la búsqueda sin tener que borrar a mano. */}
              <button
                type="button"
                id="gallery-search-clear"
                aria-label="Limpiar búsqueda"
                class="hidden absolute right-2 top-1/2 -translate-y-1/2 p-1 text-text-muted hover:text-text transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            {/* Category Filter — custom dropdown (no native <select>). Fixed
                 width (matches the search field's scale) instead of flex-1,
                 so the closed trigger is exactly as wide as the open menu. */}
            <div class="relative w-full md:w-64 lg:w-72" id="filter-dropdown">
              <button
                type="button"
                id="filter-trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="filter-menu"
                class="w-full h-full flex items-center justify-between gap-2 px-3.5 py-2.5 text-xs md:text-sm font-mono font-semibold uppercase tracking-wider text-text hover:bg-background transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset"
              >
                <span id="filter-trigger-label" class="truncate">
                  Todas las Categorías
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="filter-trigger-chevron w-4 h-4 text-text-muted shrink-0 transition-transform duration-150"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <div
                role="listbox"
                aria-label="Filtrar por categoría de servicio"
                id="filter-menu"
                class="hidden absolute z-20 top-full left-0 right-0 mt-1 max-h-72 overflow-y-auto bg-background border border-border shadow-lg"
              >
                {filters.map((filter) => (
                  <button
                    type="button"
                    role="option"
                    aria-selected={filter.slug === 'all' ? 'true' : 'false'}
                    data-filter={filter.slug}
                    class={`gallery-filter-option w-full flex items-center justify-between gap-3 px-3.5 py-2.5 text-xs md:text-sm font-mono font-semibold uppercase tracking-wider text-left cursor-pointer border-b border-border last:border-b-0 transition-colors ${
                      filter.slug === 'all'
                        ? 'bg-primary text-white'
                        : 'text-text-muted hover:bg-background-alt hover:text-text'
                    }`}
                  >
                    <span>{filter.name}</span>
                    <span class="opacity-60">({filter.count})</span>
                  </button>
                ))}
              </div>
            </div>
          </div>

          {/* ── Muro de fotos: siempre fotos individuales, ya sea "todas las
               categorías" o una sola. Cada tile es un `.gallery-card`: el
               Lightbox delega clicks en esa clase y abre la foto exacta por
               data-item-id, navegando el conjunto que esté filtrado en cada
               momento (ver #lightbox-data en el script de abajo). ── */}
          <div id="photo-wall" class="columns-2 md:columns-3 lg:columns-4 gap-3 md:gap-4">
            {mixedItems.slice(0, 24).map((item) => (
              <button
                type="button"
                class="gallery-card group relative block w-full mb-3 md:mb-4 break-inside-avoid overflow-hidden border border-border/20 bg-background-alt cursor-pointer transition-shadow hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
                data-item-id={item.id}
                data-search={gallerySearchText(item)}
                aria-label={item.alt}
              >
                <img
                  src={item.src}
                  srcset={item.srcset}
                  sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
                  alt=""
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto block transition-transform duration-300 ease-out group-hover:scale-[1.03]"
                />
              </button>
            ))}
          </div>

          {/* Centinela de scroll infinito: sin contenido ni botón, solo un
             punto de referencia para el IntersectionObserver del script de
             abajo. Al entrar en el viewport carga el siguiente lote — tanto
             al hacer scroll con el mouse como al tabular entre fotos, ya que
             enfocar un elemento fuera de vista también lo desplaza a la
             pantalla. */}
          <div id="gallery-load-sentinel" class="h-px" aria-hidden="true" />

          {/* UIUX-8 fix: announce filter/search results to screen readers — the
             old gallery had this (aria-live counter), the new one didn't. */}
          <p id="results-count" class="sr-only" aria-live="polite" />

          {/* Empty state message when search yields no results */}
          <div id="no-results" class="hidden text-center py-16" role="status">
            <p class="text-text-muted text-base font-mono">
              {getCmsText(
                'page.galeria',
                'noResults',
                'No se encontraron fotos coincidentes con tu búsqueda.'
              )}
            </p>
          </div>

          {/* ── Data payload for Lightbox ── */}
          <script
            id="gallery-wall-data"
            type="application/json"
            is:inline
            set:html={safeJsonForScript(
              mixedItems.map((item) => ({ ...item, searchText: gallerySearchText(item) }))
            )}
          />
          {/* M-9: este bloque nace vacío a propósito. El script de abajo lo
              reescribe en `updateFilter()`, que corre al cargar, así que
              serializarlo aquí mandaba los mismos 173 items una segunda vez
              —81 KB de los 329 de la página— para que el navegador los tirara
              antes de que nadie pudiera abrir una foto. Si el script no llegara
              a correr, el Lightbox reconstruye la lista desde las tarjetas del
              DOM.

              Sustituye a GAL-25, que recortaba de ese payload los campos que el
              visor no lee (`lqip`, focalX/focalY): ahora no viaja ninguno. ── */}
          <script id="lightbox-data" type="application/json" is:inline set:html="[]" />
          {/* ESTRUCT-2 fix: slugs the Lightbox may safely link "Ver Proyecto" to. */}
          <script
            id="lightbox-valid-project-slugs"
            type="application/json"
            is:inline
            set:html={safeJsonForScript(buildableProjectSlugs)}
          />
        </div>
      )
    }
  </Section>

  {/* ── Lightbox (interactive modal viewer) ── */}
  {
    /* JS-1 fix: rendered in the "overlay" slot, outside <main>, so <main> can be
      made inert while the modal is open without disabling the modal itself. */
  }
  <Lightbox slot="overlay" />
</PageLayout>

<script>
  import { paginateMatches } from '../../utils/progressiveList';

  (() => {
    const searchInput = document.getElementById('gallery-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('gallery-search-clear');
    const dropdown = document.getElementById('filter-dropdown');
    const trigger = document.getElementById('filter-trigger') as HTMLButtonElement | null;
    const triggerLabel = document.getElementById('filter-trigger-label');
    const menu = document.getElementById('filter-menu');
    const buttons = menu?.querySelectorAll('[data-filter]');
    const photoWall = document.getElementById('photo-wall');
    const sentinel = document.getElementById('gallery-load-sentinel');
    const wallData = document.getElementById('gallery-wall-data');
    const lightboxData = document.getElementById('lightbox-data');
    const noResults = document.getElementById('no-results');
    const resultsCount = document.getElementById('results-count');

    if (!photoWall || !wallData) return;

    // JS-L4 fix: restore the hash deep-link the old gallery had
    // (/galeria#tuberias activates that category filter on load).
    const initialHash = location.hash.replace('#', '');
    let activeCategory = 'all';
    let searchQuery = '';
    let visiblePhotoLimit = 24;

    type WallItem = {
      id: string;
      src: string;
      srcset?: string;
      width: number;
      height: number;
      alt: string;
      categorySlug: string | null;
      categoryName: string | null;
      projectSlug?: string | null;
      searchText: string;
    };
    const wallItems: WallItem[] = wallData.textContent ? JSON.parse(wallData.textContent) : [];
    let hasMorePhotos = false;

    const btnArray = Array.from(buttons || []) as HTMLElement[];

    // JS-7 fix: strip diacritics on both sides so "montana"/"coihaique" match
    // "Montaña"/"Coyhaique" — same pattern already used in cms-overlay.js.
    function normalizeForSearch(value: string): string {
      return value.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function renderWall(items: WallItem[]) {
      if (!photoWall) return;
      photoWall.replaceChildren(
        ...items.map((item) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className =
            'gallery-card group relative block w-full mb-3 md:mb-4 break-inside-avoid overflow-hidden border border-border/20 bg-background-alt cursor-pointer transition-shadow hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2';
          button.dataset.itemId = item.id;
          button.dataset.search = item.searchText;
          button.setAttribute('aria-label', item.alt);

          const image = document.createElement('img');
          image.src = item.src;
          if (item.srcset) image.srcset = item.srcset;
          image.sizes = '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw';
          image.alt = '';
          image.width = item.width;
          image.height = item.height;
          image.loading = 'lazy';
          image.decoding = 'async';
          image.className =
            'w-full h-auto block transition-transform duration-300 ease-out group-hover:scale-[1.03]';
          button.appendChild(image);
          return button;
        })
      );
    }

    // El Lightbox lee `#lightbox-data` de cero cada vez que abre una foto
    // (collectImages()), así que reescribir este bloque en cada cambio de
    // filtro/búsqueda basta para que "siguiente/anterior" navegue solo dentro
    // de la categoría o búsqueda activa — sin tocar la lógica del visor.
    function updateLightboxData(items: WallItem[]) {
      if (!lightboxData) return;
      lightboxData.textContent = JSON.stringify(
        items.map(({ id, src, srcset, alt, categoryName, projectSlug, width, height }) => ({
          id,
          src,
          srcset,
          alt,
          categoryName,
          projectSlug,
          width,
          height,
        }))
      );
    }

    function updateFilter() {
      const result = paginateMatches(
        wallItems,
        (item) =>
          (activeCategory === 'all' || item.categorySlug === activeCategory) &&
          (!searchQuery || normalizeForSearch(item.searchText).includes(searchQuery)),
        visiblePhotoLimit
      );

      renderWall(result.visible);
      updateLightboxData(result.matching);
      hasMorePhotos = result.hasMore;

      if (noResults) noResults.classList.toggle('hidden', result.total > 0);
      // UIUX-8 fix: announce the visible count on every filter/search change.
      if (resultsCount) {
        resultsCount.textContent =
          result.total === 0
            ? 'No se encontraron fotos.'
            : `Mostrando ${result.visible.length} de ${result.total} ${result.total === 1 ? 'foto' : 'fotos'}.`;
      }
    }

    // Shared by option clicks and the initial hash deep-link. Updates the
    // trigger label (so the closed dropdown shows the active category),
    // the option list's aria-selected/highlight state, the URL hash, and
    // re-runs the card filter.
    function activateFilter(slug: string, updateHash: boolean): void {
      activeCategory = slug;
      visiblePhotoLimit = 24;

      let activeLabel = '';
      btnArray.forEach((b) => {
        const isActive = b.getAttribute('data-filter') === slug;
        b.setAttribute('aria-selected', String(isActive));
        if (isActive) {
          activeLabel = b.querySelector('span')?.textContent || '';
          b.classList.add('bg-primary', 'text-white');
          b.classList.remove('text-text-muted');
        } else {
          b.classList.remove('bg-primary', 'text-white');
          b.classList.add('text-text-muted');
        }
      });

      if (triggerLabel && activeLabel) triggerLabel.textContent = activeLabel;

      if (updateHash) {
        const url = new URL(location.href);
        if (slug === 'all') {
          history.replaceState(null, '', url.pathname + url.search);
        } else {
          history.replaceState(null, '', `#${slug}`);
        }
      }

      updateFilter();
    }

    // ── Custom dropdown open/close ──
    function openMenu() {
      if (!menu || !trigger) return;
      menu.classList.remove('hidden');
      trigger.setAttribute('aria-expanded', 'true');
      trigger.classList.add('filter-trigger-open');
      const current = menu.querySelector(`[data-filter="${activeCategory}"]`) as HTMLElement | null;
      (current || btnArray[0])?.focus();
    }

    function closeMenu(refocusTrigger: boolean) {
      if (!menu || !trigger) return;
      menu.classList.add('hidden');
      trigger.setAttribute('aria-expanded', 'false');
      trigger.classList.remove('filter-trigger-open');
      if (refocusTrigger) trigger.focus();
    }

    function isMenuOpen(): boolean {
      return !menu?.classList.contains('hidden');
    }

    trigger?.addEventListener('click', () => {
      if (isMenuOpen()) closeMenu(false);
      else openMenu();
    });

    // Click outside closes the menu.
    document.addEventListener('click', (e) => {
      if (isMenuOpen() && dropdown && !dropdown.contains(e.target as Node)) closeMenu(false);
    });

    // Category option clicks
    btnArray.forEach((btn) => {
      btn.addEventListener('click', () => {
        activateFilter(btn.getAttribute('data-filter') || 'all', true);
        closeMenu(true);
      });
    });

    // Apply the category from the URL hash on load, if it matches a real filter.
    if (initialHash && btnArray.some((b) => b.getAttribute('data-filter') === initialHash)) {
      activateFilter(initialHash, false);
    }

    // Same-document hash changes (e.g. a same-page anchor, or browser back/
    // forward landing on a different #hash without a full reload) don't
    // re-run the module script's top-level init above — listen separately so
    // the filter still reacts to a hash change while already on this page.
    window.addEventListener('hashchange', () => {
      const hash = location.hash.replace('#', '');
      const target =
        hash && btnArray.some((b) => b.getAttribute('data-filter') === hash) ? hash : 'all';
      activateFilter(target, false);
    });

    // Real-time search input event
    function applySearch(rawValue: string) {
      searchQuery = normalizeForSearch(rawValue.trim().toLowerCase());
      visiblePhotoLimit = 24;
      clearBtn?.classList.toggle('hidden', rawValue.length === 0);
      updateFilter();
    }

    searchInput?.addEventListener('input', (e) => {
      applySearch((e.target as HTMLInputElement).value);
    });

    // GAL-27: limpiar la búsqueda y devolver el foco al campo, para que se
    // pueda seguir escribiendo sin volver a apuntar con el ratón.
    clearBtn?.addEventListener('click', () => {
      if (!searchInput) return;
      searchInput.value = '';
      applySearch('');
      searchInput.focus();
    });

    searchInput?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && searchInput.value) {
        e.preventDefault();
        searchInput.value = '';
        applySearch('');
      }
    });

    // Keyboard: Escape closes and returns focus to the trigger; arrow keys
    // move focus between options while the menu is open.
    menu?.addEventListener('keydown', (e: KeyboardEvent) => {
      const current = document.activeElement as HTMLElement;
      const idx = btnArray.indexOf(current);

      if (e.key === 'Escape') {
        e.preventDefault();
        closeMenu(true);
        return;
      }

      if (idx === -1) return;

      let next = -1;
      if (e.key === 'ArrowDown') {
        next = (idx + 1) % btnArray.length;
      } else if (e.key === 'ArrowUp') {
        next = (idx - 1 + btnArray.length) % btnArray.length;
      }

      if (next !== -1) {
        e.preventDefault();
        btnArray[next].focus();
      }
    });

    trigger?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown' && !isMenuOpen()) {
        e.preventDefault();
        openMenu();
      }
    });

    // Scroll infinito: el centinela vive siempre después del muro de fotos.
    // rootMargin lo dispara ~600px antes de que entre en pantalla, para que
    // el siguiente lote ya esté renderizado cuando el usuario llega abajo.
    // hasMorePhotos evita seguir incrementando el límite una vez agotadas
    // las fotos que coinciden con el filtro activo (el centinela seguiría
    // "visible" indefinidamente si quedan menos de 24 resultados en total).
    if (sentinel) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (hasMorePhotos && entries.some((entry) => entry.isIntersecting)) {
            visiblePhotoLimit += 24;
            updateFilter();
          }
        },
        { rootMargin: '600px 0px' }
      );
      observer.observe(sentinel);
    }

    updateFilter();
  })();
</script>

<style>
  /* Custom category dropdown: chevron flips when the menu is open, and the
     option list gets a visible thin scrollbar since it can hold many
     categories (max-h-72 + overflow-y-auto on #filter-menu). */
  .filter-trigger-open .filter-trigger-chevron {
    transform: rotate(180deg);
  }

  #filter-menu {
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  #filter-menu::-webkit-scrollbar {
    width: 6px;
  }

  #filter-menu::-webkit-scrollbar-track {
    background: transparent;
  }

  #filter-menu::-webkit-scrollbar-thumb {
    background-color: var(--color-border);
    border-radius: 3px;
  }

  #filter-menu::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-text-muted);
  }
</style>
