---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
---

<PageLayout
  title="Mensaje enviado"
  description="Tu mensaje ha sido enviado correctamente. El equipo de Hidromont Chile te contactará a la brevedad."
  noindex
>
  <section class="bg-background py-24 md:py-32">
    <Container size="sm">
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary-light mb-6">
          <svg class="w-8 h-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
        <h1 class="font-heading font-bold text-primary-dark mb-4" style="font-size: var(--font-size-h2);">
          Mensaje enviado correctamente
        </h1>
        <p class="text-text-muted mb-8" style="font-size: var(--font-size-body-lg);">
          Tu mensaje fue enviado correctamente. Te contactaremos a la brevedad.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <Button href="/" variant="primary">Volver al inicio</Button>
          <Button href="/proyectos" variant="secondary">Ver nuestros proyectos</Button>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
