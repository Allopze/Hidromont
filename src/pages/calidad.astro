---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import PageHero from '../components/ui/PageHero.astro';
import CTASection from '../components/ui/CTASection.astro';
import EditableText from '../components/cms/EditableText.astro';
import { getCmsText } from '../data/cms';
---

<PageLayout
  title="Calidad y Medioambiente"
  description="Hidromont Chile S.A. mantiene un sistema de gestión de calidad basado en ISO 9001, con foco en mejora continua y satisfacción del cliente."
>
  <PageHero
    eyebrow={getCmsText('calidad.hero', 'eyebrow', 'Gestión de Calidad')}
    title={getCmsText('calidad.hero', 'title', 'Calidad y Medioambiente')}
    subtitle={getCmsText('calidad.hero', 'subtitle', 'La calidad como compromiso para cumplir las necesidades de nuestros clientes, fomentar la mejora continua y cumplir los requisitos legales y reglamentarios aplicables.')}
    breadcrumbs={[{ label: 'Calidad' }]}
    cmsEntry="calidad.hero"
  />

  <Section variant="default">
    <Container size="lg">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <Eyebrow>
            <EditableText entry="calidad.contenido" field="eyebrow">
              {getCmsText('calidad.contenido', 'eyebrow', 'Sistema de gestión')}
            </EditableText>
          </Eyebrow>
          <EditableText as="h2" entry="calidad.contenido" field="title" class="font-heading font-bold text-primary-dark mb-6" style="font-size: var(--font-size-h2);">
            {getCmsText('calidad.contenido', 'title', 'ISO 9001')}
          </EditableText>
          <div class="space-y-4 text-text-muted" style="line-height: 1.7;">
            <EditableText as="p" entry="calidad.contenido" field="p1" type="textarea">
              {getCmsText('calidad.contenido', 'p1', 'Hidromont mantiene un Sistema de Gestión basado en la norma ISO 9001, como apoyo a la planificación, organización y prestación de sus servicios. Este enfoque refuerza su posicionamiento como proveedor técnico para proyectos de alta exigencia en infraestructura hidráulica e hidroeléctrica.')}
            </EditableText>
            <EditableText as="p" entry="calidad.contenido" field="p2" type="textarea">
              {getCmsText('calidad.contenido', 'p2', 'El propósito declarado de la empresa es enfocar la calidad como un compromiso para cumplir y satisfacer las necesidades de sus clientes, fomentar la mejora continua y cumplir los requisitos del cliente y las obligaciones legales y reglamentarias aplicables.')}
            </EditableText>
          </div>
        </div>

        <div class="flex items-center justify-center">
          <div class="p-10 border-2 border-primary rounded-xl bg-primary-light text-center">
            <EditableText as="p" entry="calidad.badge" field="line1" class="font-mono font-bold text-primary text-5xl mb-2">
              {getCmsText('calidad.badge', 'line1', 'ISO')}
            </EditableText>
            <EditableText as="p" entry="calidad.badge" field="line2" class="font-mono font-bold text-primary text-4xl mb-4">
              {getCmsText('calidad.badge', 'line2', '9001')}
            </EditableText>
            <EditableText as="p" entry="calidad.badge" field="caption" class="text-sm text-text-muted">
              {getCmsText('calidad.badge', 'caption', 'Sistema de gestión de calidad')}
            </EditableText>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section variant="alt">
    <Container>
      <div class="text-center mb-12">
        <Eyebrow>
          <EditableText entry="calidad.principios" field="eyebrow">
            {getCmsText('calidad.principios', 'eyebrow', 'Principios')}
          </EditableText>
        </Eyebrow>
        <EditableText as="h2" entry="calidad.principios" field="title" class="font-heading font-bold text-primary-dark" style="font-size: var(--font-size-h2);">
          {getCmsText('calidad.principios', 'title', 'Nuestros compromisos de calidad')}
        </EditableText>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {([1, 2, 3, 4] as const).map((i) => (
          <div class="p-6 bg-surface border border-border rounded-lg">
            <EditableText as="h3" entry="calidad.principios" field={`p${i}Title`} class="font-heading font-semibold text-primary-dark mb-2" style="font-size: var(--font-size-h4);">
              {getCmsText('calidad.principios', `p${i}Title`, [
                'Satisfacción del cliente',
                'Mejora continua',
                'Cumplimiento normativo',
                'Planificación y organización',
              ][i - 1])}
            </EditableText>
            <EditableText as="p" entry="calidad.principios" field={`p${i}Desc`} type="textarea" class="text-sm text-text-muted leading-relaxed">
              {getCmsText('calidad.principios', `p${i}Desc`, [
                'Cumplir y satisfacer las necesidades de nuestros clientes es el punto de partida de cada proyecto.',
                'Revisamos permanentemente nuestros procesos para elevar la calidad técnica de cada entrega.',
                'Aplicamos los requisitos legales, reglamentarios y técnicos de calidad en cada etapa del proyecto.',
                'El sistema de gestión ISO 9001 apoya la planificación, organización y prestación de nuestros servicios.',
              ][i - 1])}
            </EditableText>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <CTASection
    cmsEntry="calidad.cta"
    title={getCmsText('calidad.cta', 'title', 'Proyectos que exigen calidad certificada')}
    subtitle={getCmsText('calidad.cta', 'subtitle', 'Consulte cómo nuestro sistema de gestión puede aplicarse a su proyecto específico.')}
    primary={{ label: getCmsText('calidad.cta', 'buttonLabel', 'Contactar equipo técnico'), href: '/contacto' }}
  />
</PageLayout>
