---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { getCollection, render } from 'astro:content';
import { projectImages } from '../../data/project-images';
import { projectGalleries } from '../../data/project-galleries';
import EditableImage from '../../components/cms/EditableImage.astro';
import EditableText from '../../components/cms/EditableText.astro';
import { getCmsText } from '../../data/cms';
import { soloEditor } from '../../utils/soloEditor';
import { categoriaLabels } from '../../data/categories';
import { entrySlug } from '../../utils/contentId';
import { formatDiameters } from '../../utils/format';
// El dominio vive en `site` de astro.config.mjs y de ahí lo toman también el
// sitemap y el canónico. Repetirlo aquí fue la causa de que ocho sitios
// declararan hidromont.cl cuando el sitio se sirve en hidromontchile.cl.
// Sin barra final, que es como se concatena más abajo.
const SITIO = Astro.site!.href.replace(/\/$/, '');

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos', ({ data }) => data.tipo === 'destacado');
  return proyectos.map((p) => ({
    params: { slug: entrySlug(p.id) },
    props: { proyecto: p },
  }));
}

const { proyecto } = Astro.props;
const {
  nombre,
  cliente,
  mandante,
  contratista,
  alcance,
  categoria,
  servicio,
  diametro,
  longitud,
  ubicacion,
  normas,
  peso,
  acero,
} = proyecto.data;
const { Content } = await render(proyecto);
const slug = entrySlug(proyecto.id);
const projectImageEntry = `project-image.${slug}`;
const heroImg = projectImages[slug];
const gallery = projectGalleries[slug];
const galleryEntryId = `project-gallery.${slug}`;
const cmsEntry = `proyectos.${slug}`;

// La rejilla de la galería es de 1, 2 o 3 columnas según el ancho. Medido en el
// navegador: 340 px con la ventana a 390 px y 371 px con la ventana a 1.440 px,
// así que sin `sizes` el navegador pediría el candidato de 1.600 px para una
// caja de 371 px.
const GALLERY_SIZES = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 90vw';
const cmsEditingEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';
const containedHero = [
  'ch-besaya',
  'ch-doiras',
  'ch-queltehues',
  'tanques-glp-coyhaique',
  'tanques-glp-puerto-williams',
].includes(slug);
// Rótulos comunes a todas las fichas de proyecto (Páginas → Fichas de
// proyecto — rótulos). Los de los datos se usan también en la cabecera.
const rotulo = {
  datosTecnicos: getCmsText('plantilla.proyecto', 'tituloDatosTecnicos', 'Datos técnicos'),
  diametro: getCmsText('plantilla.proyecto', 'rotuloDiametro', 'Diámetro'),
  diametros: getCmsText('plantilla.proyecto', 'rotuloDiametros', 'Diámetros principales'),
  longitud: getCmsText('plantilla.proyecto', 'rotuloLongitud', 'Longitud'),
  acero: getCmsText('plantilla.proyecto', 'rotuloAcero', 'Acero'),
  peso: getCmsText('plantilla.proyecto', 'rotuloPeso', 'Peso'),
  ubicacion: getCmsText('plantilla.proyecto', 'rotuloUbicacion', 'Ubicación'),
  participantes: getCmsText('plantilla.proyecto', 'tituloParticipantes', 'Participantes'),
  contratista: getCmsText('plantilla.proyecto', 'rotuloContratista', 'Contratista'),
  mandante: getCmsText('plantilla.proyecto', 'rotuloMandante', 'Mandante'),
  cliente: getCmsText('plantilla.proyecto', 'rotuloCliente', 'Cliente'),
  normas: getCmsText('plantilla.proyecto', 'tituloNormasAplicadas', 'Normas aplicadas'),
  servicio: getCmsText('plantilla.proyecto', 'enlaceServicio', 'Ver servicio relacionado:'),
  volver: getCmsText('plantilla.proyecto', 'enlaceVolver', 'Volver a proyectos'),
  galeria: getCmsText('plantilla.proyecto', 'tituloGaleria', 'Galería de imágenes'),
};
const participantSummary = contratista
  ? `${rotulo.contratista}: ${contratista}${mandante ? ` · ${rotulo.mandante}: ${mandante}` : ''}`
  : cliente
    ? `${rotulo.cliente}: ${cliente}`
    : undefined;

// Respaldo por categoría para las 34 fichas que no declaran `servicio`.
// `estructuras` sigue cayendo aquí en Otros Montajes, que es lo correcto para
// una estructura genérica; las seis que no lo eran ya traen el campo.
const servicioHref: Record<string, string> = {
  tuberias: '/servicios/tuberias-forzadas',
  compuertas: '/servicios/compuertas',
  electromecanicos: '/servicios/otros-montajes',
  limpiarrejas: '/servicios/limpiarrejas',
  estructuras: '/servicios/otros-montajes',
};

// El rótulo decía el nombre de la categoría («Estructuras y Tanques»), que no
// es el nombre de ningún servicio: el enlace prometía una página que no existe
// con ese título. Ahora dice el título real de la ficha a la que lleva.
const serviciosPublicados = await getCollection('servicios');
const servicioDestinoHref = servicio
  ? `/servicios/${servicio}`
  : (servicioHref[categoria] ?? '/servicios');
const servicioDestino = serviciosPublicados.find(
  (s) => `/servicios/${entrySlug(s.id)}` === servicioDestinoHref
);
const servicioDestinoLabel = servicioDestino?.data.titulo ?? categoriaLabels[categoria];

// JSON-LD: BreadcrumbList para coherencia con las fichas de servicio (SEO-001).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITIO + '/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Proyectos',
      item: SITIO + '/proyectos/',
    },
    { '@type': 'ListItem', position: 3, name: nombre },
  ],
};
---

<PageLayout
  title={nombre}
  description={formatDiameters(alcance)}
  image={heroImg?.src}
  jsonLd={jsonLd}
>
  <PageHero
    badge={categoriaLabels[categoria] ?? categoria}
    title={nombre}
    subtitle={participantSummary}
    imageSrc={heroImg?.src}
    imageAlt={heroImg?.alt}
    imageWidth={heroImg?.width}
    imageHeight={heroImg?.height}
    breadcrumbs={[{ label: 'Proyectos', href: '/proyectos' }, { label: nombre }]}
    cmsEntry={cmsEntry}
    cmsEyebrowField={false}
    cmsTitleField="nombre"
    cmsSubtitleField={false}
    cmsImageEntry={projectImageEntry}
    imagePresentation={containedHero ? 'contained' : 'cover'}
  />

  <Section variant="default">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contenido principal -->
        <div class="lg:col-span-2">
          <EditableText
            as="div"
            entry={cmsEntry}
            field="body"
            type="richtext"
            class="prose prose-lg max-w-none text-text-muted [&_h2]:font-heading [&_h2]:font-bold [&_h2]:text-primary-dark [&_h3]:font-heading [&_h3]:text-primary-dark [&_table]:text-sm [&_th]:bg-primary-light [&_th]:text-primary-dark [&_th]:font-bold [&_th]:px-4 [&_th]:py-3 [&_td]:px-4 [&_td]:py-3 [&_td]:border-b [&_td]:border-border"
          >
            <Content />
          </EditableText>
        </div>

        <!-- Sidebar con datos técnicos -->
        <aside class="space-y-5">
          {
            (diametro || longitud || ubicacion || peso || acero) && (
              <div class="p-5 border border-border rounded-none bg-background-alt">
                <EditableText
                  as="h3"
                  entry="plantilla.proyecto"
                  field="tituloDatosTecnicos"
                  class="font-heading font-semibold text-primary-dark text-sm uppercase tracking-wide mb-4"
                >
                  {rotulo.datosTecnicos}
                </EditableText>
                <dl class="space-y-3">
                  {diametro && (
                    <div>
                      <EditableText
                        as="dt"
                        entry="plantilla.proyecto"
                        field={diametro.includes('/') ? 'rotuloDiametros' : 'rotuloDiametro'}
                        class="text-xs text-text-muted uppercase tracking-wide"
                      >
                        {diametro.includes('/') ? rotulo.diametros : rotulo.diametro}
                      </EditableText>
                      <EditableText
                        as="dd"
                        entry={cmsEntry}
                        field="diametro"
                        class="font-mono font-semibold text-text"
                      >
                        {formatDiameters(diametro)}
                      </EditableText>
                    </div>
                  )}
                  {longitud && (
                    <div>
                      <EditableText
                        as="dt"
                        entry="plantilla.proyecto"
                        field="rotuloLongitud"
                        class="text-xs text-text-muted uppercase tracking-wide"
                      >
                        {rotulo.longitud}
                      </EditableText>
                      <EditableText
                        as="dd"
                        entry={cmsEntry}
                        field="longitud"
                        class="font-mono font-semibold text-text"
                      >
                        {longitud}
                      </EditableText>
                    </div>
                  )}
                  {acero && (
                    <div>
                      <EditableText
                        as="dt"
                        entry="plantilla.proyecto"
                        field="rotuloAcero"
                        class="text-xs text-text-muted uppercase tracking-wide"
                      >
                        {rotulo.acero}
                      </EditableText>
                      <EditableText
                        as="dd"
                        entry={cmsEntry}
                        field="acero"
                        class="font-semibold text-text"
                      >
                        {acero}
                      </EditableText>
                    </div>
                  )}
                  {peso && (
                    <div>
                      <EditableText
                        as="dt"
                        entry="plantilla.proyecto"
                        field="rotuloPeso"
                        class="text-xs text-text-muted uppercase tracking-wide"
                      >
                        {rotulo.peso}
                      </EditableText>
                      <EditableText
                        as="dd"
                        entry={cmsEntry}
                        field="peso"
                        class="font-mono font-semibold text-text"
                      >
                        {peso}
                      </EditableText>
                    </div>
                  )}
                  {ubicacion && (
                    <div>
                      <EditableText
                        as="dt"
                        entry="plantilla.proyecto"
                        field="rotuloUbicacion"
                        class="text-xs text-text-muted uppercase tracking-wide"
                      >
                        {rotulo.ubicacion}
                      </EditableText>
                      <EditableText
                        as="dd"
                        entry={cmsEntry}
                        field="ubicacion"
                        class="font-semibold text-text"
                      >
                        {ubicacion}
                      </EditableText>
                    </div>
                  )}
                </dl>
              </div>
            )
          }

          {
            (cliente || contratista || mandante) && (
              <div class="p-5 border border-border rounded-none bg-surface">
                <EditableText
                  as="h3"
                  entry="plantilla.proyecto"
                  field="tituloParticipantes"
                  class="font-heading font-semibold text-primary-dark text-sm uppercase tracking-wide mb-2"
                >
                  {rotulo.participantes}
                </EditableText>
                <dl class="space-y-2 text-sm">
                  {contratista && (
                    <div>
                      <EditableText
                        as="dt"
                        entry="plantilla.proyecto"
                        field="rotuloContratista"
                        class="text-text-muted"
                      >
                        {rotulo.contratista}
                      </EditableText>
                      <EditableText
                        as="dd"
                        entry={cmsEntry}
                        field="contratista"
                        class="font-semibold text-text"
                      >
                        {contratista}
                      </EditableText>
                    </div>
                  )}
                  {mandante && (
                    <div>
                      <EditableText
                        as="dt"
                        entry="plantilla.proyecto"
                        field="rotuloMandante"
                        class="text-text-muted"
                      >
                        {rotulo.mandante}
                      </EditableText>
                      <EditableText
                        as="dd"
                        entry={cmsEntry}
                        field="mandante"
                        class="font-semibold text-text"
                      >
                        {mandante}
                      </EditableText>
                    </div>
                  )}
                  {!contratista && !mandante && cliente && (
                    <div>
                      <EditableText
                        as="dt"
                        entry="plantilla.proyecto"
                        field="rotuloCliente"
                        class="text-text-muted"
                      >
                        {rotulo.cliente}
                      </EditableText>
                      <EditableText
                        as="dd"
                        entry={cmsEntry}
                        field="cliente"
                        class="font-semibold text-text"
                      >
                        {cliente}
                      </EditableText>
                    </div>
                  )}
                </dl>
              </div>
            )
          }

          {
            normas && normas.length > 0 && (
              <div class="p-5 border border-border rounded-none bg-surface">
                <EditableText
                  as="h3"
                  entry="plantilla.proyecto"
                  field="tituloNormasAplicadas"
                  class="font-heading font-semibold text-primary-dark text-sm uppercase tracking-wide mb-3"
                >
                  {rotulo.normas}
                </EditableText>
                <EditableText
                  as="div"
                  entry={cmsEntry}
                  field="normas"
                  type="list"
                  class="flex flex-wrap gap-2"
                >
                  {normas.map((n: string) => (
                    <Badge variant="muted">{n}</Badge>
                  ))}
                </EditableText>
              </div>
            )
          }

          <div class="p-5 bg-primary rounded-none text-white">
            <EditableText
              as="p"
              entry="proyectos.detalle.contacto"
              field="title"
              class="font-semibold text-sm mb-2"
            >
              {
                getCmsText(
                  'proyectos.detalle.contacto',
                  'title',
                  '¿Trabaja en proyectos similares?'
                )
              }
            </EditableText>
            <EditableText
              as="p"
              entry="proyectos.detalle.contacto"
              field="text"
              type="textarea"
              class="text-white/80 text-xs mb-4 leading-relaxed"
            >
              {
                getCmsText(
                  'proyectos.detalle.contacto',
                  'text',
                  'Cuéntenos el alcance de su obra y revisaremos las alternativas de fabricación y montaje.'
                )
              }
            </EditableText>
            <Button href="/contacto" variant="secondary-light" class="w-full justify-center">
              <EditableText entry="proyectos.detalle.contacto" field="buttonLabel">
                {getCmsText('proyectos.detalle.contacto', 'buttonLabel', 'Contactar')}
              </EditableText>
            </Button>
          </div>

          <div>
            <a
              href={servicioDestinoHref}
              class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors duration-fast"
            >
              →{' '}
              <EditableText entry="plantilla.proyecto" field="enlaceServicio">
                {rotulo.servicio}
              </EditableText>{' '}
              {servicioDestinoLabel}
            </a>
          </div>
        </aside>
      </div>

      {
        (gallery?.images.length > 0 || cmsEditingEnabled) && (
          <div class="mt-16" {...soloEditor(!gallery?.images.length)}>
            <EditableText
              as="h2"
              entry="plantilla.proyecto"
              field="tituloGaleria"
              class="font-heading font-bold text-primary-dark mb-6"
              style="font-size: var(--font-size-h2);"
            >
              {rotulo.galeria}
            </EditableText>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {/* UIUX-12 fix: this iterated a fixed [1,2,3] and always rendered
                 the bordered wrapper regardless of whether a slot had an image
                 — a project with 1-2 gallery photos showed the real ones
                 plus 1-2 empty bordered boxes in production. Now a slot with
                 no image and no CMS editing renders nothing at all. */}
              {[1, 2, 3].map((n) => {
                const img = gallery?.images[n - 1];
                if (!img && !cmsEditingEnabled) return null;
                return (
                  <div
                    class="aspect-video overflow-hidden rounded-none bg-background-alt border border-border"
                    {...soloEditor(!img)}
                  >
                    {img ? (
                      <EditableImage
                        entry={galleryEntryId}
                        field={`gallery${n}`}
                        altField={`gallery${n}Alt`}
                        src={img.src}
                        alt={img.alt}
                        sizes={GALLERY_SIZES}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    ) : (
                      <div
                        class="w-full h-full flex items-center justify-center text-text-muted text-sm cursor-crosshair"
                        data-cms-entry={galleryEntryId}
                        data-cms-field={`gallery${n}`}
                        data-cms-alt-field={`gallery${n}Alt`}
                        data-cms-type="image"
                      >
                        + Agregar imagen {n}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )
      }

      <div class="mt-12 pt-8 border-t border-border">
        <Button href="/proyectos" variant="secondary">
          ←{' '}
          <EditableText entry="plantilla.proyecto" field="enlaceVolver">
            {rotulo.volver}
          </EditableText>
        </Button>
      </div>
    </Container>
  </Section>
</PageLayout>
