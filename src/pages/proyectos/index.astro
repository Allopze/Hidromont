---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import ProjectTable from '../../components/projects/ProjectTable.astro';
import ProjectFilters from '../../components/projects/ProjectFilters.astro';
import { getCollection } from 'astro:content';
import { getCmsText } from '../../data/cms';

const allProyectos = await getCollection('proyectos');

const destacados = allProyectos
  .filter((p) => p.data.tipo === 'destacado')
  .sort((a, b) => a.data.orden - b.data.orden);

const banco = allProyectos
  .filter((p) => p.data.tipo === 'banco')
  .sort((a, b) => a.data.orden - b.data.orden);

type Categoria = 'tuberias' | 'compuertas' | 'electromecanicos' | 'limpiarrejas' | 'estructuras';

const categorias: { id: Categoria; label: string }[] = [
  { id: 'tuberias', label: 'Tuberías y Blindajes' },
  { id: 'compuertas', label: 'Compuertas y Válvulas' },
  { id: 'electromecanicos', label: 'Montajes Electromecánicos' },
  { id: 'limpiarrejas', label: 'Limpiarrejas' },
  { id: 'estructuras', label: 'Estructuras y Estanques' },
];

const filterItems = [
  { label: 'Todos', href: '#banco-proyectos', id: 'todos' },
  ...categorias.map((c) => ({
    label: c.label,
    href: `#${c.id}`,
    id: c.id,
  })),
];

const bancoPorCategoria = categorias.map((c) => ({
  ...c,
  proyectos: banco.filter((p) => p.data.categoria === c.id),
}));
---

<PageLayout
  title="Proyectos"
  description="Banco de proyectos de Hidromont Chile S.A. — más de 80 proyectos ejecutados en Chile y el extranjero para centrales hidroeléctricas, embalses y presas."
>
  <PageHero
    eyebrow={getCmsText('proyectos.index.hero', 'eyebrow', 'Experiencia')}
    title={getCmsText('proyectos.index.hero', 'title', 'Proyectos')}
    subtitle={getCmsText('proyectos.index.hero', 'subtitle', 'Más de 40 años de proyectos hidráulicos nacionales e internacionales. Tuberías forzadas, compuertas, válvulas, turbinas, limpiarrejas y montajes electromecánicos.')}
    imageSrc={getCmsText('proyectos.index.hero', 'image', '/fotos/curadas/bifurcacion-t-taller.webp')}
    imageAlt={getCmsText('proyectos.index.hero', 'imageAlt', 'Bifurcación en T de gran diámetro fabricada en taller')}
    imageWidth={1536}
    imageHeight={1024}
    breadcrumbs={[{ label: 'Proyectos' }]}
    cmsEntry="proyectos.index.hero"
  />

  <!-- Proyectos destacados -->
  {destacados.length > 0 && (
    <Section variant="default">
      <Container>
        <Eyebrow>Casos destacados</Eyebrow>
        <h2 class="font-heading font-bold text-primary-dark mb-8" style="font-size: var(--font-size-h2);">
          Proyectos de referencia
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {destacados.map((p) => (
            <ProjectCard proyecto={p} />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- Banco de proyectos -->
  <Section variant="alt" id="banco-proyectos">
    <Container>
      <Eyebrow>Banco de proyectos</Eyebrow>
      <h2 class="font-heading font-bold text-primary-dark mb-4" style="font-size: var(--font-size-h2);">
        Experiencia comprobada en embalses, presas y centrales
      </h2>
      <p class="text-text-muted mb-8 max-w-2xl" style="font-size: var(--font-size-body-lg);">
        Registro de proyectos ejecutados clasificados por línea de servicio.
      </p>

      <ProjectFilters items={filterItems} />

      {bancoPorCategoria.map((cat) => (
        cat.proyectos.length > 0 && (
          <div id={cat.id}>
            <ProjectTable proyectos={cat.proyectos} titulo={cat.label} />
          </div>
        )
      ))}
    </Container>
  </Section>

  <Section variant="strong">
    <Container size="md">
      <div class="text-center">
        <h2 class="font-heading font-bold text-white mb-4" style="font-size: var(--font-size-h2);">
          Más de 40 años de proyectos en Chile y el exterior
        </h2>
        <p class="text-white/70 mb-8">
          Nuestra experiencia en decenas de proyectos nos permite anticipar los desafíos técnicos de cada obra.
        </p>
        <Button href="/contacto" size="lg">Ponerse en contacto</Button>
      </div>
    </Container>
  </Section>
</PageLayout>
