---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import ProjectTable from '../../components/projects/ProjectTable.astro';
import ProjectFilters from '../../components/projects/ProjectFilters.astro';
import CTASection from '../../components/ui/CTASection.astro';
import EditableText from '../../components/cms/EditableText.astro';
import { getCollection } from 'astro:content';
import { getCmsText } from '../../data/cms';
import { categoriaLabels } from '../../data/categories';

const allProyectos = await getCollection('proyectos');

const destacados = allProyectos
  .filter((p) => p.data.tipo === 'destacado')
  .sort((a, b) => a.data.orden - b.data.orden);

const banco = allProyectos
  .filter((p) => p.data.tipo === 'banco')
  .sort((a, b) => a.data.orden - b.data.orden);

type Categoria = 'tuberias' | 'compuertas' | 'electromecanicos' | 'limpiarrejas' | 'estructuras';

const categorias: { id: Categoria; label: string }[] = Object.entries(categoriaLabels).map(([id, label]) => ({
  id: id as Categoria,
  label,
}));

const filterItems = [
  { label: 'Todos', href: '#banco-proyectos', id: 'todos' },
  ...categorias.map((c) => ({
    label: c.label,
    href: `#${c.id}`,
    id: c.id,
  })),
];

const bancoPorCategoria = categorias.map((c) => ({
  ...c,
  proyectos: banco.filter((p) => p.data.categoria === c.id),
}));
---

<PageLayout
  title="Proyectos"
  description="Banco de proyectos de Hidromont Chile S.A. — más de 80 proyectos ejecutados en Chile y el extranjero para centrales hidroeléctricas, embalses y presas."
>
  <PageHero
    eyebrow={getCmsText('proyectos.index.hero', 'eyebrow', 'Experiencia')}
    title={getCmsText('proyectos.index.hero', 'title', 'Proyectos')}
    subtitle={getCmsText('proyectos.index.hero', 'subtitle', 'Más de 40 años de proyectos hidráulicos nacionales e internacionales. Tuberías forzadas, compuertas, válvulas, turbinas, limpiarrejas y montajes electromecánicos.')}
    imageSrc={getCmsText('proyectos.index.hero', 'image', '/fotos/curadas/bifurcacion-t-taller.webp')}
    imageAlt={getCmsText('proyectos.index.hero', 'imageAlt', 'Bifurcación en T de gran diámetro fabricada en taller')}
    imageWidth={1536}
    imageHeight={1024}
    breadcrumbs={[{ label: 'Proyectos' }]}
    cmsEntry="proyectos.index.hero"
  />

  <!-- Proyectos destacados -->
  {destacados.length > 0 && (
    <Section variant="default">
      <Container>
        {getCmsText('proyectos.index.destacados', 'eyebrow', '') ? (
          <Eyebrow>
            <EditableText entry="proyectos.index.destacados" field="eyebrow">
              {getCmsText('proyectos.index.destacados', 'eyebrow', '')}
            </EditableText>
          </Eyebrow>
        ) : (
          import.meta.env.DEV && (
            <Eyebrow>
              <EditableText entry="proyectos.index.destacados" field="eyebrow" class="opacity-40 italic">
                (Eyebrow vacía)
              </EditableText>
            </Eyebrow>
          )
        )}
        <EditableText as="h2" entry="proyectos.index.destacados" field="title" class="font-heading font-bold text-primary-dark mb-8" style="font-size: var(--font-size-h2);">
          {getCmsText('proyectos.index.destacados', 'title', 'Proyectos de referencia')}
        </EditableText>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {destacados.map((p) => (
            <ProjectCard proyecto={p} />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- Banco de proyectos -->
  <Section variant="alt" id="banco-proyectos">
    <Container>
      <Eyebrow>
        <EditableText entry="proyectos.index.banco" field="eyebrow">
          {getCmsText('proyectos.index.banco', 'eyebrow', 'Banco de proyectos')}
        </EditableText>
      </Eyebrow>
      <EditableText as="h2" entry="proyectos.index.banco" field="title" class="font-heading font-bold text-primary-dark mb-4" style="font-size: var(--font-size-h2);">
        {getCmsText('proyectos.index.banco', 'title', 'Experiencia comprobada en embalses, presas y centrales')}
      </EditableText>
      <EditableText as="p" entry="proyectos.index.banco" field="subtitle" type="textarea" class="text-text-muted mb-8 max-w-2xl" style="font-size: var(--font-size-lead);">
        {getCmsText('proyectos.index.banco', 'subtitle', 'Registro de proyectos ejecutados clasificados por línea de servicio.')}
      </EditableText>

      <ProjectFilters items={filterItems} />

      {bancoPorCategoria.map((cat) => (
        cat.proyectos.length > 0 && (
          <div id={cat.id}>
            <ProjectTable proyectos={cat.proyectos} titulo={cat.label} />
          </div>
        )
      ))}
    </Container>
  </Section>

  <CTASection
    cmsEntry="proyectos.index.cta"
    title={getCmsText('proyectos.index.cta', 'title', 'Más de 40 años de proyectos en Chile y el exterior')}
    subtitle={getCmsText('proyectos.index.cta', 'subtitle', 'Nuestra experiencia en decenas de proyectos nos permite anticipar los desafíos técnicos de cada obra.')}
    primary={{ label: getCmsText('proyectos.index.cta', 'buttonLabel', 'Ponerse en contacto'), href: '/contacto' }}
  />
</PageLayout>
