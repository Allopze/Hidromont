---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import ProjectTable from '../../components/projects/ProjectTable.astro';
import ProjectFilters from '../../components/projects/ProjectFilters.astro';
import CTASection from '../../components/ui/CTASection.astro';
import EditableText from '../../components/cms/EditableText.astro';
import { getCollection } from 'astro:content';
import { getCmsText } from '../../data/cms';
import { categoriaLabels } from '../../data/categories';

const allProyectos = await getCollection('proyectos');

const destacados = allProyectos
  .filter((p) => p.data.tipo === 'destacado')
  .sort((a, b) => a.data.orden - b.data.orden);

// Un solo sitio para el tamaño de lote: antes vivía como literal 12 en el
// marcado del botón y en tres puntos del script, y el del marcado mentía.
const PAGE_SIZE = 12;

const banco = allProyectos
  .filter((p) => p.data.tipo === 'banco')
  .sort((a, b) => a.data.orden - b.data.orden);

// Rótulo del primer render, antes de que corra el JS: si mañana se despublican
// fichas, el botón no promete un lote que no existe.
const loteInicial = Math.max(0, Math.min(PAGE_SIZE, banco.length - PAGE_SIZE));

type Categoria = 'tuberias' | 'compuertas' | 'electromecanicos' | 'limpiarrejas' | 'estructuras';

const categorias: { id: Categoria; label: string }[] = Object.entries(categoriaLabels)
  .map(([id, label]) => ({
    id: id as Categoria,
    label,
  }))
  .sort((a, b) => a.label.localeCompare(b.label, 'es'));

const bancoPorCategoria = categorias
  .map((c) => ({
    ...c,
    proyectos: banco.filter((p) => p.data.categoria === c.id),
  }))
  // UIUX-13 fix: a category with zero banco projects has no rendered section
  // to jump/filter to — dropping it here means the filter chips never offer
  // a dead option.
  .filter((c) => c.proyectos.length > 0);

const filterItems = [
  { label: 'Todos', id: 'todos' },
  ...bancoPorCategoria.map((c) => ({ label: c.label, id: c.id })),
];
---

<PageLayout
  title={getCmsText('proyectos.index.hero', 'seoTitle', 'Proyectos')}
  description={getCmsText(
    'proyectos.index.hero',
    'seoDescription',
    'Banco de proyectos de Hidromont Chile — más de 80 proyectos ejecutados en Chile y el extranjero para centrales hidroeléctricas, embalses y presas.'
  )}
>
  <PageHero
    title={getCmsText('proyectos.index.hero', 'title', 'Proyectos')}
    subtitle={getCmsText(
      'proyectos.index.hero',
      'subtitle',
      'Más de 40 años de proyectos hidráulicos nacionales e internacionales. Tuberías y blindajes, compuertas, válvulas, turbinas, limpiarrejas y montajes especiales.'
    )}
    imageSrc={getCmsText(
      'proyectos.index.hero',
      'image',
      '/fotos/curadas/bifurcacion-t-taller.webp'
    )}
    imageAlt={getCmsText(
      'proyectos.index.hero',
      'imageAlt',
      'Bifurcación en T de gran diámetro fabricada en taller'
    )}
    imageWidth={1536}
    imageHeight={1024}
    breadcrumbs={[{ label: 'Proyectos' }]}
    cmsEntry="proyectos.index.hero"
  />

  <!-- Proyectos destacados -->
  {
    destacados.length > 0 && (
      <Section variant="default">
        <Container>
          {/*
            IMPORTANTE: NO VOLVER A INCLUIR EL EYEBROW "Casos de referencia" O SIMILARES.
            ESTA SECCIÓN VA DIRECTO AL H2 POR SOLICITUD EXPRESA DEL USUARIO.
          */}
          <EditableText
            as="h2"
            entry="proyectos.index.destacados"
            field="title"
            class="font-heading font-bold text-primary-dark mb-8"
            style="font-size: var(--font-size-h2);"
          >
            {getCmsText('proyectos.index.destacados', 'title', 'Proyectos de referencia')}
          </EditableText>
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
            {destacados.map((p) => (
              <ProjectCard proyecto={p} />
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <!-- Banco de proyectos -->
  <Section variant="alt" id="banco-proyectos">
    <Container>
      <Eyebrow>
        <EditableText entry="proyectos.index.banco" field="eyebrow">
          {getCmsText('proyectos.index.banco', 'eyebrow', 'Banco de proyectos')}
        </EditableText>
      </Eyebrow>
      <EditableText
        as="h2"
        entry="proyectos.index.banco"
        field="title"
        class="font-heading font-bold text-primary-dark mb-4"
        style="font-size: var(--font-size-h2);"
      >
        {
          getCmsText(
            'proyectos.index.banco',
            'title',
            'Experiencia comprobada en embalses, presas y centrales'
          )
        }
      </EditableText>
      <EditableText
        as="p"
        entry="proyectos.index.banco"
        field="subtitle"
        type="textarea"
        class="text-text-muted mb-8 max-w-2xl"
        style="font-size: var(--font-size-lead);"
      >
        {
          getCmsText(
            'proyectos.index.banco',
            'subtitle',
            'Obras del grupo en Chile, España, Honduras y Costa Rica, agrupadas por línea de servicio.'
          )
        }
      </EditableText>

      <label
        class="mb-5 grid max-w-md gap-2 text-sm font-semibold text-primary-dark"
        for="project-search"
      >
        Buscar en el banco de proyectos
        <input
          id="project-search"
          type="search"
          placeholder="Proyecto, cliente, ubicación o alcance"
          class="min-h-[44px] border border-border bg-white px-3 py-2 font-normal text-text focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary"
        />
      </label>

      <ProjectFilters items={filterItems} />

      <div id="project-sections">
        {
          bancoPorCategoria.map((cat) => (
            <div id={cat.id} data-category={cat.id}>
              <ProjectTable proyectos={cat.proyectos} titulo={cat.label} />
            </div>
          ))
        }
      </div>
      <div
        id="project-no-results"
        class="hidden border border-border bg-white px-6 py-10 text-center"
        role="status"
        aria-live="polite"
      >
        <p class="mb-4 font-semibold text-primary-dark">
          No encontramos proyectos con estos criterios.
        </p>
        <button
          type="button"
          id="project-reset-filters"
          class="min-h-[44px] border border-primary px-5 py-3 font-semibold text-primary-dark hover:bg-primary-light focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Limpiar búsqueda y filtros
        </button>
      </div>
      <p id="project-results-count" class="sr-only" aria-live="polite"></p>
      <div id="project-load-more-wrap" class="mt-2 flex justify-center" data-page-size={PAGE_SIZE}>
        <button
          type="button"
          id="project-load-more"
          class="min-h-[44px] border border-primary px-5 py-3 font-semibold text-primary-dark hover:bg-primary-light focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Ver {loteInicial} proyectos más
        </button>
      </div>
    </Container>
  </Section>

  <script>
    import { nextBatchSize, paginateMatches } from '../../utils/progressiveList';

    // UIUX-13 fix: real client-side filtering for the category pills — see
    // ProjectFilters.astro for the markup/a11y side of this change.
    (() => {
      const container = document.getElementById('project-filter-container');
      const buttons = container?.querySelectorAll<HTMLElement>('[data-filter]');
      const sections = document.querySelectorAll<HTMLElement>('#project-sections [data-category]');
      const desktopItems = Array.from(
        document.querySelectorAll<HTMLElement>('tr[data-project-item]')
      );
      const allRenderedItems = Array.from(
        document.querySelectorAll<HTMLElement>('[data-project-item]')
      );
      const search = document.getElementById('project-search') as HTMLInputElement | null;
      const noResults = document.getElementById('project-no-results');
      const resetFilters = document.getElementById('project-reset-filters');
      const loadMore = document.getElementById('project-load-more');
      const loadMoreWrap = document.getElementById('project-load-more-wrap');
      // El frontmatter no llega hasta aquí: este script se hoistea a un archivo
      // aparte, así que el tamaño de lote viaja por atributo de datos.
      const PAGE_SIZE = Number(loadMoreWrap?.dataset.pageSize) || 12;
      const resultsCount = document.getElementById('project-results-count');
      if (!buttons || !sections.length || !desktopItems.length) return;

      const btnArray = Array.from(buttons);
      let activeFilter = 'todos';
      let searchQuery = '';
      let visibleLimit = PAGE_SIZE;

      const normalize = (value: string) =>
        value
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase();

      function updateProjects(): void {
        const result = paginateMatches(
          desktopItems,
          (item) => {
            const category = item.dataset.projectCategory || '';
            const text = normalize(item.dataset.projectSearch || '');
            return (
              (activeFilter === 'todos' || category === activeFilter) &&
              (!searchQuery || text.includes(searchQuery))
            );
          },
          visibleLimit
        );
        const visibleKeys = new Set(result.visible.map((item) => item.dataset.projectKey));

        allRenderedItems.forEach((item) => {
          item.hidden = !visibleKeys.has(item.dataset.projectKey);
        });
        sections.forEach((section) => {
          section.classList.toggle(
            'hidden',
            !section.querySelector('[data-project-item]:not([hidden])')
          );
        });
        noResults?.classList.toggle('hidden', result.total > 0);
        loadMoreWrap?.classList.toggle('hidden', !result.hasMore);
        if (loadMore) {
          // El número va en el texto visible, no en un aria-label aparte:
          // WCAG 2.5.3 exige que el nombre accesible contenga lo que se lee.
          const lote = nextBatchSize(result.total, result.visible.length, PAGE_SIZE);
          loadMore.textContent = lote === 1 ? 'Ver 1 proyecto más' : `Ver ${lote} proyectos más`;
        }
        if (resultsCount) {
          resultsCount.textContent = `Mostrando ${result.visible.length} de ${result.total} proyectos.`;
        }
      }

      function activateFilter(id: string): void {
        activeFilter = id;
        visibleLimit = PAGE_SIZE;
        btnArray.forEach((b) => {
          const isActive = b.getAttribute('data-filter') === id;
          b.setAttribute('aria-checked', String(isActive));
          b.tabIndex = isActive ? 0 : -1;
          b.classList.toggle('bg-primary', isActive);
          b.classList.toggle('text-white', isActive);
          b.classList.toggle('bg-background-alt', !isActive);
          b.classList.toggle('text-text', !isActive);
          b.classList.toggle('border', !isActive);
          b.classList.toggle('border-border/50', !isActive);
        });

        updateProjects();
      }

      btnArray.forEach((btn) => {
        btn.addEventListener('click', () => {
          activateFilter(btn.getAttribute('data-filter') || 'todos');
        });
      });

      container?.addEventListener('keydown', (e: KeyboardEvent) => {
        const current = document.activeElement as HTMLElement;
        const idx = btnArray.indexOf(current);
        if (idx === -1) return;

        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          next = (idx + 1) % btnArray.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          next = (idx - 1 + btnArray.length) % btnArray.length;
        }

        if (next !== -1) {
          e.preventDefault();
          btnArray[next].focus();
          btnArray[next].click();
        }
      });

      search?.addEventListener('input', () => {
        searchQuery = normalize(search.value.trim());
        visibleLimit = PAGE_SIZE;
        updateProjects();
      });

      resetFilters?.addEventListener('click', () => {
        if (search) search.value = '';
        searchQuery = '';
        activateFilter('todos');
        search?.focus();
      });

      loadMore?.addEventListener('click', () => {
        visibleLimit += PAGE_SIZE;
        updateProjects();
      });

      updateProjects();
    })();
  </script>

  <CTASection
    cmsEntry="proyectos.index.cta"
    title={getCmsText(
      'proyectos.index.cta',
      'title',
      'Más de 40 años de proyectos en Chile y el exterior'
    )}
    subtitle={getCmsText(
      'proyectos.index.cta',
      'subtitle',
      'Cuéntenos el alcance de su obra y revisaremos las alternativas de fabricación y montaje.'
    )}
    primary={{
      label: getCmsText('proyectos.index.cta', 'buttonLabel', 'Contacto'),
      href: '/contacto',
      field: 'buttonLabel',
    }}
  />
</PageLayout>
