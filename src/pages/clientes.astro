---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import ClientesHero from '../components/clientes/ClientesHero.astro';
import CTASection from '../components/ui/CTASection.astro';
import EditableText from '../components/cms/EditableText.astro';
import EditableImage from '../components/cms/EditableImage.astro';
import { getEntry } from 'astro:content';
import { getCmsText } from '../data/cms';
import { getClienteLogoByNombre, listaDeClientes, logoKeyFor } from '../data/cliente-logos';
import { soloEditor } from '../utils/soloEditor';

const clientesEntry = await getEntry('clientes', 'clientes');

// Medido en el navegador: cada logo se pinta a 119 px de ancho, igual en móvil
// que en escritorio. Sin `sizes`, el navegador asume el ancho de la ventana y
// escoge del srcset el candidato de 1.600 px para pintar 119 px.
const LOGO_SIZES = '119px';
// La lista sale del CMS (se edita en el recuadro de abajo, solo visible en el
// editor); clientes.json queda de respaldo.
// P2-11 (auditoría 2026-09): se pinta en el orden de la lista del CMS. Antes
// se reordenaba alfabéticamente y el orden que fijaba quien edita no servía.
const lista = listaDeClientes(clientesEntry?.data?.items ?? []);
const cmsEditingEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';

// Unique logos for the hero marquee
const heroLogos = [
  ...new Set(lista.map((c) => getClienteLogoByNombre(c.nombre, c.logo || '')).filter(Boolean)),
];

// Alt text of each logo (client name)
const logoAlts: Record<string, string> = {};
for (const c of lista) {
  const src = getClienteLogoByNombre(c.nombre, c.logo || '');
  if (src && !logoAlts[src]) logoAlts[src] = c.nombre;
}
---

<PageLayout
  title={getCmsText('clientes.hero', 'seoTitle', 'Clientes')}
  description={getCmsText(
    'clientes.hero',
    'seoDescription',
    'Referencias de Hidromont Chile — empresas de los sectores eléctrico, construcción, minero e industrial que confían en nuestros servicios hidromecánicos.'
  )}
>
  <ClientesHero
    title={getCmsText('clientes.hero', 'title', 'Clientes')}
    subtitle={getCmsText(
      'clientes.hero',
      'subtitle',
      'Empresas eléctricas, constructoras, mineras, sanitarias e industriales que han confiado en Hidromont para sus proyectos hidráulicos e hidroeléctricos.'
    )}
    breadcrumbs={[{ label: 'Clientes' }]}
    cmsEntry="clientes.hero"
    logos={heroLogos}
    logoAlts={logoAlts}
  />

  <Section variant="default">
    <Container>
      <div class="text-center mb-16">
        <Eyebrow>
          <EditableText entry="clientes.sectores" field="eyebrow">
            {getCmsText('clientes.sectores', 'eyebrow', 'Nuestros clientes')}
          </EditableText>
        </Eyebrow>
        {
          /*
          IMPORTANTE: NO VOLVER A INCLUIR LA FRASE "Empresas que confían en nosotros" O SIMILARES.
          ESTA SECCIÓN DEBE QUEDAR SIN TÍTULO H2 ADICIONAL POR SOLICITUD EXPRESA DEL USUARIO.
        */
        }
      </div>

      <div class="clientes-grid">
        {
          lista.map((c) => {
            const logoSrc = getClienteLogoByNombre(c.nombre, c.logo || '');
            const logoKey = logoKeyFor(c.nombre);
            return (
              <div class="clientes-item" title={c.nombre}>
                {logoSrc ? (
                  <EditableImage
                    entry="clientes.logos"
                    field={`logo-${logoKey}`}
                    src={logoSrc}
                    alt={c.nombre}
                    height={56}
                    sizes={LOGO_SIZES}
                    class="clientes-logo-img"
                    loading="lazy"
                  />
                ) : (
                  <span
                    class="clientes-fallback-text"
                    {...(cmsEditingEnabled
                      ? {
                          // Un cliente sin logo: pulsar su nombre abre el
                          // editor de imagen para subírselo.
                          'data-cms-entry': 'clientes.logos',
                          'data-cms-field': `logo-${logoKey}`,
                          'data-cms-type': 'image',
                        }
                      : {})}
                  >
                    {c.nombre}
                  </span>
                )}
              </div>
            );
          })
        }
      </div>

      {
        cmsEditingEnabled && (
          <div class="clientes-lista-editor" {...soloEditor(true)}>
            <p class="clientes-lista-editor-titulo">
              Lista de clientes · solo la ve quien edita. Púlsala para añadir, quitar o renombrar;
              el logo de un cliente nuevo se añade pulsando su nombre arriba.
            </p>
            <EditableText as="ul" entry="clientes.lista" field="nombres" type="list">
              {lista.map((c) => (
                <li>{c.nombre}</li>
              ))}
            </EditableText>
          </div>
        )
      }
    </Container>
  </Section>

  <CTASection
    cmsEntry="clientes.cta"
    title={getCmsText('clientes.cta', 'title', '¿Trabaja en una obra hidráulica o hidroeléctrica?')}
    subtitle={getCmsText(
      'clientes.cta',
      'subtitle',
      'Revise nuestros servicios y casos de referencia para proyectos hidráulicos e hidroeléctricos.'
    )}
    primary={{
      label: getCmsText('clientes.cta', 'buttonLabel', 'Contacto'),
      href: '/contacto',
      field: 'buttonLabel',
    }}
  />
</PageLayout>

<style>
  /* ── Clean Floating Logo Grid ── */
  .clientes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: center;
    justify-items: center;
    gap: 48px 32px;
    max-width: 1000px;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .clientes-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 56px 40px;
    }
  }

  @media (min-width: 1024px) {
    .clientes-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 64px 48px;
    }
  }

  .clientes-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 80px; /* Generous area height for consistent vertical alignment */
    transition: transform var(--motion-base) var(--ease-standard);
  }

  .clientes-item:hover {
    transform: translateY(-3px);
  }

  .clientes-item :global(img) {
    height: auto;
    width: auto;
    max-width: 100%;
    max-height: 56px; /* Constraints logo height within the flex item safely */
    object-fit: contain;
    transition: transform var(--motion-base) var(--ease-standard);
  }

  .clientes-item:hover :global(img) {
    transform: scale(1.05);
  }

  /* Text-only fallback styles for a premium look without cards */
  .clientes-lista-editor {
    margin-top: 2.5rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--color-border);
    background: var(--color-background-alt);
    font-size: 0.875rem;
  }
  .clientes-lista-editor-titulo {
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
  }
  .clientes-lista-editor ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .clientes-fallback-text {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-align: center;
    text-transform: uppercase;
    transition: color var(--motion-base) var(--ease-standard);
  }

  .clientes-item:hover .clientes-fallback-text {
    color: var(--color-primary);
  }
</style>
