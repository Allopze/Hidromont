---
/**
 * El overlay se inyecta como script inline (`set:html`), no como módulo ES: por
 * eso `cms-overlay.js` se importa con `?raw` y es un IIFE autocontenido.
 *
 * Existió un intento de partirlo en `src/scripts/cms/{ui,styles,editor,
 * collections,state-api}.js` que quedó a medias (cubría ~1/3 de los estilos y
 * la mitad de las funciones, sin la galería ni el selector de medios) y que
 * nadie llegó a importar. Se eliminó en sep-2026: al no estar conectado se
 * desactualizaba en silencio mientras el monolito avanzaba, y arreglar un bug
 * ahí no tenía ningún efecto sobre el sitio.
 *
 * Si se retoma la modularización, el patrón correcto es el de `mobile-menu.ts`:
 * autorlo como módulo TypeScript que exporta una función devolviendo el runtime
 * como string, para que siga entrando por `set:html` y quede cubierto por tests.
 */
import overlayScript from '../../scripts/cms-overlay.js?raw';
import { getMobileMenuRuntime } from '../../scripts/cms/mobile-menu';

const enabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';
const apiBase = import.meta.env.PUBLIC_CMS_API_BASE;
const isDev = import.meta.env.DEV;
const mobileMenuScript = getMobileMenuRuntime();
---

{enabled && (
  <>
    <script is:inline define:vars={{ apiBase, isDev }}>
      window.__HIDROMONT_CMS__ = {
        apiBase: apiBase || (isDev ? `${location.protocol}//${location.hostname}:8787` : location.origin),
        isDev,
      };
    </script>
    <script is:inline set:html={overlayScript}></script>
    <script is:inline set:html={mobileMenuScript}></script>
  </>
)}
