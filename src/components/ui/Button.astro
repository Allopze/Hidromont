---
interface Props {
  variant?: 'primary' | 'secondary' | 'secondary-light' | 'link';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  size?: 'md' | 'lg';
  disabled?: boolean;
  class?: string;
  id?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  size = 'md',
  disabled = false,
  class: className = '',
  id,
  ariaLabel,
} = Astro.props;

// transform en la transición + active:scale en las variantes "sólidas" dan
// feedback táctil al pulsar (DES-001). La variante link es texto y no escala.
const base =
  'inline-flex items-center justify-center gap-2 font-body font-semibold whitespace-nowrap transition-[background-color,border-color,color,box-shadow,transform] duration-base ease-standard focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2';

const sizes = {
  md: 'px-5 py-3 text-base min-h-[44px] rounded-none',
  lg: 'px-7 py-4 text-lg min-h-[52px] rounded-none',
};

/*
 * P1-11 (auditoría 2026-09): el contorno de foco usaba el color al 30 % y
 * quedaba en 1,29:1 sobre fondo oscuro y 1,60:1 sobre blanco (WCAG 2.4.7 y
 * 1.4.11). Ahora es un doble anillo opaco: el contorno de 3 px contrasta sobre
 * fondo claro y el halo de 2 px del hueco, sobre fondo oscuro o foto.
 */
const FOCO_SOBRE_CLARO = 'focus-visible:outline-primary-dark focus-visible:shadow-[0_0_0_2px_#fff]';
const FOCO_SOBRE_OSCURO = 'focus-visible:outline-white focus-visible:shadow-[0_0_0_2px_#0F2433]';

const variants = {
  primary: `bg-primary text-white border border-primary hover:bg-primary-dark hover:border-primary-dark hover:text-white active:scale-[0.98] ${FOCO_SOBRE_CLARO} disabled:bg-border disabled:border-border disabled:text-text-muted disabled:cursor-not-allowed`,
  secondary: `bg-transparent text-primary border border-primary hover:bg-primary-light hover:text-primary-dark active:scale-[0.98] ${FOCO_SOBRE_CLARO} disabled:text-text-muted disabled:border-border disabled:cursor-not-allowed`,
  'secondary-light': `btn-on-photo bg-transparent text-white border border-white hover:bg-white/10 active:scale-[0.98] ${FOCO_SOBRE_OSCURO} disabled:text-white/40 disabled:border-white/20 disabled:cursor-not-allowed`,
  link: 'bg-transparent text-primary underline underline-offset-4 decoration-1 hover:text-primary-dark p-0 min-h-0 rounded-none',
};

const classes = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classes} id={id} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} id={id} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
