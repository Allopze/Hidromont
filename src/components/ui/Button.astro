---
interface Props {
  variant?: 'primary' | 'secondary' | 'link';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  size?: 'md' | 'lg';
  disabled?: boolean;
  class?: string;
  id?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  size = 'md',
  disabled = false,
  class: className = '',
  id,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-body font-semibold transition-[background-color,border-color,color,box-shadow] duration-base ease-standard focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2';

const sizes = {
  md: 'px-5 py-3 text-base min-h-[44px] rounded-md',
  lg: 'px-7 py-4 text-lg min-h-[52px] rounded-md',
};

const variants = {
  primary:
    'bg-primary text-white border border-primary hover:bg-primary-dark hover:border-primary-dark focus-visible:outline-primary/30 disabled:bg-border disabled:border-border disabled:text-text-muted disabled:cursor-not-allowed',
  secondary:
    'bg-transparent text-primary border border-primary hover:bg-primary-light focus-visible:outline-primary/30 disabled:text-text-muted disabled:border-border disabled:cursor-not-allowed',
  link: 'bg-transparent text-primary underline underline-offset-4 decoration-1 hover:text-primary-dark p-0 min-h-0 rounded-none',
};

const classes = [base, sizes[size], variants[variant], className]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a href={href} class={classes} id={id}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} id={id}>
      <slot />
    </button>
  )
}
