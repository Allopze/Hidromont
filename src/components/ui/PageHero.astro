---
import Container from './Container.astro';
import EditableImage from '../cms/EditableImage.astro';
import EditableText from '../cms/EditableText.astro';

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow?: string; // kept for backward compat — no longer rendered
  badge?: string; // category chip shown between breadcrumb and accent line (detail pages)
  title: string;
  subtitle?: string;
  breadcrumbs?: Breadcrumb[];
  imageSrc?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  videoSrc?: string;
  videoAlt?: string;
  cmsEntry?: string;
  cmsImageEntry?: string;
  cmsEyebrowField?: string | false; // kept for backward compat
  cmsTitleField?: string | false;
  cmsSubtitleField?: string | false;
  compact?: boolean; // tighter vertical rhythm (text-only layout) — e.g. gallery/index pages
  imagePresentation?: 'cover' | 'contained';
}

const {
  badge,
  title,
  subtitle,
  breadcrumbs,
  imageSrc,
  imageAlt = '',
  imageWidth = 660,
  imageHeight = 495,
  videoSrc,
  videoAlt,
  cmsEntry,
  cmsImageEntry = cmsEntry,
  cmsTitleField = 'title',
  cmsSubtitleField = 'subtitle',
  compact = false,
  imagePresentation = 'cover',
} = Astro.props;

const textOnlyPadding = compact ? 'py-10 md:py-12 lg:py-14' : 'py-16 md:py-20 lg:py-24';
import { getCmsImageObjectPosition, getCmsText, getCmsValue } from '../../data/cms';

// El video de la cabecera sale del CMS (campo `video` de la ficha de imagen),
// con su encuadre; vacío, se ve la foto. `videoSrc` queda como respaldo del
// llamador. Donde la ficha tiene el campo, la foto ofrece «Poner un video».
const admiteVideo =
  Boolean(cmsImageEntry) && getCmsValue(cmsImageEntry!, 'video', undefined) !== undefined;
const videoCms = admiteVideo ? getCmsText(cmsImageEntry!, 'video', '') : '';
const videoFinal = videoCms || videoSrc;
const videoDescripcion =
  (admiteVideo && getCmsText(cmsImageEntry!, 'videoAlt', '')) || videoAlt || imageAlt;
const videoPosicion = admiteVideo ? getCmsImageObjectPosition(cmsImageEntry, 'video') : undefined;
const cmsEditingEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';
const marcasVideo =
  cmsEditingEnabled && admiteVideo
    ? {
        'data-cms-entry': cmsImageEntry,
        'data-cms-field': 'video',
        'data-cms-alt-field': 'videoAlt',
        'data-cms-type': 'video',
        // La foto que queda de respaldo, para ofrecer cambiarla desde el video.
        'data-cms-poster-field': 'image',
      }
    : {};
const marcasRespaldo =
  cmsEditingEnabled && admiteVideo
    ? {
        'data-cms-entry': cmsImageEntry,
        'data-cms-field': 'image',
        'data-cms-alt-field': 'imageAlt',
        'data-cms-type': 'image',
      }
    : {};
// Botón del video (Textos del sitio → Textos para lectores de pantalla).
const videoPausar = getCmsText('site.accesibilidad', 'videoPausar', 'Pausar video');
const videoReproducir = getCmsText('site.accesibilidad', 'videoReproducir', 'Reproducir video');
---

<section class="relative bg-background-strong text-white overflow-hidden">
  {/* ── Cinematic layout: text (45%) + full-bleed image (55%) ── */}
  {
    (imageSrc || videoFinal) && (
      <div
        class="relative flex flex-col lg:flex-row lg:items-stretch"
        style="min-height: clamp(380px, 50vw, 580px);"
      >
        {/* Text column */}
        <div
          class="relative z-10 w-full lg:w-[45%] py-16 md:py-20 lg:py-28 pr-6 lg:pr-16 flex flex-col justify-center"
          style="padding-left: max(24px, calc((100vw - 1320px) / 2 + 24px));"
        >
          {/* Grid motif — text column only */}
          <div
            class="absolute inset-0 pointer-events-none"
            aria-hidden="true"
            style="background-image: linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 48px 48px;"
          />

          {breadcrumbs && breadcrumbs.length > 0 && (
            <nav
              class="flex items-center gap-1.5 mb-4 text-xs text-white/60 font-body relative"
              aria-label="Breadcrumb"
            >
              {breadcrumbs.map((crumb, i) => (
                <>
                  {i > 0 && (
                    <span aria-hidden="true" class="text-white/30">
                      ›
                    </span>
                  )}
                  {crumb.href ? (
                    <a
                      href={crumb.href}
                      class="hover:text-white/80 transition-colors duration-fast no-underline"
                    >
                      {crumb.label}
                    </a>
                  ) : (
                    <span>{crumb.label}</span>
                  )}
                </>
              ))}
            </nav>
          )}

          {badge && (
            <span class="inline-block mb-4 px-2 py-0.5 text-xs font-mono text-accent border border-accent/30 tracking-[0.04em] relative self-start">
              {badge}
            </span>
          )}

          {/* Accent line: graphic rhythm break */}
          <div class="w-10 h-0.5 bg-accent mb-5 relative" aria-hidden="true" />

          <EditableText
            as="h1"
            entry={cmsTitleField ? cmsEntry : undefined}
            field={cmsTitleField || 'title'}
            class="font-heading font-bold text-white leading-tight mb-5 relative"
            style="font-size: var(--font-size-display); letter-spacing: -0.02em; text-wrap: balance;"
            reveal
          >
            {title}
          </EditableText>

          {subtitle && (
            <EditableText
              as="p"
              entry={cmsSubtitleField ? cmsEntry : undefined}
              field={cmsSubtitleField || 'subtitle'}
              class="text-white/70 max-w-lg relative"
              style="font-size: var(--font-size-lead); line-height: 1.7; --reveal-delay: 0.1s;"
              type="textarea"
              reveal
            >
              {subtitle}
            </EditableText>
          )}

          <slot />
        </div>

        {/* Image column: fills remaining width, bleeds to viewport right edge */}
        <div
          class="flex-1 relative overflow-hidden min-h-[280px] lg:min-h-0"
          data-reveal-cinematic
          data-image-presentation={imagePresentation}
          style="--reveal-delay: 0.06s;"
        >
          {/* Parallax wrapper: oversized to allow pan without edge bleed */}
          <div
            class:list={[
              'absolute w-full',
              imagePresentation === 'contained' &&
                'inset-0 flex items-center justify-center p-6 lg:p-10',
            ]}
            style={imagePresentation === 'contained' ? undefined : 'top: -6%; height: 112%;'}
            data-parallax={imagePresentation === 'contained' ? undefined : '0.04'}
          >
            {videoFinal ? (
              <>
                <video
                  src={videoFinal}
                  poster={imageSrc}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label={videoDescripcion}
                  style={videoPosicion ? `object-position:${videoPosicion}` : undefined}
                  data-hero-video
                  {...marcasVideo}
                  class={
                    imagePresentation === 'contained'
                      ? 'max-w-full max-h-full object-contain'
                      : 'w-full h-full object-cover'
                  }
                />
                {imageSrc && (
                  <img
                    src={imageSrc!}
                    alt={imageAlt}
                    width={imageWidth}
                    height={imageHeight}
                    data-hero-video-poster
                    {...marcasRespaldo}
                    class={
                      imagePresentation === 'contained'
                        ? 'max-w-full max-h-full object-contain'
                        : 'w-full h-full object-cover'
                    }
                  />
                )}
              </>
            ) : (
              <EditableImage
                entry={cmsImageEntry}
                field="image"
                altField="imageAlt"
                src={imageSrc!}
                alt={imageAlt}
                width={imageWidth}
                height={imageHeight}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class={
                  imagePresentation === 'contained'
                    ? 'w-auto h-auto max-w-full max-h-full object-contain'
                    : 'w-full h-full object-cover'
                }
                style={
                  imagePresentation === 'contained'
                    ? `max-width:${imageWidth}px;max-height:${imageHeight}px`
                    : undefined
                }
                data-cms-video-field={admiteVideo ? 'video' : undefined}
              />
            )}
          </div>

          {videoFinal && (
            <button
              type="button"
              class="absolute bottom-4 right-4 z-20 inline-flex min-h-[44px] items-center gap-2 border border-white/40 bg-background-strong/90 px-3 text-sm font-semibold text-white transition-colors hover:bg-background-strong focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-white"
              data-hero-video-control
              data-label-pausar={videoPausar}
              data-label-reproducir={videoReproducir}
              aria-label={videoPausar}
            >
              <svg
                data-video-pause-icon
                class="h-4 w-4"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M4 3h3v10H4zM9 3h3v10H9z" />
              </svg>
              <svg
                data-video-play-icon
                class="hidden h-4 w-4"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M4 2.8v10.4c0 .6.7 1 1.2.7l8-5.2a.8.8 0 0 0 0-1.4l-8-5.2C4.7 1.8 4 2.2 4 2.8Z" />
              </svg>
              <span data-video-control-label>{videoPausar}</span>
            </button>
          )}

          {/* Left-edge atmospheric scrim */}
          <div
            class="absolute inset-y-0 left-0 w-40 pointer-events-none z-10"
            style="background: linear-gradient(to right, rgb(15,36,51) 0%, transparent 100%);"
            aria-hidden="true"
          />
        </div>
      </div>
    )
  }

  {/* ── Text-only layout (no image) ── */}
  {
    !imageSrc && !videoFinal && (
      <Container size="2xl">
        <div class={`relative z-10 ${textOnlyPadding} max-w-3xl`}>
          {/* Grid motif */}
          <div
            class="absolute inset-0 pointer-events-none"
            aria-hidden="true"
            style="background-image: linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 48px 48px;"
          />

          {breadcrumbs && breadcrumbs.length > 0 && (
            <nav
              class="flex items-center gap-1.5 mb-4 text-xs text-white/60 font-body relative"
              aria-label="Breadcrumb"
            >
              {breadcrumbs.map((crumb, i) => (
                <>
                  {i > 0 && (
                    <span aria-hidden="true" class="text-white/30">
                      ›
                    </span>
                  )}
                  {crumb.href ? (
                    <a
                      href={crumb.href}
                      class="hover:text-white/80 transition-colors duration-fast no-underline"
                    >
                      {crumb.label}
                    </a>
                  ) : (
                    <span>{crumb.label}</span>
                  )}
                </>
              ))}
            </nav>
          )}

          {badge && (
            <span class="inline-block mb-4 px-2 py-0.5 text-xs font-mono text-accent border border-accent/30 tracking-[0.04em] relative self-start">
              {badge}
            </span>
          )}

          <div class="w-10 h-0.5 bg-accent mb-5 relative" aria-hidden="true" />

          <EditableText
            as="h1"
            entry={cmsTitleField ? cmsEntry : undefined}
            field={cmsTitleField || 'title'}
            class="font-heading font-bold text-white leading-tight mb-5 relative"
            style="font-size: var(--font-size-display); letter-spacing: -0.02em; text-wrap: balance;"
            reveal
          >
            {title}
          </EditableText>

          {subtitle && (
            <EditableText
              as="p"
              entry={cmsSubtitleField ? cmsEntry : undefined}
              field={cmsSubtitleField || 'subtitle'}
              class="text-white/70 max-w-xl relative"
              style="font-size: var(--font-size-lead); line-height: 1.7; --reveal-delay: 0.1s;"
              type="textarea"
              reveal
            >
              {subtitle}
            </EditableText>
          )}

          <slot />
        </div>
      </Container>
    )
  }

  {/* ── Bottom gradient fade ── */}
  <div
    class="absolute bottom-0 left-0 right-0 h-16 pointer-events-none z-20"
    style="background: linear-gradient(to top, rgba(15,36,51,0.5), transparent);"
    aria-hidden="true"
  >
  </div>
</section>

<style>
  [data-hero-video-poster] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-video] {
      display: none;
    }

    [data-hero-video-poster] {
      display: block;
    }

    [data-hero-video-control] {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-hero-video-control]').forEach((button) => {
    const video = button
      .closest('div[data-reveal-cinematic]')
      ?.querySelector<HTMLVideoElement>('video');
    const label = button.querySelector<HTMLElement>('[data-video-control-label]');
    const pauseIcon = button.querySelector<SVGElement>('[data-video-pause-icon]');
    const playIcon = button.querySelector<SVGElement>('[data-video-play-icon]');
    if (!video || !label || !pauseIcon || !playIcon) return;

    const setPaused = (paused: boolean) => {
      const nextLabel = paused
        ? button.dataset.labelReproducir || 'Reproducir video'
        : button.dataset.labelPausar || 'Pausar video';
      label.textContent = nextLabel;
      button.setAttribute('aria-label', nextLabel);
      pauseIcon.classList.toggle('hidden', paused);
      playIcon.classList.toggle('hidden', !paused);
    };

    button.addEventListener('click', () => {
      if (video.paused) {
        void video.play().catch(() => setPaused(true));
      } else {
        video.pause();
      }
    });

    video.addEventListener('play', () => setPaused(false));
    video.addEventListener('pause', () => setPaused(true));
    setPaused(video.paused);
  });
</script>
