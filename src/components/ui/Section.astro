---
interface Props {
  variant?: 'default' | 'alt' | 'strong';
  padding?: 'normal' | 'tight' | 'hero';
  id?: string;
  class?: string;
  as?: 'section' | 'div' | 'article';
  divider?: boolean;
}

const {
  variant,
  padding,
  id,
  class: className = '',
  as: Tag = 'section',
  divider = false,
} = Astro.props as Props;

function getVariantClass(v: string | undefined) {
  if (v === 'alt') return 'bg-background-alt';
  if (v === 'strong') return 'bg-background-strong text-white';
  return 'bg-background';
}

function getPaddingClass(p: string | undefined) {
  if (p === 'tight') return 'py-12 md:py-16';
  if (p === 'hero') return 'py-20 md:py-32';
  return 'py-16 md:py-20';
}
---

{divider && <hr class="section-divider" aria-hidden="true" />}
<Tag
  id={id}
  class={`${getVariantClass(variant)} ${getPaddingClass(padding)} ${className}`}
>
  <slot />
</Tag>

