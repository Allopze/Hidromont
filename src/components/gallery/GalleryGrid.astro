---
/**
 * GalleryGrid — Uniform responsive grid.
 *
 * Every cell is the same size (1×1) so the grid tiles cleanly with no
 * internal gaps or asymmetric whitespace regardless of item count.
 */
import type { GalleryItemData } from '../../data/gallery';

interface Props {
  items: GalleryItemData[];
}

const { items } = Astro.props;

// Compute initial reveal delay for stagger (per item, capped at 8th)
function getRevealDelay(index: number): string {
  const delay = Math.min(index, 7) * 0.06;
  return `${delay}s`;
}
---

<div
  class="gallery-grid"
  data-reveal-group
>
  {items.map((item, index) => (
    <button
      type="button"
      class="gallery-card group relative overflow-hidden border border-border/20 transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 min-h-0"
      data-category={item.categorySlug ?? 'otros'}
      data-item-id={item.id}
      aria-label={`${item.title}${item.categoryName ? ` — ${item.categoryName}` : ''}`}
      style={`--reveal-delay:${getRevealDelay(index)}`}
    >
      {/* Responsive image with LQIP placeholder */}
      <div class="w-full h-full overflow-hidden relative">
        {/* LQIP blur-up background */}
        <div
          class="absolute inset-0 bg-cover bg-center blur-lg scale-110 transition-opacity duration-500"
          style={`background-image:url('${item.lqip}');`}
          aria-hidden="true"
          data-lqip
        />
        <img
          src={item.src}
          srcset={item.srcset}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
          alt={item.alt}
          width={item.width}
          height={item.height}
          loading={index < 3 ? 'eager' : 'lazy'}
          fetchpriority={index < 3 ? 'high' : 'auto'}
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04] relative z-10"
          style={`object-position: ${item.focalX * 100}% ${item.focalY * 100}%`}
          onload="this.previousElementSibling.style.opacity='0'"
        />
      </div>

      {/* Persistent caption scrim — always visible, not just on hover */}
      <div class="absolute inset-0 z-20 flex flex-col justify-end pointer-events-none">
        {/* Scrim gradient — strong bottom 50% for guaranteed text legibility */}
        <div class="absolute inset-x-0 bottom-0 h-[55%] bg-gradient-to-t from-black/90 via-black/60 to-transparent transition-all duration-300 group-hover:from-black/95 group-hover:via-black/70" />

        {/* Caption content */}
        <div class="relative z-10 p-3 md:p-4 text-white transition-transform duration-300 ease-out group-hover:-translate-y-1">
          {item.categoryName && (
            <span class="block text-[10px] md:text-[11px] text-white/80 font-semibold uppercase tracking-wider mb-1 font-mono">
              {item.categoryName}
            </span>
          )}
          <h3 class="text-white text-sm md:text-base font-bold font-heading uppercase leading-tight tracking-wide [text-shadow:0_1px_3px_rgba(0,0,0,0.6)]">
            {item.title}
          </h3>
          {/* "Ver en detalle" — visible on hover, focus, AND touch (hover media query) */}
          <span class="block text-[10px] md:text-xs text-white/70 mt-1.5 opacity-0 translate-y-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-y-0 group-focus-visible:opacity-100 group-focus-visible:translate-y-0 hover-text-visible">
            Ver en detalle →
          </span>
        </div>
      </div>
    </button>
  ))}
</div>

<style>
  /* ── Uniform responsive grid ──────────────────────────────────
     Equal columns + fixed auto-rows → every cell is identical, so
     the grid tiles edge to edge with no internal gaps. Only the
     final row may be short, which reads as intentional.
  ─────────────────────────────────────────────────────────────── */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    grid-auto-rows: clamp(200px, 56vw, 300px);
    align-items: stretch;
    gap: clamp(10px, 1.4vw, 18px);
  }
  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: clamp(180px, 26vw, 240px);
    }
  }
  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: clamp(200px, 18vw, 260px);
    }
  }

  .gallery-card {
    background: var(--color-background-alt);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    /* Cell must fill its grid track for img h-full to work */
    align-self: stretch;
  }
  .gallery-card:hover {
    box-shadow: var(--shadow-md);
    border-color: rgba(0, 166, 214, 0.4);
  }
  .gallery-card:active {
    transform: scale(0.98);
    transition-duration: 100ms;
  }

  /* Accessible focus ring */
  .gallery-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Touch devices: always show "Ver en detalle" ────────
     On touch/hover-capable devices, the CTA is always visible
     since there's no hover state. Uses @media (hover:hover)
     to only hide on devices that support hover.
  ──────────────────────────────────────────────────────── */
  @media (hover: none) {
    .hover-text-visible {
      opacity: 1 !important;
      transform: translateY(0) !important;
    }
  }
</style>
