---
/**
 * ProjectAlbumCard — Album Card Component for Project-based Gallery.
 *
 * Displays a project album cover card with category badge, project title,
 * photo count pill, and LQIP blur-up image.
 */
import type { ProjectAlbumData } from '../../data/gallery';

interface Props {
  album: ProjectAlbumData;
  index: number;
}

const { album, index } = Astro.props;
const { coverImage } = album;

function getRevealDelay(idx: number): string {
  const delay = Math.min(idx, 7) * 0.06;
  return `${delay}s`;
}

// GAL-14: la búsqueda miraba solo el nombre del álbum, así que "compuerta" no
// encontraba C.H. San Pedro pese a sus 12 fotos de compuertas. Este índice
// añade las categorías y el alt de cada foto — el alt es lo único que describe
// la pieza ahora que las fotos no llevan título ni descripción.
const searchIndex = [
  album.projectName,
  ...album.categoryNames,
  ...album.items.map((item) => item.alt),
]
  .join(' ')
  .toLowerCase();
---

<button
  type="button"
  class="project-album-card group relative overflow-hidden border border-border/20 transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 min-h-0 w-full text-left bg-background-alt"
  data-category={album.categorySlug ?? 'otros'}
  data-categories={(album.categorySlugs.length ? album.categorySlugs : ['otros']).join(' ')}
  data-project-slug={album.projectSlug}
  data-project-name={album.projectName}
  data-search={searchIndex}
  aria-label={`Álbum ${album.projectName} — ${album.itemCount} ${album.itemCount === 1 ? 'foto' : 'fotos'}`}
  style={`--reveal-delay:${getRevealDelay(index)}`}
  data-reveal
>
  {/* Image container with LQIP */}
  <div class="w-full h-[260px] md:h-[300px] overflow-hidden relative">
    {/* LQIP blur-up background */}
    <div
      class="absolute inset-0 bg-cover bg-center blur-lg scale-110 transition-opacity duration-500"
      style={`background-image:url('${coverImage.lqip}');`}
      aria-hidden="true"
    >
    </div>
    <img
      src={coverImage.src}
      srcset={coverImage.srcset}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      alt={coverImage.alt}
      width={coverImage.width}
      height={coverImage.height}
      loading={index < 3 ? 'eager' : 'lazy'}
      fetchpriority={index < 3 ? 'high' : 'auto'}
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04] relative z-10"
      style={`object-position: ${coverImage.focalX * 100}% ${coverImage.focalY * 100}%`}
      data-lqip-fade
    />
  </div>

  {/* Top Badge: Photo Count Pill */}
  <div class="absolute top-3 right-3 z-30 pointer-events-none">
    <span
      class="inline-flex items-center gap-1 px-2.5 py-1 text-[10px] md:text-xs font-mono font-bold uppercase tracking-wider text-white bg-black/75 backdrop-blur-md border border-white/20 shadow-lg"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="w-3.5 h-3.5 text-accent"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
        ></path>
      </svg>
      {album.itemCount}
      {album.itemCount === 1 ? 'foto' : 'fotos'}
    </span>
  </div>

  {/* Persistent Scrim & Project Metadata */}
  <div class="absolute inset-0 z-20 flex flex-col justify-end pointer-events-none">
    {/* Scrim gradient */}
    <div
      class="absolute inset-x-0 bottom-0 h-[35%] bg-gradient-to-t from-black/85 via-black/45 to-transparent transition-all duration-300 group-hover:from-black"
    >
    </div>

    {
      /* IMPORTANTE: NO VOLVER A MOSTRAR el nombre del proyecto ni el rótulo de
         categoría sobre la tarjeta (revirtió GAL-15). Solicitud expresa del
         usuario: la tarjeta va solo con la foto. Nombre y categorías siguen en
         data-* / aria-label para filtros, búsqueda y accesibilidad. */
    }
    <div
      class="relative z-10 p-4 md:p-5 text-white transition-transform duration-300 ease-out group-hover:-translate-y-1"
    >
      {/* Action Prompt — el conteo de fotos ya lo lleva la píldora superior. */}
      <div
        class="flex justify-end items-center text-[10px] md:text-xs text-white/80 font-mono uppercase tracking-wider"
      >
        <span class="text-accent group-hover:translate-x-1 transition-transform duration-200">
          Ver álbum →
        </span>
      </div>
    </div>
  </div>
</button>

<style>
  .project-album-card {
    box-shadow: var(--shadow-sm);
    transition:
      opacity 200ms ease-out,
      transform 200ms ease-out,
      border-color 150ms ease,
      box-shadow 150ms ease;
  }
  .project-album-card:hover {
    box-shadow: var(--shadow-md);
    border-color: rgba(0, 166, 214, 0.5);
  }
  .project-album-card:active {
    transform: scale(0.98);
  }
</style>

<script>
  // JS-10 fix: `load` doesn't bubble, so this listens in the capture phase on
  // the document (one listener regardless of how many cards render) rather
  // than an inline onload= handler. Inline handlers fall under script-src,
  // and CSP L3 ignores 'unsafe-inline' once a script hash is present (see
  // public/_headers), so onload= was silently dead in production — the LQIP
  // blur-up placeholder never faded out.
  document.addEventListener(
    'load',
    (e) => {
      const img = e.target;
      if (img instanceof HTMLImageElement && img.hasAttribute('data-lqip-fade')) {
        const placeholder = img.previousElementSibling;
        if (placeholder instanceof HTMLElement) placeholder.style.opacity = '0';
      }
    },
    true
  );
</script>
