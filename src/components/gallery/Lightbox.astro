---
/**
 * Lightbox — Premium accessible image viewer.
 *
 * Features:
 * - Focus trap: moves focus into dialog on open, restores on close
 * - Background inert: aria-hidden + pointer-events:none on main content
 * - Keyboard: Escape closes, ArrowLeft/Right navigate, Tab cycles within
 * - Preloads neighbor images for instant nav
 * - Cross-fade with blur transition (Emil's technique for imperfect transitions)
 * - Skeleton/spinner while loading
 * - Respects prefers-reduced-motion
 */

// No props needed — data is embedded in gallery cards via data attributes
import { getCmsText } from '../../data/cms';
import EditableText from '../cms/EditableText.astro';

// Lo que leen los lectores de pantalla (Textos del sitio → Textos para
// lectores de pantalla) y el enlace visible al proyecto (Páginas → Galería).
const a11y = {
  nombre: getCmsText('site.accesibilidad', 'visorNombre', 'Visor de imágenes de galería'),
  cerrar: getCmsText('site.accesibilidad', 'visorCerrar', 'Cerrar visor (Escape)'),
  anterior: getCmsText('site.accesibilidad', 'visorAnterior', 'Imagen anterior (←)'),
  siguiente: getCmsText('site.accesibilidad', 'visorSiguiente', 'Siguiente imagen (→)'),
};
---

{
  /* GAL-27: z-overlay (100) en vez de z-50. El <header> sticky también está en
     z-50 y el visor solo ganaba por venir después en el DOM — un empate que se
     rompía solo con reordenar el markup. */
}
<div
  id="lightbox"
  class="fixed inset-0 z-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-label={a11y.nombre}
  tabindex="-1"
>
  {
    /* Backdrop. B-3: este componente era el único del sitio público que pintaba
      con la paleta por defecto de Tailwind (`neutral-*`) en vez de la del
      proyecto, así que un cambio de marca lo habría dejado con los grises
      viejos. El fondo usa el azul oscuro de `background-strong`, y las chapas
      de los botones el `white/10` que ya usaba el botón de cerrar. */
  }
  <div
    class="absolute inset-0 bg-background-strong/95 backdrop-blur-sm"
    data-lb-backdrop
    aria-hidden="true"
  >
  </div>

  {/* Content container */}
  <div class="relative z-10 flex flex-col h-full select-none">
    {/* Top bar */}
    <div class="flex justify-between items-center px-4 md:px-6 py-3 shrink-0">
      <div
        class="text-xs md:text-sm font-semibold uppercase tracking-wider text-white/70 font-mono"
        data-lb-counter
      >
      </div>
      <button
        type="button"
        class="p-2.5 hover:bg-white/10 text-white transition-colors duration-150 ease-out border border-transparent rounded-none cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        data-lb-close
        aria-label={a11y.cerrar}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-7 h-7"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    {/* Image area with navigation arrows */}
    <div
      class="relative flex items-center justify-center flex-grow min-h-0 px-4 md:px-16"
      data-lb-stage
    >
      {/* Prev */}
      <button
        type="button"
        class="absolute left-2 md:left-6 z-20 p-3 bg-white/10 hover:bg-white/20 text-white transition-all duration-150 ease-out border border-white/10 hover:border-white/20 rounded-none cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        data-lb-prev
        aria-label={a11y.anterior}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-5 h-5 md:w-6 md:h-6"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"
          ></path>
        </svg>
      </button>

      {/* Image container with loading skeleton */}
      <div class="w-full h-full flex items-center justify-center min-h-0" data-lb-img-wrap>
        {/* Loading skeleton */}
        <div data-lb-skeleton class="absolute inset-0 flex items-center justify-center">
          <div class="w-8 h-8 border-2 border-white/20 border-t-accent rounded-full animate-spin">
          </div>
        </div>
        {
          /* GAL-17: `max-h` en vh fijos (72/78) no descontaba la barra superior
             ni el panel de metadatos, así que la suma pasaba de 100vh y el
             panel quedaba pegado al borde inferior (medido: metaBottom ===
             innerHeight en 1440×800 y 390×844) con el CTA cortado. Con
             `max-h-full` la imagen se limita a lo que el contenedor flex le
             deja tras reservar barra y panel, que es lo que debía hacer. */
        }
        <img
          data-lb-img
          alt=""
          class="max-w-full max-h-full object-contain shadow-2xl transition-all duration-300 ease-out opacity-0 scale-[0.97]"
          draggable="false"
        />
      </div>

      {/* Next */}
      <button
        type="button"
        class="absolute right-2 md:right-6 z-20 p-3 bg-white/10 hover:bg-white/20 text-white transition-all duration-150 ease-out border border-white/10 hover:border-white/20 rounded-none cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        data-lb-next
        aria-label={a11y.siguiente}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-5 h-5 md:w-6 md:h-6"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
        </svg>
      </button>
    </div>

    {/* Bottom metadata panel */}
    <div
      class="shrink-0 text-center px-4 md:px-6 py-4 md:py-5 max-w-3xl mx-auto w-full lb-meta"
      data-lb-meta
    >
      {
        /* GAL-18: los cambios de foto eran silenciosos para lectores de pantalla
           — el contador se actualizaba sin anunciarse. */
      }
      <p class="sr-only" aria-live="polite" data-lb-announce></p>
      <span
        data-lb-category
        class="block text-[10px] md:text-xs text-accent font-semibold tracking-wider uppercase font-mono"
      ></span>
      {
        /* eslint-disable jsx-a11y/anchor-is-valid -- showImage() sets a real href before this is ever shown (see ESTRUCT-2) */
      }
      <a
        data-lb-project-link
        href="#"
        class="inline-flex items-center gap-1.5 mt-3 text-xs md:text-sm font-semibold text-accent hover:text-white transition-colors duration-150 font-mono uppercase tracking-wider hidden group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <EditableText entry="page.galeria" field="enlaceProyecto">
          {getCmsText('page.galeria', 'enlaceProyecto', 'Ver Proyecto Relacionado')}
        </EditableText>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-4 h-4 transition-transform group-hover:translate-x-1"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  (() => {
    const lightbox = document.getElementById('lightbox');
    if (!lightbox) return;

    const img = lightbox.querySelector('[data-lb-img]') as HTMLImageElement;
    const skeleton = lightbox.querySelector('[data-lb-skeleton]') as HTMLElement;
    const counter = lightbox.querySelector('[data-lb-counter]') as HTMLElement;
    const category = lightbox.querySelector('[data-lb-category]') as HTMLElement;
    const projectLink = lightbox.querySelector('[data-lb-project-link]') as HTMLAnchorElement;
    const closeBtn = lightbox.querySelector('[data-lb-close]') as HTMLButtonElement;
    const prevBtn = lightbox.querySelector('[data-lb-prev]') as HTMLButtonElement;
    const nextBtn = lightbox.querySelector('[data-lb-next]') as HTMLButtonElement;

    const announcer = lightbox.querySelector('[data-lb-announce]') as HTMLElement | null;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /**
     * GAL-17: el trap usaba `querySelectorAll('button, [tabindex]')`, que no
     * matchea el `<a>` del CTA "Ver Proyecto Relacionado". Como el CTA es el
     * último elemento tabulable del diálogo pero no estaba en la lista, al
     * llegar al botón "siguiente" —el último que sí estaba— el Tab saltaba de
     * vuelta al primero y el enlace nunca recibía foco.
     *
     * Se filtran además los ocultos: el CTA lleva `hidden` cuando el álbum no
     * tiene página de proyecto, y un trap que enfoca elementos invisibles deja
     * al usuario sin saber dónde está el foco.
     */
    function getFocusable(): HTMLElement[] {
      const candidates = lightbox!.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );
      return Array.from(candidates).filter(
        (el) => !el.classList.contains('hidden') && el.offsetParent !== null
      );
    }

    interface LightboxImage {
      id?: string;
      src: string;
      srcset: string;
      alt: string;
      category: string;
      projectSlug: string;
      width: number;
      height: number;
    }

    // Lo que llega en el <script type="application/json"> viene de gallery.json,
    // pero al parsearlo no hay garantía de tipo: por eso todo es opcional aquí y
    // cada campo lleva su fallback en collectImages().
    interface RawLightboxItem {
      id?: string;
      src?: string;
      srcset?: string;
      alt?: string;
      categoryName?: string;
      projectSlug?: string;
      width?: number;
      height?: number;
    }

    let images: LightboxImage[] = [];
    let currentIndex = 0;
    let previousFocus: HTMLElement | null = null;

    // ── GAL-16: estado del visor en la URL ──
    //
    // Sin esto no se podía compartir una foto, y —lo más visible en móvil— el
    // botón Atrás salía de la página en vez de cerrar el visor, que es el
    // gesto que cualquiera intenta primero.
    //
    // Se usa un query param y no el hash porque el hash ya está tomado por el
    // deep-link de categoría de la grilla (/galeria#tuberias).
    //
    // `pushState` solo al abrir: así Atrás cierra el visor y devuelve a la
    // grilla. Navegar entre fotos usa `replaceState` para no dejar 15 entradas
    // de historial que obliguen a pulsar Atrás quince veces para salir.
    let ownsHistoryEntry = false;
    /** Evita que popstate, al deshacer nuestra propia entrada, reabra el visor. */
    let suppressUrlSync = false;

    function syncUrl() {
      if (suppressUrlSync || !ownsHistoryEntry) return;
      const url = new URL(location.href);
      url.searchParams.set('foto', String(currentIndex + 1));
      history.replaceState(history.state, '', url);
    }

    function pushOpenState() {
      const url = new URL(location.href);
      url.searchParams.set('foto', String(currentIndex + 1));
      history.pushState({ lightbox: true }, '', url);
      ownsHistoryEntry = true;
    }

    function clearUrlState() {
      if (!ownsHistoryEntry) return;
      ownsHistoryEntry = false;
      suppressUrlSync = true;
      history.back();
      // El flag se limpia en el popstate que provoca este history.back().
    }

    // ESTRUCT-2 fix: only link "Ver Proyecto" to slugs that actually have a
    // built page (see the "lightbox-valid-project-slugs" payload). Gallery
    // items can carry a projectSlug used purely for album grouping that has
    // no detail page — linking to those would 404.
    function parseValidProjectSlugs(): Set<string> {
      const el = document.getElementById('lightbox-valid-project-slugs');
      if (!el?.textContent) return new Set();
      try {
        const slugs = JSON.parse(el.textContent);
        return new Set(Array.isArray(slugs) ? slugs : []);
      } catch (e) {
        console.error('Error al parsear los slugs de proyecto válidos', e);
        return new Set();
      }
    }

    const validProjectSlugs = parseValidProjectSlugs();

    // ── Background inert handling ──
    // JS-1 fix: target only <header>/<main> (siblings of this lightbox once it's
    // rendered in PageLayout's "overlay" slot) — never an ancestor of the modal
    // itself, or the modal would disable its own buttons.
    function getInertTargets(): HTMLElement[] {
      const targets = [
        document.querySelector('header'),
        document.querySelector('main') || document.getElementById('page-content'),
      ];
      return targets.filter((el): el is HTMLElement => el !== null);
    }

    function setBackgroundInert(inert: boolean) {
      for (const el of getInertTargets()) {
        if (inert) {
          el.setAttribute('aria-hidden', 'true');
          el.setAttribute('inert', '');
        } else {
          el.removeAttribute('aria-hidden');
          el.removeAttribute('inert');
        }
      }
      document.body.classList.toggle('overflow-hidden', inert);
    }

    // ── Pending close-transition bookkeeping ──
    // JS-2 fix: the interactive cleanup (inert/aria-hidden/focus) happens
    // synchronously in close(); only the visual fade rides the transition, with
    // a timeout fallback in case transitionend never fires (double-close,
    // opacity already at 0, backgrounded tab, or a future CSS change).
    let pendingCloseTimer: ReturnType<typeof setTimeout> | null = null;
    let pendingCloseHandler: (() => void) | null = null;

    function cancelPendingClose() {
      if (pendingCloseTimer !== null) {
        clearTimeout(pendingCloseTimer);
        pendingCloseTimer = null;
      }
      if (pendingCloseHandler) {
        lightbox!.removeEventListener('transitionend', pendingCloseHandler);
        pendingCloseHandler = null;
      }
    }

    // Collect all gallery images from JSON script tag or DOM fallback
    function collectImages(): LightboxImage[] {
      const dataScript = document.getElementById('lightbox-data');
      if (dataScript && dataScript.textContent) {
        try {
          const rawItems: RawLightboxItem[] = JSON.parse(dataScript.textContent);
          // M-9: la lista vacía no es una respuesta, es un bloque que todavía
          // no ha rellenado la página. Se cae al DOM, que siempre tiene al
          // menos las tarjetas ya renderizadas.
          if (!rawItems.length) throw new Error('lista vacía');
          return rawItems.map((item) => ({
            id: item.id || '',
            src: item.src || '',
            srcset: item.srcset || '',
            alt: item.alt || '',
            category: item.categoryName || '',
            projectSlug: item.projectSlug || '',
            width: item.width || 1600,
            height: item.height || 1200,
          }));
        } catch (e) {
          console.error('Error al parsear JSON de datos de galería', e);
        }
      }

      const cards = document.querySelectorAll('.gallery-card');
      return Array.from(cards).map((card) => {
        const el = card as HTMLElement;
        const imgEl = el.querySelector('img') as HTMLImageElement;
        const attrWidth = Number.parseInt(imgEl?.getAttribute('width') || '', 10);
        const attrHeight = Number.parseInt(imgEl?.getAttribute('height') || '', 10);
        return {
          id: el.getAttribute('data-item-id') || '',
          src: imgEl?.src || '',
          srcset: imgEl?.getAttribute('srcset') || '',
          alt: imgEl?.alt || el.getAttribute('aria-label') || '',
          category: el.querySelector('.font-mono')?.textContent?.trim() || '',
          projectSlug: el.getAttribute('data-project-slug') || '',
          width:
            Number.isFinite(attrWidth) && attrWidth > 0 ? attrWidth : imgEl?.naturalWidth || 1600,
          height:
            Number.isFinite(attrHeight) && attrHeight > 0
              ? attrHeight
              : imgEl?.naturalHeight || 1200,
        };
      });
    }

    function showImage(index: number) {
      if (index < 0 || index >= images.length) return;
      currentIndex = index;
      const data = images[index];

      // Show skeleton, fade out current image
      skeleton.style.display = 'flex';
      img.style.opacity = '0';
      if (!prefersReducedMotion) {
        img.style.transform = 'scale(0.97)';
      }

      // Update metadata immediately
      counter.textContent = `${index + 1} / ${images.length}`;
      category.textContent = data.category;
      // GAL-18: el contador cambiaba en silencio para lectores de pantalla.
      // `aria-live="polite"` no se dispara si el nodo ya contenía ese texto, por
      // eso se compone una frase que siempre incluye la posición. Ahora que las
      // fotos no llevan título, el alt es lo único que identifica la imagen.
      if (announcer) announcer.textContent = `Foto ${index + 1} de ${images.length}: ${data.alt}`;
      syncUrl();

      if (data.projectSlug && validProjectSlugs.has(data.projectSlug) && projectLink) {
        projectLink.href = `/proyectos/${data.projectSlug}`;
        projectLink.classList.remove('hidden');
      } else if (projectLink) {
        projectLink.classList.add('hidden');
      }

      // Load new image
      const tempImg = new Image();
      tempImg.onload = () => {
        img.src = data.src;
        if (data.srcset) img.srcset = data.srcset;
        img.alt = data.alt;
        img.width = data.width;
        img.height = data.height;
        skeleton.style.display = 'none';

        // Animate in (Emil: use ease-out for entering elements)
        requestAnimationFrame(() => {
          img.style.opacity = '1';
          if (!prefersReducedMotion) {
            img.style.transform = 'scale(1)';
          }
        });
      };
      tempImg.onerror = () => {
        skeleton.style.display = 'none';
        img.style.opacity = '1';
        if (!prefersReducedMotion) img.style.transform = 'scale(1)';
      };
      tempImg.src = data.src;

      // Preload neighbors
      preloadNeighbor(index - 1);
      preloadNeighbor(index + 1);
    }

    function preloadNeighbor(index: number) {
      if (index < 0 || index >= images.length) return;
      const neighbor = new Image();
      neighbor.src = images[index].src;
      if (images[index].srcset) neighbor.srcset = images[index].srcset;
    }

    function open(cardElement: HTMLElement) {
      images = collectImages();
      const cardId = cardElement.getAttribute('data-item-id');
      const cardImg = cardElement.querySelector('img');
      const src = cardImg?.src;

      // Find by id first, then by src
      currentIndex = cardId
        ? images.findIndex((i) => i.id === cardId)
        : images.findIndex(
            (i) => i.src === src || (cardImg && i.srcset === cardImg.getAttribute('srcset'))
          );

      if (currentIndex === -1) currentIndex = 0;

      // A previous close() may still have a pending transitionend/timeout in
      // flight if the user reopens quickly; cancel it so it can't fire late.
      cancelPendingClose();

      // Save focus to restore on close
      previousFocus = document.activeElement as HTMLElement;

      setBackgroundInert(true);

      lightbox!.classList.remove('hidden');
      lightbox!.classList.add('is-animating');
      // Force reflow before removing opacity
      lightbox!.offsetHeight;
      lightbox!.style.opacity = '1';

      pushOpenState();
      showImage(currentIndex);

      // Move focus into dialog
      requestAnimationFrame(() => closeBtn.focus());
    }

    /**
     * @param fromHistory true cuando el cierre lo originó un popstate (Atrás
     *   del navegador). En ese caso la entrada de historial ya se consumió y
     *   llamar a history.back() otra vez sacaría al usuario de la página.
     */
    function close(fromHistory = false) {
      // Cancel any close already in flight (double-close) before starting a new one.
      cancelPendingClose();

      // JS-2 fix: the interactive cleanup happens synchronously and
      // unconditionally — it must never depend on a transitionend firing.
      setBackgroundInert(false);
      if (previousFocus) {
        previousFocus.focus();
        previousFocus = null;
      }

      if (fromHistory) ownsHistoryEntry = false;
      else clearUrlState();

      lightbox!.classList.add('is-animating');
      lightbox!.style.opacity = '0';

      const finishFade = () => {
        cancelPendingClose();
        lightbox!.classList.add('hidden');
        lightbox!.classList.remove('is-animating');
      };

      if (prefersReducedMotion) {
        finishFade();
        return;
      }

      pendingCloseHandler = finishFade;
      lightbox!.addEventListener('transitionend', pendingCloseHandler);
      // Fallback in case transitionend never fires (opacity already at 0,
      // backgrounded tab, or a future CSS change removing the transition).
      pendingCloseTimer = setTimeout(finishFade, 300);
    }

    function prev() {
      if (images.length <= 1) return;
      showImage((currentIndex - 1 + images.length) % images.length);
    }

    function next() {
      if (images.length <= 1) return;
      showImage((currentIndex + 1) % images.length);
    }

    // ── Event delegation: click on gallery cards ──
    document.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement)?.closest?.('.gallery-card') as HTMLElement;
      if (card) {
        e.preventDefault();
        open(card);
      }
    });

    // ── Lightbox button handlers ──
    // Envueltos en flechas: pasar `close` directo le entregaría el MouseEvent
    // como argumento `fromHistory`, que es truthy y saltaría el history.back().
    closeBtn?.addEventListener('click', () => close());
    prevBtn?.addEventListener('click', prev);
    nextBtn?.addEventListener('click', next);

    // Close on backdrop click
    lightbox.querySelector('[data-lb-backdrop]')?.addEventListener('click', () => close());
    lightbox.querySelector('[data-lb-stage]')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) close();
    });

    // ── GAL-16: historial y deep-link ──
    window.addEventListener('popstate', () => {
      if (suppressUrlSync) {
        // Es el popstate que provocó nuestro propio history.back() al cerrar.
        suppressUrlSync = false;
        return;
      }
      const isOpen = !lightbox!.classList.contains('hidden');
      const params = new URLSearchParams(location.search);
      const wantsOpen = params.has('foto');

      if (isOpen && !wantsOpen) {
        close(true);
      } else if (!isOpen && wantsOpen) {
        openFromUrl(params);
      } else if (isOpen && wantsOpen) {
        const index = Number.parseInt(params.get('foto') ?? '1', 10) - 1;
        if (Number.isFinite(index) && index >= 0 && index < images.length) showImage(index);
      }
    });

    function openFromUrl(params: URLSearchParams): boolean {
      const foto = Number.parseInt(params.get('foto') ?? '', 10);
      if (!Number.isFinite(foto) || foto < 1) return false;

      const first = document.querySelector('.gallery-card') as HTMLElement | null;
      if (!first) return false;
      open(first);

      const index = foto - 1;
      if (index < images.length) showImage(index);
      return true;
    }

    // Apertura directa desde una URL compartida. Reemplaza la entrada que
    // open() empuja, para que Atrás lleve a la página anterior y no a la
    // misma URL con el visor cerrado.
    const initialParams = new URLSearchParams(location.search);
    if (initialParams.has('foto')) {
      requestAnimationFrame(() => {
        const opened = openFromUrl(initialParams);
        if (!opened) {
          const url = new URL(location.href);
          url.searchParams.delete('foto');
          history.replaceState(null, '', url);
        }
      });
    }

    // ── Keyboard ──
    document.addEventListener('keydown', (e) => {
      if (lightbox!.classList.contains('hidden')) return;
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key === 'ArrowLeft') {
        prev();
        return;
      }
      if (e.key === 'ArrowRight') {
        next();
        return;
      }

      // Focus trap: Tab cycles within lightbox
      if (e.key === 'Tab') {
        const focusable = getFocusable();
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // ── Touch swipe support ──
    let touchStartX = 0;
    let touchStartTime = 0;

    lightbox.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartTime = Date.now();
      },
      { passive: true }
    );

    lightbox.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dt = Date.now() - touchStartTime;
        // JS-L5 fix: a very fast flick could make `dt` 0, and `velocity`
        // would be Infinity — always triggering navigation regardless of
        // actual distance (including on what was really just a tap). Guard
        // dt>0 and require a minimum distance before considering it a swipe.
        const velocity = dt > 0 ? Math.abs(dx) / dt : 0;
        const MIN_SWIPE_DISTANCE = 30;

        // Emil: momentum-based dismissal — velocity > 0.11 regardless of distance
        if (Math.abs(dx) > MIN_SWIPE_DISTANCE && (velocity > 0.11 || Math.abs(dx) > 80)) {
          if (dx > 0) prev();
          else next();
        }
      },
      { passive: true }
    );
  })();
</script>

<style>
  #lightbox {
    opacity: 0;
    transition: opacity 250ms ease-out;
  }

  /* GAL-27: `will-change: opacity` permanente mantenía viva una capa de
     composición durante toda la vida de la página, incluso con el visor
     cerrado. Solo se declara mientras hay una transición en curso. */
  #lightbox.is-animating {
    will-change: opacity;
  }

  /* GAL-17: el panel nunca debe quedar contra el borde inferior de la
     pantalla — en iPhone, además, ahí vive la barra de gestos. */
  .lb-meta {
    padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
  }
  /* A2-008: el soporte reduced-motion real se maneja en JS (prefersReducedMotion al
     abrir/cerrar). El atributo data-reduced-motion nunca se setea, asi que esta regla
     era CSS muerto; eliminada. */
</style>
