---
import type { CollectionEntry } from 'astro:content';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';

import { projectImages } from '../../data/project-images';
import { categoriaLabels } from '../../data/categories';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { nombre, cliente, alcance, categoria, diametro, longitud, ubicacion } = proyecto.data;

const isDestacado = proyecto.data.tipo === 'destacado';

const slug = proyecto.id;
const photo = projectImages[slug];
---

<article class="group relative card-lift bg-surface border border-border rounded-none overflow-hidden flex flex-col hover:border-primary hover:shadow-md" data-reveal>
  <!-- Project photo (only for destacado projects that have a curated image) -->
  {isDestacado && photo && (
    <div class="relative overflow-hidden bg-background-alt" style="aspect-ratio: 16/9;">
      <img
        src={photo.src}
        alt={photo.alt}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-slow ease-standard group-hover:scale-[1.02]"
        width="640"
        height="360"
      />
    </div>
  )}

  <!-- Header band for destacado without photo -->
  {isDestacado && !photo && (
    <div class="bg-primary-light px-5 py-3 border-b border-border">
      <Badge variant="accent" class="text-[10px]">Caso Destacado</Badge>
    </div>
  )}

  <div class="p-6 flex flex-col flex-1 gap-4">
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <Badge variant="muted">{categoriaLabels[categoria] || categoria}</Badge>
      {cliente && <span class="text-xs text-text-muted font-body font-medium">{cliente}</span>}
    </div>

    <h3 class="font-heading font-bold text-text text-xl group-hover:text-primary transition-colors">
      {nombre}
    </h3>

    <p class="text-text-muted text-sm leading-relaxed line-clamp-3">
      {alcance}
    </p>

    {(ubicacion || diametro || longitud) && (
      <div class="pt-3 border-t border-border flex flex-wrap gap-x-4 gap-y-1 text-xs text-text-muted font-mono">
        {ubicacion && <span>📍 {ubicacion}</span>}
        {diametro && <span>⌀ {diametro}</span>}
        {longitud && <span>📏 {longitud}</span>}
      </div>
    )}

    {isDestacado && (
      <Button
        href={`/proyectos/${slug}`}
        variant="link"
        class="self-start mt-auto before:content-[''] before:absolute before:inset-0 before:rounded-none"
      >
        <span class="relative">Ver detalle</span>
        <ArrowIcon class="relative transition-transform group-hover:translate-x-0.5" />
      </Button>
    )}
  </div>
</article>
