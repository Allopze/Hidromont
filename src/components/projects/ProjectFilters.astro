---
interface FilterItem {
  label: string;
  href: string;
  id: string;
}

interface Props {
  items: FilterItem[];
  active?: string;
}

const { items, active } = Astro.props;
---

<nav aria-label="Filtrar proyectos por categoría" class="flex flex-wrap gap-2 mb-10">
  {items.map((item) => (
    <a
      href={item.href}
      class={`px-4 py-2 text-sm font-semibold font-body rounded-none no-underline transition-[background-color,color] duration-fast ease-standard focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary ${
        active === item.id
          ? 'bg-primary text-white'
          : 'bg-background-alt text-text hover:bg-primary-light hover:text-primary-dark'
      }`}
    >
      {item.label}
    </a>
  ))}
</nav>
