---
interface FilterItem {
  label: string;
  href: string;
  id: string;
}

interface Props {
  items: FilterItem[];
  active?: string;
}

const { items, active } = Astro.props;
---

<nav aria-label="Filtrar proyectos por categoría" class="flex flex-wrap gap-2 mb-10">
  {items.map((item) => (
    <a
      href={item.href}
      class={`px-4 py-2.5 text-sm font-semibold font-body min-h-[44px] inline-flex items-center rounded-none no-underline transition-[background-color,color] duration-fast ease-standard focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary ${
        active === item.id
          ? 'bg-primary text-white'
          : 'bg-background-alt text-text hover:bg-primary-light hover:text-primary-dark border border-border/50'
      }`}
    >
      {item.label}
    </a>
  ))}
</nav>
