---
import { normalizarBusqueda } from '../../utils/busqueda';
import type { CollectionEntry } from 'astro:content';
import { formatDiameters } from '../../utils/format';
import { entrySlug } from '../../utils/contentId';
import EditableText from '../cms/EditableText.astro';
import { getCmsText } from '../../data/cms';

interface Props {
  proyectos: CollectionEntry<'proyectos'>[];
  titulo: string;
  /** Código de la categoría: su nombre se edita pulsando el título. */
  categoria?: string;
}

const { proyectos, titulo, categoria } = Astro.props;
// Los proyectos del banco no tienen página propia: esta tabla es el único
// sitio donde se ven, así que es también donde se editan.
const fichaDe = (p: CollectionEntry<'proyectos'>) => `proyectos.${entrySlug(p.id)}`;
const columna = {
  proyecto: getCmsText('proyectos.index.banco', 'columnaProyecto', 'Proyecto'),
  alcance: getCmsText('proyectos.index.banco', 'columnaAlcance', 'Alcance'),
  cliente: getCmsText('proyectos.index.banco', 'columnaCliente', 'Cliente'),
};
const rotulo = {
  contratista: getCmsText('plantilla.proyecto', 'rotuloContratista', 'Contratista'),
  mandante: getCmsText('plantilla.proyecto', 'rotuloMandante', 'Mandante'),
  cliente: getCmsText('plantilla.proyecto', 'rotuloCliente', 'Cliente'),
};
// El índice se normaliza igual que lo que se muestra: si no, buscar "Ø 2.200"
// no encuentra una ficha que guarde "Ø2200", ni al revés.
const searchText = (project: CollectionEntry<'proyectos'>) =>
  [
    project.data.nombre,
    project.data.alcance,
    project.data.cliente,
    project.data.ubicacion,
    project.data.diametro,
    project.data.acero,
  ]
    .filter(Boolean)
    .map((field) => formatDiameters(String(field)))
    .map((field) => normalizarBusqueda(field))
    .join(' ');
---

{
  proyectos.length > 0 && (
    <div class="mb-14" data-reveal>
      {/* Section heading */}
      <div class="mb-5">
        <div class="w-10 h-0.5 bg-accent mb-3" aria-hidden="true" />
        <EditableText
          as="h3"
          entry={categoria ? 'proyectos.categorias' : undefined}
          field={categoria ?? ''}
          class="font-heading font-bold text-primary-dark"
          style="font-size: var(--font-size-h3);"
        >
          {titulo}
        </EditableText>
      </div>

      {/* Desktop/Tablet table */}
      <div class="hidden md:block overflow-x-auto border border-border">
        <table class="w-full text-sm" style="border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 2px solid var(--color-border);">
              <th class="text-left px-5 py-3 text-xs font-semibold text-text-muted tracking-[0.05em] uppercase whitespace-nowrap">
                <EditableText entry="proyectos.index.banco" field="columnaProyecto">
                  {columna.proyecto}
                </EditableText>
              </th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-text-muted tracking-[0.05em] uppercase">
                <EditableText entry="proyectos.index.banco" field="columnaAlcance">
                  {columna.alcance}
                </EditableText>
              </th>
              <th class="text-left px-5 py-3 text-xs font-semibold text-text-muted tracking-[0.05em] uppercase whitespace-nowrap">
                <EditableText entry="proyectos.index.banco" field="columnaCliente">
                  {columna.cliente}
                </EditableText>
              </th>
            </tr>
          </thead>
          <tbody>
            {proyectos.map((p, i) => (
              <tr
                class="bg-white"
                data-project-item
                data-project-key={p.id}
                data-project-category={p.data.categoria}
                data-project-search={searchText(p)}
                style={
                  i < proyectos.length - 1
                    ? 'border-bottom: 1px solid var(--color-border);'
                    : undefined
                }
              >
                <td class="px-5 py-4 align-top whitespace-nowrap">
                  <EditableText entry={fichaDe(p)} field="nombre" class="font-semibold text-text">
                    {p.data.nombre}
                  </EditableText>
                  {(p.data.diametro || p.data.peso || p.data.acero) && (
                    <div class="mt-1.5 flex flex-wrap gap-1.5">
                      {p.data.diametro && (
                        <EditableText
                          entry={fichaDe(p)}
                          field="diametro"
                          class="inline-block font-mono text-xs font-semibold text-primary bg-primary-light px-1.5 py-0.5"
                        >
                          {formatDiameters(p.data.diametro)}
                        </EditableText>
                      )}
                      {p.data.acero && (
                        <EditableText
                          entry={fichaDe(p)}
                          field="acero"
                          class="inline-block font-mono text-xs font-semibold text-text-muted bg-border px-1.5 py-0.5"
                        >
                          {p.data.acero}
                        </EditableText>
                      )}
                      {p.data.peso && (
                        <EditableText
                          entry={fichaDe(p)}
                          field="peso"
                          class="inline-block font-mono text-xs font-semibold text-primary bg-accent/10 px-1.5 py-0.5"
                        >
                          {p.data.peso}
                        </EditableText>
                      )}
                    </div>
                  )}
                </td>
                <td class="px-5 py-4 text-text-muted leading-relaxed align-top">
                  <EditableText entry={fichaDe(p)} field="alcance" type="textarea">
                    {formatDiameters(p.data.alcance)}
                  </EditableText>
                </td>
                <td class="px-5 py-4 align-top whitespace-nowrap">
                  {p.data.contratista || p.data.cliente ? (
                    <EditableText
                      entry={fichaDe(p)}
                      field={p.data.contratista ? 'contratista' : 'cliente'}
                      class="text-text-muted"
                    >
                      {p.data.contratista ?? p.data.cliente}
                    </EditableText>
                  ) : (
                    <span class="text-text-muted">—</span>
                  )}
                  {p.data.mandante && (
                    <span class="block text-xs text-text-muted mt-0.5">
                      {rotulo.mandante}:{' '}
                      <EditableText entry={fichaDe(p)} field="mandante">
                        {p.data.mandante}
                      </EditableText>
                    </span>
                  )}
                  {p.data.ubicacion && p.data.ubicacion !== 'Chile' && (
                    <EditableText
                      entry={fichaDe(p)}
                      field="ubicacion"
                      class="block font-mono text-xs text-primary mt-0.5"
                    >
                      {p.data.ubicacion}
                    </EditableText>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* Mobile list */}
      <div class="block md:hidden border-t border-border">
        {proyectos.map((p) => (
          <div
            class="border-b border-border py-5"
            data-project-item
            data-project-key={p.id}
            data-project-category={p.data.categoria}
            data-project-search={searchText(p)}
          >
            <div class="flex items-start justify-between gap-3 mb-2">
              <EditableText
                as="h4"
                entry={fichaDe(p)}
                field="nombre"
                class="font-heading font-semibold text-primary-dark leading-snug"
                style="font-size: var(--font-size-h4);"
              >
                {p.data.nombre}
              </EditableText>
              {(p.data.diametro || p.data.peso || p.data.acero) && (
                <div class="shrink-0 flex flex-wrap gap-1 mt-0.5">
                  {p.data.diametro && (
                    <EditableText
                      entry={fichaDe(p)}
                      field="diametro"
                      class="inline-block font-mono text-xs font-semibold text-primary bg-primary-light px-1.5 py-0.5"
                    >
                      {formatDiameters(p.data.diametro)}
                    </EditableText>
                  )}
                  {p.data.acero && (
                    <EditableText
                      entry={fichaDe(p)}
                      field="acero"
                      class="inline-block font-mono text-xs font-semibold text-text-muted bg-border px-1.5 py-0.5"
                    >
                      {p.data.acero}
                    </EditableText>
                  )}
                  {p.data.peso && (
                    <EditableText
                      entry={fichaDe(p)}
                      field="peso"
                      class="inline-block font-mono text-xs font-semibold text-primary bg-accent/10 px-1.5 py-0.5"
                    >
                      {p.data.peso}
                    </EditableText>
                  )}
                </div>
              )}
            </div>

            <EditableText
              as="p"
              entry={fichaDe(p)}
              field="alcance"
              type="textarea"
              class="text-sm text-text-muted leading-relaxed mb-3"
            >
              {formatDiameters(p.data.alcance)}
            </EditableText>

            {(p.data.cliente || p.data.contratista || p.data.mandante) && (
              <div class="flex items-center gap-2 flex-wrap text-xs text-text-muted">
                <span>{p.data.contratista ? rotulo.contratista : rotulo.cliente}:</span>
                <EditableText
                  entry={fichaDe(p)}
                  field={p.data.contratista ? 'contratista' : 'cliente'}
                  class="font-medium text-text"
                >
                  {p.data.contratista ?? p.data.cliente}
                </EditableText>
                {p.data.mandante && (
                  <span>
                    {rotulo.mandante}:{' '}
                    <EditableText entry={fichaDe(p)} field="mandante">
                      {p.data.mandante}
                    </EditableText>
                  </span>
                )}
                {p.data.ubicacion && p.data.ubicacion !== 'Chile' && (
                  <EditableText entry={fichaDe(p)} field="ubicacion" class="font-mono text-primary">
                    {p.data.ubicacion}
                  </EditableText>
                )}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  )
}
