---
import type { CollectionEntry } from 'astro:content';

interface Props {
  proyectos: CollectionEntry<'proyectos'>[];
  titulo: string;
}

const { proyectos, titulo } = Astro.props;
---

{proyectos.length > 0 && (
  <div class="mb-12">
    <h3 class="font-heading font-semibold text-primary-dark mb-4" style="font-size: var(--font-size-h3);">
      {titulo}
    </h3>
    
    {/* Desktop/Tablet Table view */}
    <div class="hidden md:block overflow-x-auto rounded-lg border border-border">
      <table class="w-full text-sm" style="border-collapse: collapse;">
        <thead>
          <tr class="bg-primary-light">
            <th class="text-left px-4 py-3 font-bold text-primary-dark whitespace-nowrap">Proyecto</th>
            <th class="text-left px-4 py-3 font-bold text-primary-dark">Alcance</th>
            <th class="text-left px-4 py-3 font-bold text-primary-dark whitespace-nowrap">Cliente</th>
          </tr>
        </thead>
        <tbody>
          {proyectos.map((p, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-background-alt'} style="border-bottom: 1px solid var(--color-border);">
              <td class="px-4 py-3 font-semibold text-text whitespace-nowrap">
                {p.data.nombre}
                {p.data.diametro && (
                  <span class="block font-mono text-xs text-text-muted font-normal mt-0.5">{p.data.diametro}</span>
                )}
              </td>
              <td class="px-4 py-3 text-text-muted leading-snug">{p.data.alcance}</td>
              <td class="px-4 py-3 text-text-muted whitespace-nowrap">{p.data.cliente ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* Mobile Cards view */}
    <div class="block md:hidden space-y-4">
      {proyectos.map((p) => (
        <div class="bg-surface border border-border rounded-lg p-4 flex flex-col gap-3 shadow-sm">
          <div>
            <h4 class="font-heading font-semibold text-primary-dark" style="font-size: var(--font-size-body-lg);">
              {p.data.nombre}
            </h4>
            {p.data.diametro && (
              <span class="inline-block font-mono text-xs text-text-muted mt-1 bg-background px-2 py-0.5 rounded border border-border">
                {p.data.diametro}
              </span>
            )}
          </div>
          
          <div class="text-sm text-text-muted leading-relaxed">
            <p class="mb-1 font-semibold text-xs text-text-muted uppercase tracking-wider">Alcance</p>
            {p.data.alcance}
          </div>

          {p.data.cliente && (
            <div class="border-t border-border pt-2.5 mt-1 flex justify-between items-center text-xs">
              <span class="font-semibold text-text-muted uppercase tracking-wider">Cliente</span>
              <span class="font-medium text-text bg-primary-light text-primary px-2.5 py-1 rounded-full">
                {p.data.cliente}
              </span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
)}
