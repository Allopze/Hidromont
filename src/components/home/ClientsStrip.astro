---
import type { CollectionEntry } from 'astro:content';
import Eyebrow from '../ui/Eyebrow.astro';
import Container from '../ui/Container.astro';
import EditableText from '../cms/EditableText.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';
import { getCmsText } from '../../data/cms';

interface Props {
  clientes: CollectionEntry<'clientes'>;
}

const { clientes } = Astro.props;
const lista = clientes.data.items;

// Split into those with logos and those without
const conLogo = lista.filter((c) => c.logo);
const sinLogo = lista.filter((c) => !c.logo);
---

<Container>
  <div class="text-center mb-10">
    <Eyebrow><EditableText entry="clients.strip" field="eyebrow">Clientes y referencias</EditableText></Eyebrow>
    <EditableText as="h2" entry="clients.strip" field="title" class="font-heading font-bold text-primary-dark" style="font-size: var(--font-size-h2);">
      {getCmsText('clients.strip', 'title', 'Empresas que confían en Hidromont')}
    </EditableText>
  </div>

  <!-- Logo wall — clients with logos -->
  {conLogo.length > 0 && (
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-6 items-center mb-8">
      {conLogo.map((c) => (
        <div
          class="flex items-center justify-center p-3 rounded-md transition-all duration-base ease-standard opacity-60 hover:opacity-100 grayscale hover:grayscale-0"
          title={c.nombre}
        >
          <img
            src={c.logo}
            alt={c.nombre}
            width="160"
            height="40"
            loading="lazy"
            decoding="async"
            class="max-h-10 w-auto object-contain"
          />
        </div>
      ))}
    </div>
  )}

  <!-- Text fallback for clients without logos, grouped in a subdued list -->
  {sinLogo.length > 0 && (
    <div class="border-t border-border pt-6">
      <EditableText as="p" entry="clients.strip" field="fallbackLabel" class="text-xs text-text-muted uppercase tracking-wider mb-3 text-center">
        {getCmsText('clients.strip', 'fallbackLabel', 'También trabajamos con')}
      </EditableText>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        {sinLogo.map((c) => (
          <span class="text-sm text-text-muted">{c.nombre}</span>
        ))}
      </div>
    </div>
  )}

  <div class="text-center mt-8">
    <a
      href="/clientes"
      class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors duration-fast inline-flex items-center gap-1"
    >
      <EditableText entry="clients.strip" field="linkLabel">
        {getCmsText('clients.strip', 'linkLabel', 'Ver todos los clientes')}
      </EditableText>
      <ArrowIcon />
    </a>
  </div>
</Container>
