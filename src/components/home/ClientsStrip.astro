---
import type { CollectionEntry } from 'astro:content';
import Eyebrow from '../ui/Eyebrow.astro';
import Container from '../ui/Container.astro';
import EditableText from '../cms/EditableText.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';
import MarqueePauseToggle from '../ui/MarqueePauseToggle.astro';
import { getCmsText } from '../../data/cms';
import { getClienteLogoByNombre, listaDeClientes, logoKeyFor } from '../../data/cliente-logos';

interface ClienteItem {
  nombre: string;
  sector?: string;
  logo?: string;
}

interface Props {
  clientes?: CollectionEntry<'clientes'> | { data: { items: ClienteItem[] } };
}

const { clientes } = Astro.props;
// El logo pasa por el CMS igual que en /clientes. La franja lo leía directo de
// la colección, así que un logo cambiado desde el panel se veía en /clientes y
// no aquí: Acciona, Besalco, Colbún y Elecnor salían con dos logos distintos.
// Con el editor, cada logo de la franja se cambia pulsándolo (la animación se
// detiene al pasar el puntero). Es el mismo campo que la cuadrícula de /clientes.
const cmsEditingEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';
const marcaDeLogo = (nombre: string) =>
  cmsEditingEnabled
    ? {
        'data-cms-entry': 'clientes.logos',
        'data-cms-field': `logo-${logoKeyFor(nombre)}`,
        'data-cms-type': 'image',
      }
    : {};
const lista: ClienteItem[] = listaDeClientes(clientes?.data?.items || []).map((c: ClienteItem) => ({
  ...c,
  logo: getClienteLogoByNombre(c.nombre, c.logo || '') || undefined,
}));

// Split into those with logos and those without
const conLogo = lista.filter((c: ClienteItem) => c.logo);
const sinLogo = lista.filter((c: ClienteItem) => !c.logo);

// Split logos into two rows for marquee
const mid = Math.ceil(conLogo.length / 2);
const row1 = conLogo.slice(0, mid);
const row2 = conLogo.slice(mid);
---

<Container>
  <div class="text-center mb-10">
    <Eyebrow>
      <EditableText entry="clients.strip" field="eyebrow">
        {getCmsText('clients.strip', 'eyebrow', 'Clientes y referencias')}
      </EditableText>
    </Eyebrow>
    {
      /* Sin H2. La misma frase se retiró de /clientes por orden expresa del
         dueño (ver el comentario en src/pages/clientes.astro), y aquí había
         sobrevivido. No basta con vaciar el campo en el panel: getCmsText
         devuelve '' y quedaría un <h2> vacío en el DOM. */
    }
  </div>

  {
    /* UIUX-6 fix: the whole marquee is decorative/duplicated for the visual
       loop (each row repeats its logos twice) and hidden from assistive tech
       — previously it wasn't, so screen readers read every client name
       twice. The "Ver todos los clientes" link below points to /clientes,
       which lists every client accessibly; same pattern already used by
       ClientesHero's marquee. */
  }
  <div class="clients-marquee-wrapper marquee-region">
    {(row1.length > 0 || row2.length > 0) && <MarqueePauseToggle />}
    <div aria-hidden="true">
      {/* Row 1 — scrolls left */}
      {
        row1.length > 0 && (
          <div class="clients-marquee-row">
            <div class="clients-marquee-track logo-marquee-track">
              {[...row1, ...row1].map((c) => (
                <div class="clients-marquee-item" title={c.nombre}>
                  <img
                    src={c.logo}
                    alt=""
                    width="160"
                    height="48"
                    loading="lazy"
                    decoding="async"
                    class="clients-marquee-logo"
                    {...marcaDeLogo(c.nombre)}
                  />
                </div>
              ))}
            </div>
          </div>
        )
      }

      {/* Row 2 — scrolls right */}
      {
        row2.length > 0 && (
          <div class="clients-marquee-row">
            <div class="clients-marquee-track logo-marquee-track--rev">
              {[...row2, ...row2].map((c) => (
                <div class="clients-marquee-item" title={c.nombre}>
                  <img
                    src={c.logo}
                    alt=""
                    width="160"
                    height="48"
                    loading="lazy"
                    decoding="async"
                    class="clients-marquee-logo"
                    {...marcaDeLogo(c.nombre)}
                  />
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>

  {/* Text fallback for clients without logos */}
  {
    sinLogo.length > 0 && (
      <div class="clients-text-fallback">
        <EditableText
          as="p"
          entry="clients.strip"
          field="fallbackLabel"
          class="text-xs text-text-muted uppercase tracking-wider mb-3 text-center"
        >
          {getCmsText('clients.strip', 'fallbackLabel', 'También trabajamos con')}
        </EditableText>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
          {sinLogo.map((c: ClienteItem) => (
            <span class="text-sm text-text-muted font-medium">{c.nombre}</span>
          ))}
        </div>
      </div>
    )
  }

  <div class="text-center mt-8">
    <a href="/clientes" class="clients-strip-link">
      <EditableText entry="clients.strip" field="linkLabel">
        {getCmsText('clients.strip', 'linkLabel', 'Ver todos los clientes')}
      </EditableText>
      <ArrowIcon />
    </a>
  </div>
</Container>

<style>
  /* ── Marquee wrapper with edge fades ── */
  .clients-marquee-wrapper {
    position: relative;
    overflow: hidden;
    /* Banda superior reservada para el botón de pausa (top:8px + 44px de
       alto): antes flotaba sobre el último logo de la fila 1 (BESALCO). */
    padding: 56px 0 16px;
    mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  .clients-marquee-row {
    display: flex;
    overflow: hidden;
  }

  .clients-marquee-row + .clients-marquee-row {
    margin-top: 24px;
  }

  .clients-marquee-track {
    display: flex;
    gap: 56px; /* Generous gap for clean separation of borderless logos */
    flex-shrink: 0;
  }

  /* ── Individual clean logo item ── */
  .clients-marquee-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    width: 180px;
    transition: transform var(--motion-base) var(--ease-standard);
  }

  .clients-marquee-item:hover {
    transform: scale(1.06);
  }

  .clients-marquee-logo {
    height: 48px;
    width: 150px;
    object-fit: contain;
    filter: grayscale(100%) opacity(0.65);
    transition: filter var(--motion-base) var(--ease-standard);
  }

  .clients-marquee-item:hover .clients-marquee-logo {
    filter: grayscale(0%) opacity(1);
  }

  /* ── Fallback text section ── */
  .clients-text-fallback {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
    margin-top: 32px;
  }

  /* ── Link ── */
  .clients-strip-link {
    display: inline-flex;
    align-items: center;
    /* M-8: WCAG 2.2 SC 2.5.8 exige 24 px de alto; con `font-size-small` el
       enlace medía 21. */
    min-height: 24px;
    gap: 4px;
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .clients-strip-link:hover {
    color: var(--color-primary-dark);
  }

  /* B3-001: focus-visible consistente en el enlace del strip (los items del marquee
     son decorativos, no interactivos, por lo que no requieren focus ring). */
  .clients-strip-link:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }
</style>
