---
import { Image } from 'astro:assets';
import heroImg from '../../assets/fotos/hero-home.png';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import EditableText from '../cms/EditableText.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  cmsEntry?: string;
}

const {
  eyebrow = 'Especialistas en equipos hidromecánicos',
  title,
  subtitle,
  ctaPrimary,
  ctaSecondary,
  cmsEntry = 'home.hero',
} = Astro.props;
---

<section class="relative min-h-[100dvh] flex items-center overflow-hidden bg-background-strong text-white">

  <!-- Foto de fondo optimizada (Astro genera webp responsivo) -->
  <Image
    src={heroImg}
    alt="Vista aérea de las instalaciones de Hidromont Chile en Los Ángeles, Biobío"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover pointer-events-none"
    style="object-position: center 35%;"
  />

  <!-- Línea de acento superior -->
  <div
    class="absolute top-0 left-0 right-0 h-[2px] pointer-events-none shimmer-line"
    aria-hidden="true"
  ></div>

  <!-- Contenido: alineado a la izquierda -->
  <div class="relative z-10 w-full mx-auto px-6 max-w-wide py-24 lg:py-28">
    <div class="max-w-2xl">

      <Eyebrow light class="text-on-photo">
        <EditableText entry={cmsEntry} field="eyebrow">{eyebrow}</EditableText>
      </Eyebrow>

      <EditableText
        as="h1"
        entry={cmsEntry}
        field="title"
        class="font-heading text-white leading-tight mb-6 mt-3 text-on-photo--display"
        style="font-size: var(--font-size-display); font-weight: 700; letter-spacing: -0.02em;"
        type="text"
        reveal
      >
        {title}
      </EditableText>

      <EditableText
        as="p"
        entry={cmsEntry}
        field="subtitle"
        class="text-white/90 mb-10 max-w-xl text-on-photo"
        style="font-size: var(--font-size-lead); line-height: 1.65; --reveal-delay: 0.1s;"
        type="textarea"
        reveal
      >
        {subtitle}
      </EditableText>

      <div class="flex flex-wrap gap-4" data-reveal style="--reveal-delay: 0.18s;">
        <Button href={ctaPrimary.href} size="lg">{ctaPrimary.label}</Button>
        {ctaSecondary && (
          <Button
            href={ctaSecondary.href}
            variant="secondary-light"
            size="lg"
          >
            {ctaSecondary.label}
          </Button>
        )}
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <svg width="24" height="36" viewBox="0 0 24 36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="1" y="1" width="22" height="34" rx="11" stroke="white" stroke-opacity="0.5" stroke-width="1.5"/>
      <circle cx="12" cy="10" r="2.5" fill="white" fill-opacity="0.7"/>
    </svg>
  </div>

</section>
