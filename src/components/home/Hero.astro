---
import { Image } from 'astro:assets';
import heroImg from '../../assets/fotos/hero-home.png';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
}

const {
  eyebrow = 'Especialistas en equipos hidromecánicos',
  title,
  subtitle,
  ctaPrimary,
  ctaSecondary,
} = Astro.props;
---

<section class="relative min-h-[100dvh] flex items-center overflow-hidden bg-background-strong text-white">

  <!-- Foto de fondo optimizada (Astro genera webp responsivo) -->
  <Image
    src={heroImg}
    alt="Vista aérea de las instalaciones de Hidromont Chile S.A. en Los Ángeles, Biobío"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover pointer-events-none"
    style="object-position: center 35%;"
  />

  <!-- Overlay lateral: oscurece la izquierda para legibilidad del texto -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: linear-gradient(to right, rgba(15,36,51,0.88) 0%, rgba(15,36,51,0.55) 40%, rgba(15,36,51,0.15) 65%, transparent 100%);"
  ></div>

  <!-- Overlay inferior: funde hacia la sección siguiente -->
  <div
    class="absolute bottom-0 left-0 right-0 h-28 pointer-events-none"
    aria-hidden="true"
    style="background: linear-gradient(to top, rgba(15,36,51,0.85), transparent);"
  ></div>

  <!-- Línea de acento superior -->
  <div
    class="absolute top-0 left-0 right-0 h-[2px] pointer-events-none"
    aria-hidden="true"
    style="background: linear-gradient(90deg, transparent, var(--color-primary) 30%, var(--color-accent) 70%, transparent);"
  ></div>

  <!-- Contenido: alineado a la izquierda -->
  <div class="relative z-10 w-full mx-auto px-6 max-w-wide py-24 lg:py-28">
    <div class="max-w-2xl">

      <Eyebrow light>{eyebrow}</Eyebrow>

      <h1
        class="font-heading text-white leading-tight mb-6 mt-3"
        style="font-size: var(--font-size-display); font-weight: 700; letter-spacing: -0.02em;"
        data-reveal
      >
        {title}
      </h1>

      <p
        class="text-white/80 mb-10 max-w-xl"
        style="font-size: var(--font-size-body-lg); line-height: 1.65; --reveal-delay: 0.1s;"
        data-reveal
      >
        {subtitle}
      </p>

      <div class="flex flex-wrap gap-4" data-reveal style="--reveal-delay: 0.18s;">
        <Button href={ctaPrimary.href} size="lg">{ctaPrimary.label}</Button>
        {ctaSecondary && (
          <Button
            href={ctaSecondary.href}
            variant="secondary-light"
            size="lg"
          >
            {ctaSecondary.label}
          </Button>
        )}
      </div>

    </div>
  </div>

</section>
