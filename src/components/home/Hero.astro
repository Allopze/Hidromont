---
import { Image } from 'astro:assets';
import heroImg from '../../assets/fotos/hero-home.png';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import EditableText from '../cms/EditableText.astro';
import EditableImage from '../cms/EditableImage.astro';
import { getCmsText } from '../../data/cms';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  cmsEntry?: string;
}

const {
  eyebrow = 'Especialistas en equipos hidromecánicos',
  title,
  subtitle,
  ctaPrimary,
  ctaSecondary,
  cmsEntry = 'home.hero',
} = Astro.props;

// La foto de portada era un import de src/assets: cambiarla exigía un
// despliegue. Si el CMS tiene una foto, se usa esa (con su encuadre); si no,
// la de siempre, que Astro sigue optimizando. Las dos se cambian pulsándolas.
const fotoCms = getCmsText('home.hero', 'image', '');
const fotoAlt = getCmsText(
  'home.hero',
  'imageAlt',
  'Vista aérea de las instalaciones de Hidromont Chile en Los Ángeles, Biobío'
);
const cmsEditingEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';
const marcasFoto = cmsEditingEnabled
  ? {
      'data-cms-entry': cmsEntry,
      'data-cms-field': 'image',
      'data-cms-alt-field': 'imageAlt',
      'data-cms-type': 'image',
    }
  : {};
---

<section
  class="relative min-h-[100dvh] flex items-center overflow-hidden bg-background-strong text-white"
>
  <!-- Foto de fondo. `data-cms-fondo`: con el editor abierto recibe los clics
       de las zonas vacías de la portada (styles.js del overlay). -->
  {
    fotoCms ? (
      <EditableImage
        entry={cmsEntry}
        field="image"
        altField="imageAlt"
        src={fotoCms}
        alt={fotoAlt}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover pointer-events-none"
        data-cms-fondo
      />
    ) : (
      <Image
        src={heroImg}
        alt={fotoAlt}
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover pointer-events-none"
        style="object-position: center 35%;"
        data-cms-fondo
        {...marcasFoto}
      />
    )
  }

  <!-- Overlay gradiente superior para mejorar legibilidad de la cabecera (desde el tope hasta la mitad) -->
  <div
    class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-black/65 to-transparent pointer-events-none"
    aria-hidden="true"
  >
  </div>

  {
    /* UIUX-18 fix: text-shadow alone (.text-on-photo) doesn't guarantee 4.5:1
       over a real aerial photo — bright sky/concrete areas under the title
       aren't ruled out. This scrim anchors dark behind the left text column,
       full height, independent of where the vertically-centered text block
       actually lands. */
  }
  <div
    class="absolute inset-y-0 left-0 w-full lg:w-3/5 pointer-events-none"
    style="background: linear-gradient(90deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.35) 55%, transparent 100%);"
    aria-hidden="true"
  >
  </div>

  <!-- Línea de acento superior -->
  <div
    class="absolute top-0 left-0 right-0 h-[2px] pointer-events-none shimmer-line"
    aria-hidden="true"
  >
  </div>

  <!-- Contenido: alineado a la izquierda -->
  <div class="relative z-10 w-full mx-auto px-6 max-w-wide py-24 lg:py-28" data-cms-sobre-fondo>
    <div class="max-w-2xl">
      <Eyebrow light class="text-on-photo">
        <EditableText entry={cmsEntry} field="eyebrow">{eyebrow}</EditableText>
      </Eyebrow>

      <EditableText
        as="h1"
        entry={cmsEntry}
        field="title"
        class="font-heading text-white leading-tight mb-6 mt-3 text-on-photo--display"
        style="font-size: var(--font-size-display); font-weight: 700; letter-spacing: -0.02em;"
        type="text"
        reveal
      >
        {title}
      </EditableText>

      <EditableText
        as="p"
        entry={cmsEntry}
        field="subtitle"
        class="text-white/90 mb-10 max-w-xl text-on-photo"
        style="font-size: var(--font-size-lead); line-height: 1.65; --reveal-delay: 0.1s;"
        type="textarea"
        reveal
      >
        {subtitle}
      </EditableText>

      <div class="flex flex-wrap gap-4" data-reveal style="--reveal-delay: 0.18s;">
        <Button href={ctaPrimary.href} size="lg">
          <EditableText entry={cmsEntry} field="primaryLabel">{ctaPrimary.label}</EditableText>
        </Button>
        {
          ctaSecondary && (
            <Button href={ctaSecondary.href} variant="secondary-light" size="lg">
              <EditableText entry={cmsEntry} field="secondaryLabel">
                {ctaSecondary.label}
              </EditableText>
            </Button>
          )
        }
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <svg width="24" height="36" viewBox="0 0 24 36" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect
        x="1"
        y="1"
        width="22"
        height="34"
        rx="11"
        stroke="white"
        stroke-opacity="0.5"
        stroke-width="1.5"></rect>
      <circle cx="12" cy="10" r="2.5" fill="white" fill-opacity="0.7"></circle>
    </svg>
  </div>
</section>
