---
import Eyebrow from '../ui/Eyebrow.astro';
import Container from '../ui/Container.astro';
import EditableText from '../cms/EditableText.astro';

interface Capability {
  icon?: string;
  title: string;
  description?: string;
  value?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  items: Capability[];
  columns?: 3 | 4 | 5;
  light?: boolean;
  cmsEntry?: string;
}

const { eyebrow, title, subtitle, items, columns = 4, light = false, cmsEntry } = Astro.props;

// Whether any item has a metric value (determines layout style)
const hasValues = items.some((i) => i.value);

/**
 * Parse a metric value like "3.000 m²" into { num: 3000, suffix: " m²" }
 * for animated counter support. Returns null if not parseable.
 */
function parseMetric(val: string): { num: number; suffix: string } | null {
  const match = val.match(/^([\d.]+)\s*(.*)$/);
  if (!match) return null;
  // Remove thousands separator dots (Chilean format) but keep decimal commas
  const numStr = match[1].replace(/\./g, '');
  const num = parseInt(numStr, 10);
  if (isNaN(num)) return null;
  return { num, suffix: match[2] ? ` ${match[2]}` : '' };
}

/**
 * Split a value like "40+ años" into { digits: "40", rest: "+ años" } so only
 * the digits render in the monospace face — mixing letters into font-mono
 * throws off spacing around symbols like "+".
 */
function splitValueDisplay(val: string): { digits: string; rest: string } {
  const match = val.match(/^([\d.,]+)(.*)$/);
  if (!match) return { digits: val, rest: '' };
  return { digits: match[1], rest: match[2] };
}
---

<Container>
  <!-- Section heading — left aligned, not centred -->
  <div class="mb-10 max-w-2xl">
    {
      eyebrow && (
        <Eyebrow light={light}>
          <EditableText entry={cmsEntry} field="eyebrow">
            {eyebrow}
          </EditableText>
        </Eyebrow>
      )
    }
    <EditableText
      as="h2"
      entry={cmsEntry}
      field="title"
      class={`font-heading font-bold mb-3 ${light ? 'text-white' : 'text-primary-dark'}`}
      style="font-size: var(--font-size-h2);"
      reveal
    >
      {title}
    </EditableText>
    {
      subtitle && (
        <EditableText
          as="p"
          entry={cmsEntry}
          field="subtitle"
          type="textarea"
          class={`${light ? 'text-white/70' : 'text-text-muted'}`}
          style="font-size: var(--font-size-lead); --reveal-delay: 0.08s;"
          reveal
        >
          {subtitle}
        </EditableText>
      )
    }
  </div>

  {
    hasValues ? (
      /* Metric items: horizontal rule-divided list — no card boxes */
      <div
        class={`grid grid-cols-1 sm:grid-cols-2 ${columns === 5 ? 'lg:grid-cols-5' : columns === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'} gap-0`}
      >
        {items.map((item, i) => (
          <div
            class={`py-6 pr-6 ${i > 0 ? (light ? 'border-t sm:border-t-0 sm:border-l border-white/10' : 'border-t sm:border-t-0 sm:border-l border-border') : ''}`}
            style={`--reveal-delay: ${i * 0.07}s;`}
            data-reveal
          >
            {item.value &&
              (() => {
                const parsed = parseMetric(item.value);
                const { digits, rest } = splitValueDisplay(item.value);
                return (
                  <p
                    class={`font-heading font-bold mb-2 ${light ? 'text-accent' : 'text-primary'}`}
                    style="font-size: var(--font-size-h3);"
                    data-count={parsed ? String(parsed.num) : undefined}
                    data-suffix={parsed ? parsed.suffix : undefined}
                  >
                    <span class="font-mono">{digits}</span>
                    {rest}
                  </p>
                );
              })()}
            <h3
              class={`font-heading font-semibold mb-1 ${light ? 'text-white' : 'text-primary-dark'}`}
              style="font-size: 1.05rem;"
            >
              {item.title}
            </h3>
            {item.description && (
              <p class={`text-sm leading-relaxed ${light ? 'text-white/80' : 'text-text-muted'}`}>
                {item.description}
              </p>
            )}
          </div>
        ))}
      </div>
    ) : (
      /* Non-metric items: compact 2-column zig-zag list with dividers */
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
        {items.map((item, i) => (
          <div
            class={`flex gap-4 py-5 pr-6 ${light ? 'border-b border-white/10' : 'border-b border-border'} ${i % 2 === 1 && 'md:pl-6'}`}
            style={`--reveal-delay: ${i * 0.06}s;`}
            data-reveal
          >
            {/* Accent marker */}
            <div class="shrink-0 mt-1 w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true" />
            <div>
              <h3
                class={`font-heading font-semibold mb-1 ${light ? 'text-white' : 'text-primary-dark'}`}
                style="font-size: 1.05rem;"
              >
                {item.title}
              </h3>
              {item.description && (
                <p class={`text-sm leading-relaxed ${light ? 'text-white/80' : 'text-text-muted'}`}>
                  {item.description}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    )
  }
</Container>
