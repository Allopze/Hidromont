---
import { company } from '../../data/company';
import EditableText from '../cms/EditableText.astro';
import { getCmsText } from '../../data/cms';

interface Props {
  hideMap?: boolean;
}

const { hideMap = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-background-strong text-white">
  <!-- Main footer -->
  <div class="w-full mx-auto px-6 max-w-container py-16">
    <div class={`grid grid-cols-1 md:grid-cols-2 ${hideMap ? 'lg:grid-cols-4' : 'lg:grid-cols-6'} gap-10`}>
      {/* Brand & Map (Spans 3 columns on desktop) — hidden when hideMap */}
      {!hideMap && (
      <div class="lg:col-span-3 grid grid-cols-1 sm:grid-cols-[1.8fr_1fr] gap-8">
        <!-- Map Info (Left side on desktop) -->
        <div class="flex flex-col justify-start pt-1">
          <!-- Mapa interactivo y enlaces georreferenciados (Footer) -->
          <div class="w-full">
            <div class="relative group overflow-hidden rounded-lg border border-white/10 shadow-sm bg-white/5 card-lift">
              <div class="h-60 w-full overflow-hidden pointer-events-none opacity-80 group-hover:opacity-100 transition-opacity">
                <iframe
                  src="https://maps.google.com/maps?q=Hidromont%20Chile%20S.A.,%20Avenida%20Las%20Industrias%2010950,%20Los%20Angeles,%20Chile&t=&z=14&ie=UTF8&iwloc=&output=embed"
                  width="100%"
                  height="100%"
                  style="border:0; filter: invert(90%) hue-rotate(180deg) grayscale(0.2) contrast(1.1);"
                  allowfullscreen=""
                  loading="lazy"
                  title="Ubicación de Hidromont Chile S.A."
                ></iframe>
              </div>
              <div class="absolute inset-0 bg-black/10 group-hover:bg-black/25 transition-colors flex items-center justify-center pointer-events-none">
                <div class="px-2.5 py-1.5 bg-background-strong/95 backdrop-blur-xs text-white font-semibold text-xs rounded-full shadow-md border border-white/10 flex items-center gap-1 transform group-hover:scale-105 transition-transform">
                  <svg class="w-3 h-3 text-primary animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                  </svg>
                  Cómo llegar
                </div>
              </div>
              <a 
                href="https://www.google.com/maps/dir/?api=1&destination=Hidromont+Chile+S.A.,+Avenida+Las+Industrias+10950,+Los+Angeles,+Chile" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="absolute inset-0 z-10"
                title="Abrir ruta en Google Maps"
              ></a>
            </div>
            
            <div class="grid grid-cols-2 gap-2 mt-2">
              <a
                href="https://www.google.com/maps/dir/?api=1&destination=Hidromont+Chile+S.A.,+Avenida+Las+Industrias+10950,+Los+Angeles,+Chile"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-1.5 px-3 py-1.5 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 rounded-lg text-xs font-semibold text-white/80 hover:text-white transition-all no-underline"
              >
                <svg class="w-3.5 h-3.5 text-[#6BA4FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                Google Maps
              </a>
              <a
                href="https://waze.com/ul?q=Hidromont%20Chile%20S.A.,%20Avenida%20Las%20Industrias%2010950,%20Los%20Angeles,%20Chile&navigate=yes"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-1.5 px-3 py-1.5 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 rounded-lg text-xs font-semibold text-white/80 hover:text-white transition-all no-underline"
              >
                <svg class="w-3.5 h-3.5 text-[#66DBFF]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M13.314 1.59c-.225.003-.45.013-.675.03-2.165.155-4.295.924-6.069 2.327-2.194 1.732-3.296 4.325-3.496 7.05h.002c-.093 1.22-.23 2.15-.469 2.63-.238.479-.42.638-1.24.639C.27 14.259-.4 15.612.266 16.482c1.248 1.657 2.902 2.705 4.72 3.364a2.198 2.198 0 00-.033.367 2.198 2.198 0 002.2 2.197 2.198 2.198 0 002.128-1.668c1.307.12 2.607.14 3.824.1.364-.012.73-.045 1.094-.092a2.198 2.198 0 002.127 1.66 2.198 2.198 0 002.2-2.197 2.198 2.198 0 00-.151-.797 12.155 12.155 0 002.303-1.549c2.094-1.807 3.511-4.399 3.302-7.404-.112-1.723-.761-3.298-1.748-4.608-2.143-2.86-5.53-4.309-8.918-4.265zm.366 1.54c.312.008.623.027.933.063 2.48.288 4.842 1.496 6.4 3.577v.001c.829 1.1 1.355 2.386 1.446 3.792v.003c.173 2.477-.965 4.583-2.777 6.147a10.66 10.66 0 01-2.375 1.535 2.198 2.198 0 00-.98-.234 2.198 2.198 0 00-1.934 1.158 9.894 9.894 0 01-1.338.146 27.323 27.323 0 01-3.971-.148 2.198 2.198 0 00-1.932-1.156 2.198 2.198 0 00-1.347.463c-1.626-.553-3.078-1.422-4.155-2.762 1.052-.096 1.916-.6 2.319-1.408.443-.889.53-1.947.625-3.198v-.002c.175-2.391 1.11-4.536 2.92-5.964h.002c1.77-1.402 3.978-2.061 6.164-2.012z"/>
                </svg>
                Waze
              </a>
            </div>
          </div>
        </div>

        <!-- Brand Info -->
        <div>
          <div class="space-y-2 text-sm text-white/70">
            <p>
              <span class="text-white/70 text-xs uppercase tracking-wide block mb-0.5">Dirección</span>
              <EditableText entry="site.company" field="domicilio">{company.domicilio}</EditableText><br />
              <EditableText entry="site.company" field="ciudad">{company.ciudad}</EditableText>
            </p>
          </div>
        </div>
      </div>
      )}

      {/* Compact brand block when map is hidden */}
      {hideMap && (
      <div class="lg:col-span-2">
        <EditableText as="p" entry="layout.footer" field="brand" class="font-heading text-xl font-bold text-white mb-3">
          {getCmsText('layout.footer', 'brand', 'Hidromont Chile S.A.')}
        </EditableText>
        <EditableText as="p" entry="layout.footer" field="description" type="textarea" class="text-sm text-white/70 leading-relaxed mb-6 max-w-sm">
          {getCmsText('layout.footer', 'description', 'Ingeniería, fabricación y montaje de equipos hidromecánicos para embalses y centrales hidroeléctricas. Desde 1983 ejecutando proyectos complejos con precisión industrial.')}
        </EditableText>
        <div class="space-y-2 text-sm text-white/70">
          <p>
            <span class="text-white/70 text-xs uppercase tracking-wide block mb-0.5">Dirección</span>
            <EditableText entry="site.company" field="domicilio">{company.domicilio}</EditableText><br />
            <EditableText entry="site.company" field="ciudad">{company.ciudad}</EditableText>
          </p>
        </div>
      </div>
      )}

      <!-- Servicios -->
      <div>
        <p class="text-sm font-semibold text-white uppercase tracking-wide mb-4">Servicios</p>
        <nav aria-label="Servicios">
          <ul class="space-y-2">
            <li><a href="/servicios/tuberias-forzadas" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Tuberías Forzadas</a></li>
            <li><a href="/servicios/compuertas" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Compuertas</a></li>
            <li><a href="/servicios/valvulas" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Válvulas</a></li>
            <li><a href="/servicios/turbinas" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Turbinas</a></li>
            <li><a href="/servicios/limpiarrejas" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Limpiarrejas</a></li>
            <li><a href="/servicios/otros-montajes" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Montajes Especiales</a></li>
          </ul>
        </nav>
      </div>

      <!-- Empresa -->
      <div>
        <p class="text-sm font-semibold text-white uppercase tracking-wide mb-4">Empresa</p>
        <nav aria-label="Empresa">
          <ul class="space-y-2">
            <li><a href="/empresa" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Quiénes somos</a></li>
            <li><a href="/proyectos" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Proyectos</a></li>
            <li><a href="/clientes" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Clientes</a></li>
            <li><a href="/contacto" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Contacto</a></li>
          </ul>
        </nav>
      </div>

      <!-- Contacto -->
      <div>
        <p class="text-sm font-semibold text-white uppercase tracking-wide mb-4">Contacto</p>
        <div class="space-y-3 text-sm text-white/70">
          <p>
            <span class="text-white/40 text-xs uppercase tracking-wide block mb-0.5">Teléfono</span>
            <a href={`tel:${company.telefono.replace(/\s/g, '')}`} class="hover:text-white no-underline transition-colors duration-fast block">
              <EditableText entry="site.company" field="telefono">{company.telefono}</EditableText>
            </a>
          </p>
          <p>
            <span class="text-white/40 text-xs uppercase tracking-wide block mb-0.5">Correo</span>
            <a href={`mailto:${company.email}`} class="hover:text-white no-underline transition-colors duration-fast block">
              <EditableText entry="site.company" field="email">{company.email}</EditableText>
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="w-full mx-auto px-6 max-w-container py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-white/70">
        &copy; {year} {company.razonSocial}. Todos los derechos reservados.
      </p>
      <p class="text-xs text-white/60">
        <EditableText entry="layout.footer" field="location">
          {getCmsText('layout.footer', 'location', 'Los Ángeles, Región del Biobío, Chile')}
        </EditableText>
      </p>
    </div>
  </div>
</footer>
