---
import { company } from '../../data/company';
import EditableText from '../cms/EditableText.astro';
import { getCmsText } from '../../data/cms';
import { navItems } from '../../data/nav';
import LocationCard from '../contact/LocationCard.astro';

interface Props {
  hideMap?: boolean;
}

const { hideMap = false } = Astro.props;
const year = new Date().getFullYear();
// ESTRUCT-4 fix: derivar del mismo nav.ts que usa el Header, para que el
// footer no pueda quedar desincronizado si se agrega/renombra un servicio.
const serviciosLinks = navItems.find((item) => item.cmsField === 'navServicios')?.children ?? [];

// Rótulos del pie (Textos del sitio → Pie de página). Los enlaces de la
// columna Empresa, salvo «Quiénes somos», son las mismas entradas del menú.
const rotulo = {
  servicios: getCmsText('layout.footer', 'tituloServicios', 'Servicios'),
  empresa: getCmsText('layout.footer', 'tituloEmpresa', 'Empresa'),
  contacto: getCmsText('layout.footer', 'tituloContacto', 'Contacto'),
  telefono: getCmsText('layout.footer', 'rotuloTelefono', 'Teléfono'),
  correo: getCmsText('layout.footer', 'rotuloCorreo', 'Correo'),
  direccion: getCmsText('layout.footer', 'rotuloDireccion', 'Dirección'),
  derechos: getCmsText('layout.footer', 'derechos', 'Todos los derechos reservados.'),
};
const delMenu = (campo: string) => navItems.find((item) => item.cmsField === campo);
const enlacesEmpresa = [
  {
    href: delMenu('navEmpresa')?.href ?? '/empresa',
    entry: 'layout.footer',
    field: 'enlaceQuienesSomos',
    label: getCmsText('layout.footer', 'enlaceQuienesSomos', 'Quiénes somos'),
  },
  ...['navProyectos', 'navGaleria', 'navClientes', 'navContacto'].flatMap((campo) => {
    const item = delMenu(campo);
    return item
      ? [{ href: item.href, entry: 'layout.header', field: campo, label: item.label }]
      : [];
  }),
];
---

<footer class="bg-background-strong text-white">
  <!-- Main footer -->
  <div class="w-full mx-auto px-6 max-w-container py-16">
    <div
      class={`grid grid-cols-1 md:grid-cols-2 ${hideMap ? 'lg:grid-cols-5' : 'lg:grid-cols-6'} gap-10`}
    >
      {/* Brand & location panel (Spans 3 columns on desktop) — hidden when hideMap */}
      {
        !hideMap && (
          <div class="lg:col-span-3">
            {/* La dirección vive solo en LocationCard: repetirla en la columna
                de al lado la mostraba dos veces en el mismo pie. */}
            <LocationCard
              theme="dark"
              titleId="footer-location-title"
              showDirections={false}
              showEmbeddedMap={false}
            />
          </div>
        )
      }

      {/* Compact brand block when map is hidden */}
      {
        hideMap && (
          <div class="lg:col-span-2">
            <EditableText
              as="p"
              entry="layout.footer"
              field="brand"
              class="font-heading text-xl font-bold text-white mb-3"
            >
              {getCmsText('layout.footer', 'brand', 'Hidromont Chile')}
            </EditableText>
            <EditableText
              as="p"
              entry="layout.footer"
              field="description"
              type="textarea"
              class="text-sm text-white/70 leading-relaxed mb-6 max-w-sm"
            >
              {getCmsText(
                'layout.footer',
                'description',
                'Equipos hidromecánicos para embalses y centrales hidroeléctricas. Presencia en Chile desde 1997.'
              )}
            </EditableText>
            <div class="space-y-2 text-sm text-white/70">
              <p>
                <EditableText
                  entry="layout.footer"
                  field="rotuloDireccion"
                  class="text-white/70 text-xs uppercase tracking-wide block mb-0.5"
                >
                  {rotulo.direccion}
                </EditableText>
                <>
                  <EditableText entry="site.company" field="domicilio">
                    {company.domicilio}
                  </EditableText>
                  <br />
                </>
                <EditableText entry="site.company" field="ciudad">
                  {company.ciudad}
                </EditableText>
              </p>
            </div>
          </div>
        )
      }

      <!-- Servicios -->
      <details class="footer-section">
        <summary
          class="text-sm font-semibold text-white uppercase tracking-wide mb-4 min-h-[44px] flex items-center justify-between cursor-pointer"
        >
          <EditableText entry="layout.footer" field="tituloServicios"
            >{rotulo.servicios}</EditableText
          >
          <span class="footer-chevron md:hidden" aria-hidden="true">+</span>
        </summary>
        {
          /* M-8: `min-h-[24px]` en cada enlace cumple WCAG 2.2 SC 2.5.8
            (tamaño del objetivo, AA). Con solo `text-sm` y `space-y-2`
            medían 17 px de alto, y en móvil este pie es la navegación
            secundaria principal. Era el último incumplimiento AA del sitio. */
        }
        <nav aria-label={rotulo.servicios}>
          <ul class="space-y-2">
            {
              serviciosLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-flex min-h-[24px] items-center text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast"
                  >
                    {/* El mismo campo que el menú de la cabecera. */}
                    <EditableText entry={item.cmsEntry ?? 'layout.header'} field={item.cmsField}>
                      {item.label}
                    </EditableText>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>

      <!-- Empresa -->
      <details class="footer-section">
        <summary
          class="text-sm font-semibold text-white uppercase tracking-wide mb-4 min-h-[44px] flex items-center justify-between cursor-pointer"
        >
          <EditableText entry="layout.footer" field="tituloEmpresa">{rotulo.empresa}</EditableText>
          <span class="footer-chevron md:hidden" aria-hidden="true">+</span>
        </summary>
        <nav aria-label={rotulo.empresa}>
          <ul class="space-y-2">
            {
              enlacesEmpresa.map((enlace) => (
                <li>
                  <a
                    href={enlace.href}
                    class="inline-flex min-h-[24px] items-center text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast"
                  >
                    <EditableText entry={enlace.entry} field={enlace.field}>
                      {enlace.label}
                    </EditableText>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>

      <!-- Contacto -->
      <details class="footer-section">
        <summary
          class="text-sm font-semibold text-white uppercase tracking-wide mb-4 min-h-[44px] flex items-center justify-between cursor-pointer"
        >
          <EditableText entry="layout.footer" field="tituloContacto">{rotulo.contacto}</EditableText
          >
          <span class="footer-chevron md:hidden" aria-hidden="true">+</span>
        </summary>
        <div class="space-y-3 text-sm text-white/70">
          <p>
            <EditableText
              entry="layout.footer"
              field="rotuloTelefono"
              class="text-white/70 text-xs uppercase tracking-wide block mb-0.5"
            >
              {rotulo.telefono}
            </EditableText>
            <a
              href={`tel:${company.telefono.replace(/\s/g, '')}`}
              class="inline-flex min-h-[24px] items-center hover:text-white no-underline transition-colors duration-fast"
            >
              <EditableText entry="site.company" field="telefono">{company.telefono}</EditableText>
            </a>
          </p>
          <p>
            <EditableText
              entry="layout.footer"
              field="rotuloCorreo"
              class="text-white/70 text-xs uppercase tracking-wide block mb-0.5"
            >
              {rotulo.correo}
            </EditableText>
            <a
              href={`mailto:${company.email}`}
              class="inline-flex min-h-[24px] items-center hover:text-white no-underline transition-colors duration-fast break-all"
            >
              <EditableText entry="site.company" field="email">
                {company.email.split('@')[0]}@<wbr />{company.email.split('@')[1]}
              </EditableText>
            </a>
          </p>
        </div>
      </details>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div
      class="w-full mx-auto px-6 max-w-container py-5 flex flex-col sm:flex-row items-center justify-between gap-3"
    >
      <p class="text-xs text-white/70">
        &copy; {year}
        {
          /* La razón social se muestra sin su punto final, así que no se marca:
            al editarla aquí saldría «S.A..». Se cambia en Textos del sitio →
            Datos de la empresa. */
        }
        {company.razonSocial.replace(/\.+$/, '')}.{' '}
        <EditableText entry="layout.footer" field="derechos">{rotulo.derechos}</EditableText>
      </p>
      <p class="text-xs text-white/60">
        <EditableText entry="layout.footer" field="location">
          {getCmsText('layout.footer', 'location', 'Los Ángeles, Región del Biobío, Chile')}
        </EditableText>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-section summary::-webkit-details-marker {
    display: none;
  }

  .footer-section[open] .footer-chevron {
    transform: rotate(45deg);
  }

  @media (min-width: 768px) {
    .footer-section > summary {
      pointer-events: none;
      cursor: default;
    }
  }

  /* B3-001: focus-visible consistente para todos los enlaces y botones del footer.
     Outline en accent (cyan) para contrastar sobre el fondo oscuro background-strong. */
  footer :where(a, button, summary):focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 0;
  }
</style>

<script>
  const footerSections = document.querySelectorAll<HTMLDetailsElement>('.footer-section');
  const desktopFooter = window.matchMedia('(min-width: 768px)');

  function syncFooterSections(event: MediaQueryList | MediaQueryListEvent) {
    footerSections.forEach((section) => {
      section.open = event.matches;
    });
  }

  syncFooterSections(desktopFooter);
  desktopFooter.addEventListener('change', syncFooterSections);
</script>
