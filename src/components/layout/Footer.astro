---
import { company } from '../../data/company';

const year = new Date().getFullYear();
---

<footer class="bg-background-strong text-white">
  <!-- Main footer -->
  <div class="w-full mx-auto px-6 max-w-container py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <p class="font-heading text-xl font-bold text-white mb-3">Hidromont Chile S.A.</p>
        <p class="text-sm text-white/70 leading-relaxed mb-6 max-w-sm">
          Ingeniería, fabricación y montaje de equipos hidromecánicos para embalses y centrales
          hidroeléctricas. Desde 1983 ejecutando proyectos complejos con precisión industrial.
        </p>
        <div class="space-y-2 text-sm text-white/70">
          <p>
            <span class="text-white/40 text-xs uppercase tracking-wide block mb-0.5">Dirección</span>
            {company.domicilio}<br />{company.ciudad}
          </p>
        </div>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wide mb-4">Servicios</h3>
        <ul class="space-y-2">
          <li><a href="/servicios/tuberias-forzadas" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Tuberías Forzadas</a></li>
          <li><a href="/servicios/compuertas" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Compuertas</a></li>
          <li><a href="/servicios/valvulas" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Válvulas</a></li>
          <li><a href="/servicios/turbinas" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Turbinas</a></li>
          <li><a href="/servicios/limpiarrejas" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Limpiarrejas</a></li>
          <li><a href="/servicios/otros-montajes" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Montajes Especiales</a></li>
        </ul>
      </div>

      <!-- Empresa + Contacto -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wide mb-4">Empresa</h3>
        <ul class="space-y-2 mb-6">
          <li><a href="/empresa" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Quiénes somos</a></li>
          <li><a href="/proyectos" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Proyectos</a></li>
          <li><a href="/clientes" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Clientes</a></li>
          <li><a href="/calidad" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Calidad</a></li>
          <li><a href="/contacto" class="text-sm text-white/70 hover:text-white no-underline transition-colors duration-fast">Contacto</a></li>
        </ul>

        <h3 class="text-sm font-semibold text-white uppercase tracking-wide mb-3">Contacto</h3>
        <div class="space-y-1 text-sm text-white/70">
          <p>
            <a href={`tel:${company.telefono.replace(/\s/g, '')}`} class="hover:text-white no-underline transition-colors duration-fast">
              {company.telefono}
            </a>
          </p>
          <p>
            <a href={`mailto:${company.email}`} class="hover:text-white no-underline transition-colors duration-fast">
              {company.email}
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="w-full mx-auto px-6 max-w-container py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-white/40">
        &copy; {year} {company.razonSocial}. Todos los derechos reservados.
      </p>
      <p class="text-xs text-white/30">
        Los Ángeles, Región del Biobío, Chile
      </p>
    </div>
  </div>
</footer>
