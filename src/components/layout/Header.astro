---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/logo_hidromont.png';
import { navItems, ctaLabel, ctaHref } from '../../data/nav';
import Button from '../ui/Button.astro';
import EditableText from '../cms/EditableText.astro';
import EditableImage from '../cms/EditableImage.astro';
import { getCmsText } from '../../data/cms';

const cmsLogoSrc = getCmsText('layout.header', 'logoSrc', '');
const cmsLogoAlt = getCmsText('layout.header', 'logoAlt', 'Hidromont Chile');
// Medido en el navegador: el logo mide 107 px de ancho en móvil y 133 px en
// escritorio. Sin `sizes`, el navegador asume el ancho de la ventana y elige
// el candidato de 1.600 px del srcset para pintar 133 px.
const LOGO_SIZES = '133px';
const cmsEditingEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';

interface Props {
  currentPath?: string;
  overlay?: boolean;
}

const { currentPath = '/', overlay = false } = Astro.props;

const mobileMenuOpenLabel = getCmsText(
  'layout.header',
  'mobileMenuOpenLabel',
  'Abrir menú de navegación'
);

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

function isCurrent(href: string) {
  const normalizedPath = (path: string) => (path.length > 1 ? path.replace(/\/+$/, '') : path);
  return normalizedPath(currentPath) === normalizedPath(href);
}
---

<!--
  overlay=false (páginas internas): sticky, fondo blanco, bordes oscuros — idéntico al anterior.
  overlay=true (home): fixed transparente sobre el hero; al scroll >80px → clase is-scrolled → fondo blanco sólido.
-->
<header
  class={[
    'top-0 z-50 transition-[background-color,border-color,box-shadow,color] duration-[240ms] ease-standard',
    overlay
      ? 'fixed inset-x-0 bg-transparent border-b border-transparent'
      : 'sticky bg-white/90 backdrop-blur-md border-b border-border shadow-sm',
  ].join(' ')}
  data-overlay={overlay ? 'true' : undefined}
>
  <div class="w-full mx-auto px-6 max-w-container">
    <div class="flex items-center justify-between h-20 md:h-24">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-4 shrink-0 no-underline"
        aria-label={getCmsText('layout.header', 'logoAriaLabel', 'Hidromont Chile — Inicio')}
      >
        {
          cmsLogoSrc ? (
            <EditableImage
              entry="layout.header"
              field="logoSrc"
              altField="logoAlt"
              src={cmsLogoSrc}
              alt={cmsLogoAlt}
              width={1181}
              height={708}
              sizes={LOGO_SIZES}
              class={[
                'h-16 md:h-20 w-auto object-contain transition-[filter] duration-[240ms] ease-standard',
                overlay ? 'logo-img' : '',
              ].join(' ')}
              loading="eager"
            />
          ) : (
            <Image
              src={logo}
              alt={cmsLogoAlt}
              width={1181}
              height={708}
              sizes={LOGO_SIZES}
              class={[
                'h-16 md:h-20 w-auto object-contain transition-[filter] duration-[240ms] ease-standard',
                overlay ? 'logo-img' : '',
              ].join(' ')}
              loading="eager"
              {...(cmsEditingEnabled
                ? {
                    'data-cms-entry': 'layout.header',
                    'data-cms-field': 'logoSrc',
                    'data-cms-alt-field': 'logoAlt',
                    'data-cms-type': 'image',
                  }
                : {})}
            />
          )
        }
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-1">
        {
          navItems.map((item) =>
            item.children ? (
              <div class="relative group" data-dropdown-group>
                <div
                  class={[
                    'flex items-center rounded-none transition-colors duration-fast ease-standard',
                    overlay
                      ? `nav-link hover:bg-white/10 ${isActive(item.href) ? 'text-white' : 'text-white/90'}`
                      : `hover:bg-primary-light ${isActive(item.href) ? 'text-primary nav-active-indicator' : 'text-text'}`,
                  ].join(' ')}
                >
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class={`pl-4 pr-1 py-2 text-sm font-semibold font-body no-underline focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary ${overlay ? 'hover:text-white' : 'hover:text-primary-dark'}`}
                  >
                    <EditableText entry="layout.header" field={item.cmsField}>
                      {item.label}
                    </EditableText>
                  </a>
                  <button
                    type="button"
                    class="dropdown-toggle-btn flex items-center justify-center pl-1 pr-3 py-2 focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary"
                    aria-expanded="false"
                    aria-controls={`dropdown-panel-${item.cmsField}`}
                    aria-label={`Mostrar submenú de ${item.label}`}
                    data-dropdown-toggle
                  >
                    <svg
                      class="w-3 h-3 dropdown-chevron"
                      viewBox="0 0 12 12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M2 4l4 4 4-4" />
                    </svg>
                  </button>
                </div>
                <div
                  id={`dropdown-panel-${item.cmsField}`}
                  class="dropdown-panel absolute top-full left-0 w-56 bg-white border border-border rounded-none shadow-md transition-[opacity,visibility] duration-base ease-standard z-dropdown"
                >
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      aria-current={isCurrent(child.href) ? 'page' : undefined}
                      class={`flex min-h-11 items-center px-4 py-2.5 text-sm font-body no-underline transition-colors duration-fast hover:bg-primary-light hover:text-primary-dark first:rounded-none last:rounded-none focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary ${isActive(child.href) ? 'text-primary font-semibold' : 'text-text'}`}
                    >
                      <EditableText
                        entry={child.cmsEntry ?? 'layout.header'}
                        field={child.cmsField}
                      >
                        {child.label}
                      </EditableText>
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class={[
                  'px-4 py-2 text-sm font-semibold font-body rounded-none transition-colors duration-fast ease-standard no-underline focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary',
                  overlay
                    ? `nav-link hover:bg-white/10 hover:text-white ${isActive(item.href) ? 'text-white' : 'text-white/90'}`
                    : `hover:bg-primary-light hover:text-primary-dark ${isActive(item.href) ? 'text-primary nav-active-indicator' : 'text-text'}`,
                ].join(' ')}
              >
                <EditableText entry="layout.header" field={item.cmsField}>
                  {item.label}
                </EditableText>
              </a>
            )
          )
        }
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <Button href={ctaHref} size="md">
          <EditableText entry="layout.header" field="ctaLabel">{ctaLabel}</EditableText>
        </Button>
      </div>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        type="button"
        class={[
          'lg:hidden flex items-center justify-center w-11 h-11 rounded-none transition-colors duration-fast focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary',
          overlay ? 'text-white hover:bg-white/10 toggle-btn' : 'text-text hover:bg-primary-light',
        ].join(' ')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={mobileMenuOpenLabel}
      >
        <svg
          id="icon-menu"
          class="w-6 h-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="icon-close"
          class="w-6 h-6 hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M6 18L18 6"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu (siempre fondo blanco cuando se abre) -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-border bg-white">
    <nav aria-label="Navegación móvil" class="px-4 py-4 space-y-1">
      {
        navItems.map((item) =>
          item.children ? (
            <details class="group">
              <summary
                class={`flex min-h-11 items-center justify-between w-full px-3 py-2.5 text-sm font-semibold font-body rounded-none cursor-pointer list-none transition-colors hover:bg-primary-light focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary ${isActive(item.href) ? 'text-primary' : 'text-text'}`}
              >
                <EditableText entry="layout.header" field={item.cmsField}>
                  {item.label}
                </EditableText>
                <svg
                  class="w-4 h-4 transition-transform group-open:rotate-180"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M2 4l4 4 4-4" />
                </svg>
              </summary>
              <div class="mt-1 ml-3 space-y-1 border-l-2 border-primary-light pl-3">
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class="flex min-h-11 items-center px-3 py-2 text-sm font-semibold font-body text-primary no-underline rounded-none transition-colors hover:bg-primary-light hover:text-primary-dark focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  Todos los servicios
                </a>
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    aria-current={isCurrent(child.href) ? 'page' : undefined}
                    class={`flex min-h-11 items-center px-3 py-2 text-sm font-body no-underline rounded-none transition-colors hover:bg-primary-light hover:text-primary-dark focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary ${isActive(child.href) ? 'text-primary font-semibold' : 'text-text-muted'}`}
                  >
                    <EditableText entry={child.cmsEntry ?? 'layout.header'} field={child.cmsField}>
                      {child.label}
                    </EditableText>
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class={`flex min-h-11 items-center px-3 py-2.5 text-sm font-semibold font-body rounded-none no-underline transition-colors hover:bg-primary-light hover:text-primary-dark focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary ${isActive(item.href) ? 'text-primary bg-primary-light' : 'text-text'}`}
            >
              <EditableText entry="layout.header" field={item.cmsField}>
                {item.label}
              </EditableText>
            </a>
          )
        )
      }
      <div class="pt-4 border-t border-border">
        <Button href={ctaHref} class="w-full justify-center">
          <EditableText entry="layout.header" field="ctaLabel">{ctaLabel}</EditableText>
        </Button>
      </div>
    </nav>
  </div>
</header>

<style>
  /* UIUX-4 fix: the submenu previously opened purely on CSS `group-hover`,
     with the label `<a>` doubling as an `aria-haspopup` trigger it couldn't
     actually operate (Enter just navigated to /servicios) — keyboard-only
     and non-hover pointer users had no way to open it. Now a dedicated
     `.dropdown-toggle-btn` drives `.is-open` via click/Escape (script below);
     hover/focus-within stay as a mouse convenience but no longer are the only
     way in. */
  .dropdown-panel {
    opacity: 0;
    visibility: hidden;
  }

  .dropdown-panel.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Without the dropdown script, show the service links as a regular list and
     hide the inactive disclosure button. The parent link still opens /servicios. */
  html:not(.js) .dropdown-panel {
    position: static;
    width: auto;
    margin: 0;
    border: 0;
    box-shadow: none;
    opacity: 1;
    visibility: visible;
  }

  html:not(.js) .dropdown-panel a {
    padding-left: 2rem;
  }

  html:not(.js) .dropdown-toggle-btn {
    display: none;
  }

  .dropdown-toggle-btn:hover {
    opacity: 0.75;
  }

  .dropdown-chevron {
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .dropdown-toggle-btn[aria-expanded='true'] .dropdown-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  /* ── Desktop dropdown disclosure (UIUX-4) ────────────────────
     `.dropdown-toggle-btn` is separate from the navigation link. Pointer
     entry, keyboard focus, click, and Escape all update `.is-open` through
     this script, keeping the visible panel and aria-expanded in sync. */
  document.querySelectorAll<HTMLButtonElement>('[data-dropdown-toggle]').forEach((toggleBtn) => {
    const group = toggleBtn.closest<HTMLElement>('[data-dropdown-group]');
    const panel = group?.querySelector<HTMLElement>('.dropdown-panel');
    if (!group || !panel) return;

    let pointerInside = false;
    let focusInside = false;
    let clickPinnedOpen = false;
    let escapeDismissed = false;

    function setOpen(open: boolean): void {
      panel!.classList.toggle('is-open', open);
      toggleBtn.setAttribute('aria-expanded', String(open));
    }

    group.addEventListener('pointerenter', () => {
      pointerInside = true;
      if (!escapeDismissed) setOpen(true);
    });

    group.addEventListener('pointerleave', () => {
      pointerInside = false;
      escapeDismissed = false;
      if (!focusInside && !clickPinnedOpen) setOpen(false);
    });

    group.addEventListener('focusin', () => {
      focusInside = true;
      if (!escapeDismissed) setOpen(true);
    });

    toggleBtn.addEventListener('click', () => {
      /*
       * Se decide sobre `clickPinnedOpen`, no sobre la clase del panel.
       *
       * Con ratón, para llegar al botón hay que pasar por encima del grupo, así
       * que `pointerenter` ya abrió el panel antes de que llegue el clic.
       * Alternando sobre `is-open`, el clic leía «ya está abierto» y lo cerraba:
       * apuntar a «Servicios» y pulsar el chevron cerraba el menú en la cara del
       * visitante. Con teclado pasaba igual vía `focusin`.
       *
       * Un clic sobre un panel que solo está abierto por hover lo fija abierto;
       * solo cierra si ya estaba fijado por un clic anterior.
       */
      const opening = !clickPinnedOpen;
      clickPinnedOpen = opening;
      escapeDismissed = false;
      setOpen(opening);
    });

    group.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && panel!.classList.contains('is-open')) {
        clickPinnedOpen = false;
        escapeDismissed = true;
        setOpen(false);
        toggleBtn.focus();
      }
    });

    group.addEventListener('focusout', (e: FocusEvent) => {
      const next = e.relatedTarget as HTMLElement | null;
      if (!next || !group.contains(next)) {
        focusInside = false;
        escapeDismissed = false;
        if (!pointerInside && !clickPinnedOpen) setOpen(false);
      }
    });

    document.addEventListener('click', (e: MouseEvent) => {
      if (panel!.classList.contains('is-open') && !group.contains(e.target as Node)) {
        clickPinnedOpen = false;
        escapeDismissed = false;
        setOpen(false);
      }
    });
  });

  /* ── Mobile menu toggle ───────────────────────────────────── */
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  // JS-L1/UIUX-5 fix: previously only toggled the `hidden` class — no focus
  // moved into the opened panel, Escape didn't close it, and the body kept
  // scrolling behind it.
  function setMobileMenuOpen(opening: boolean): void {
    menu?.classList.toggle('hidden', !opening);
    toggle?.setAttribute('aria-expanded', String(opening));
    toggle?.setAttribute(
      'aria-label',
      opening ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
    );
    iconMenu?.classList.toggle('hidden', opening);
    iconClose?.classList.toggle('hidden', !opening);
    document.body.classList.toggle('overflow-hidden', opening);

    if (opening) {
      const firstLink = menu?.querySelector<HTMLElement>('a, summary, button');
      firstLink?.focus();
    } else {
      (toggle as HTMLElement | null)?.focus();
    }
  }

  toggle?.addEventListener('click', () => {
    setMobileMenuOpen(!!menu?.classList.contains('hidden'));
  });

  menu?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') setMobileMenuOpen(false);
  });

  /* ── Overlay scroll behaviour (home only) ────────────────── */
  const headerEl = document.querySelector<HTMLElement>('header[data-overlay]');
  if (headerEl) {
    const header: HTMLElement = headerEl;
    const THRESHOLD = 80;
    let ticking = false;
    // JS-9 fix: starts `undefined` (not `false`) so the initial applyScrolled()
    // call below always actually applies a state, even when the page happens
    // to load already past THRESHOLD (restored scroll position, landing on an
    // anchor) — previously the header stayed stuck in the transparent/white-
    // on-white state until the first scroll event fired.
    let scrolled: boolean | undefined;

    // Elements that change colour on scroll
    const navLinks = header.querySelectorAll<HTMLElement>('.nav-link');
    const logoImg = header.querySelector<HTMLImageElement>('.logo-img');
    const toggleBtn = header.querySelector<HTMLElement>('.toggle-btn');

    function applyScrolled(yes: boolean) {
      if (yes === scrolled) return;
      scrolled = yes;

      if (yes) {
        // Solid white state
        header.classList.add('bg-white/90', 'backdrop-blur-md', 'border-border', 'shadow-sm');
        header.classList.remove('bg-transparent', 'border-transparent');
        navLinks.forEach((el) => {
          el.classList.remove(
            'text-white/90',
            'text-white',
            'hover:bg-white/10',
            'hover:text-white'
          );
          el.classList.add('text-text', 'hover:bg-primary-light', 'hover:text-primary-dark');
        });
        if (logoImg) logoImg.style.filter = '';
        if (toggleBtn) {
          toggleBtn.classList.remove('text-white', 'hover:bg-white/10');
          toggleBtn.classList.add('text-text', 'hover:bg-primary-light');
        }
      } else {
        // Transparent state
        header.classList.remove('bg-white/90', 'backdrop-blur-md', 'border-border', 'shadow-sm');
        header.classList.add('bg-transparent', 'border-transparent');
        navLinks.forEach((el) => {
          el.classList.add('text-white/90', 'hover:bg-white/10', 'hover:text-white');
          el.classList.remove(
            'text-text',
            'text-primary',
            'hover:bg-primary-light',
            'hover:text-primary-dark'
          );
        });
        if (logoImg) logoImg.style.filter = 'brightness(0) invert(1)';
        if (toggleBtn) {
          toggleBtn.classList.add('text-white', 'hover:bg-white/10');
          toggleBtn.classList.remove(
            'text-text',
            'text-primary',
            'hover:bg-primary-light',
            'hover:text-primary-dark'
          );
        }
      }
    }

    // Apply the correct initial state based on actual scroll position, rather
    // than always assuming transparent (see JS-9 fix above).
    applyScrolled(window.scrollY > THRESHOLD);

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            applyScrolled(window.scrollY > THRESHOLD);
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>
