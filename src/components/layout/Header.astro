---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/logo_hidromont.png';
import { navItems, ctaLabel, ctaHref } from '../../data/nav';
import Button from '../ui/Button.astro';
import EditableText from '../cms/EditableText.astro';
import EditableImage from '../cms/EditableImage.astro';
import { getCmsText } from '../../data/cms';

const cmsLogoSrc = getCmsText('layout.header', 'logoSrc', '');
const cmsLogoAlt = getCmsText('layout.header', 'logoAlt', 'Hidromont Chile');
const cmsEditingEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';

interface Props {
  currentPath?: string;
  overlay?: boolean;
}

const { currentPath = '/', overlay = false } = Astro.props;

const mobileMenuOpenLabel = getCmsText('layout.header', 'mobileMenuOpenLabel', 'Abrir menú de navegación');

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!--
  overlay=false (páginas internas): sticky, fondo blanco, bordes oscuros — idéntico al anterior.
  overlay=true (home): fixed transparente sobre el hero; al scroll >80px → clase is-scrolled → fondo blanco sólido.
-->
<header
  class={[
    'top-0 z-50 transition-[background-color,border-color,box-shadow,color] duration-[240ms] ease-standard',
    overlay
      ? 'fixed inset-x-0 bg-transparent border-b border-transparent'
      : 'sticky bg-white/90 backdrop-blur-md border-b border-border shadow-sm',
  ].join(' ')}
  data-overlay={overlay ? 'true' : undefined}
>
  <div class="w-full mx-auto px-6 max-w-container">
    <div class="flex items-center justify-between h-20 md:h-24">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-4 shrink-0 no-underline" aria-label={getCmsText('layout.header', 'logoAriaLabel', 'Hidromont Chile — Inicio')}>
        {cmsLogoSrc ? (
          <EditableImage
            entry="layout.header"
            field="logoSrc"
            altField="logoAlt"
            src={cmsLogoSrc}
            alt={cmsLogoAlt}
            width={1181}
            height={708}
            class={[
              'h-16 md:h-20 w-auto object-contain transition-[filter] duration-[240ms] ease-standard',
              overlay ? 'logo-img' : '',
            ].join(' ')}
            loading="eager"
          />
        ) : (
          <Image
            src={logo}
            alt={cmsLogoAlt}
            width={1181}
            height={708}
            class={[
              'h-16 md:h-20 w-auto object-contain transition-[filter] duration-[240ms] ease-standard',
              overlay ? 'logo-img' : '',
            ].join(' ')}
            loading="eager"
            {...(cmsEditingEnabled ? {
              'data-cms-entry': 'layout.header',
              'data-cms-field': 'logoSrc',
              'data-cms-alt-field': 'logoAlt',
              'data-cms-type': 'image',
            } : {})}
          />
        )}

      </a>

      <!-- Desktop nav -->
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          item.children ? (
            <div class="relative group">
              <a
                href={item.href}
                class={[
                  'px-4 py-2 text-sm font-semibold font-body rounded-none transition-colors duration-fast ease-standard no-underline focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary',
                  overlay
                    ? `nav-link hover:bg-white/10 hover:text-white ${isActive(item.href) ? 'text-white' : 'text-white/90'}`
                    : `hover:bg-primary-light hover:text-primary-dark ${isActive(item.href) ? 'text-primary nav-active-indicator' : 'text-text'}`,
                ].join(' ')}
                aria-haspopup="true"
                aria-expanded="false"
                data-dropdown-trigger
              >
                <EditableText entry="layout.header" field={item.cmsField}>{item.label}</EditableText>
                <svg class="inline-block ml-1 w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M2 4l4 4 4-4" />
                </svg>
              </a>
              <div class="absolute top-full left-0 mt-1 w-56 bg-white border border-border rounded-none shadow-md opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-[opacity,visibility] duration-base ease-standard z-dropdown">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class={`block px-4 py-2.5 text-sm font-body no-underline transition-colors duration-fast hover:bg-primary-light hover:text-primary-dark first:rounded-none last:rounded-none focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary ${isActive(child.href) ? 'text-primary font-semibold' : 'text-text'}`}
                  >
                    <EditableText entry="layout.header" field={child.cmsField}>{child.label}</EditableText>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class={[
                'px-4 py-2 text-sm font-semibold font-body rounded-none transition-colors duration-fast ease-standard no-underline focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary',
                overlay
                  ? `nav-link hover:bg-white/10 hover:text-white ${isActive(item.href) ? 'text-white' : 'text-white/90'}`
                  : `hover:bg-primary-light hover:text-primary-dark ${isActive(item.href) ? 'text-primary nav-active-indicator' : 'text-text'}`,
              ].join(' ')}
            >
              <EditableText entry="layout.header" field={item.cmsField}>{item.label}</EditableText>
            </a>
          )
        ))}
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <Button href={ctaHref} size="md">
          <EditableText entry="layout.header" field="ctaLabel">{ctaLabel}</EditableText>
        </Button>
      </div>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        type="button"
        class={[
          'lg:hidden flex items-center justify-center w-11 h-11 rounded-none transition-colors duration-fast focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary',
          overlay ? 'text-white hover:bg-white/10 toggle-btn' : 'text-text hover:bg-primary-light',
        ].join(' ')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={mobileMenuOpenLabel}
      >
        <svg id="icon-menu" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M6 6l12 12M6 18L18 6" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu (siempre fondo blanco cuando se abre) -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-border bg-white">
    <nav aria-label="Navegación móvil" class="px-4 py-4 space-y-1">
      {navItems.map((item) => (
        item.children ? (
          <details class="group">
            <summary class={`flex items-center justify-between w-full px-3 py-2.5 text-sm font-semibold font-body rounded-none cursor-pointer list-none transition-colors hover:bg-primary-light focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary ${isActive(item.href) ? 'text-primary' : 'text-text'}`}>
              <EditableText entry="layout.header" field={item.cmsField}>{item.label}</EditableText>
              <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M2 4l4 4 4-4" />
              </svg>
            </summary>
            <div class="mt-1 ml-3 space-y-1 border-l-2 border-primary-light pl-3">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class={`block px-3 py-2 text-sm font-body no-underline rounded-none transition-colors hover:bg-primary-light hover:text-primary-dark focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary ${isActive(child.href) ? 'text-primary font-semibold' : 'text-text-muted'}`}
                >
                  <EditableText entry="layout.header" field={child.cmsField}>{child.label}</EditableText>
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            class={`block px-3 py-2.5 text-sm font-semibold font-body rounded-none no-underline transition-colors hover:bg-primary-light hover:text-primary-dark focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary ${isActive(item.href) ? 'text-primary bg-primary-light' : 'text-text'}`}
          >
            <EditableText entry="layout.header" field={item.cmsField}>{item.label}</EditableText>
          </a>
        )
      ))}
      <div class="pt-4 border-t border-border">
        <Button href={ctaHref} class="w-full justify-center">
          <EditableText entry="layout.header" field="ctaLabel">{ctaLabel}</EditableText>
        </Button>
      </div>
    </nav>
  </div>
</header>

<script>
  /* ── Desktop dropdown aria-expanded (B2-003) ──────────────── */
  /* El dropdown se abre via CSS group-hover/group-focus-within; aqui sincronizamos
     el estado aria-expanded del trigger para que los lectores de pantalla anuncien
     la apertura/cierre. */
  document.querySelectorAll<HTMLElement>('[data-dropdown-trigger]').forEach((trigger) => {
    const group = trigger.closest('.group');
    if (!group) return;
    const setOpen = (open: boolean) => trigger.setAttribute('aria-expanded', String(open));
    group.addEventListener('mouseenter', () => setOpen(true));
    group.addEventListener('mouseleave', () => setOpen(false));
    trigger.addEventListener('focus', () => setOpen(true));
    trigger.addEventListener('blur', (event) => {
      // Cierra solo si el foco sale del grupo entero (no al saltar a un item del dropdown).
      const next = event.relatedTarget as HTMLElement | null;
      if (!next || !group.contains(next)) setOpen(false);
    });
  });

  /* ── Mobile menu toggle ───────────────────────────────────── */
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    const opening = !isOpen;
    toggle.setAttribute('aria-expanded', String(opening));
    toggle.setAttribute('aria-label', opening ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    iconMenu?.classList.toggle('hidden', opening);
    iconClose?.classList.toggle('hidden', !opening);
  });

  /* ── Overlay scroll behaviour (home only) ────────────────── */
  const headerEl = document.querySelector<HTMLElement>('header[data-overlay]');
  if (headerEl) {
    const header: HTMLElement = headerEl;
    const THRESHOLD = 80;
    let ticking = false;
    let scrolled = false;

    // Elements that change colour on scroll
    const navLinks = header.querySelectorAll<HTMLElement>('.nav-link');
    const logoImg = header.querySelector<HTMLImageElement>('.logo-img');
    const toggleBtn = header.querySelector<HTMLElement>('.toggle-btn');

    function applyScrolled(yes: boolean) {
      if (yes === scrolled) return;
      scrolled = yes;

      if (yes) {
        // Solid white state
        header.classList.add('bg-white/90', 'backdrop-blur-md', 'border-border', 'shadow-sm');
        header.classList.remove('bg-transparent', 'border-transparent');
        navLinks.forEach((el) => {
          el.classList.remove('text-white/90', 'text-white', 'hover:bg-white/10', 'hover:text-white');
          el.classList.add('text-text', 'hover:bg-primary-light', 'hover:text-primary-dark');
        });
        if (logoImg) logoImg.style.filter = '';
        if (toggleBtn) {
          toggleBtn.classList.remove('text-white', 'hover:bg-white/10');
          toggleBtn.classList.add('text-text', 'hover:bg-primary-light');
        }
      } else {
        // Transparent state
        header.classList.remove('bg-white/90', 'backdrop-blur-md', 'border-border', 'shadow-sm');
        header.classList.add('bg-transparent', 'border-transparent');
        navLinks.forEach((el) => {
          el.classList.add('text-white/90', 'hover:bg-white/10', 'hover:text-white');
          el.classList.remove('text-text', 'text-primary', 'hover:bg-primary-light', 'hover:text-primary-dark');
        });
        if (logoImg) logoImg.style.filter = 'brightness(0) invert(1)';
        if (toggleBtn) {
          toggleBtn.classList.add('text-white', 'hover:bg-white/10');
          toggleBtn.classList.remove('text-text', 'text-primary', 'hover:bg-primary-light', 'hover:text-primary-dark');
        }
      }
    }

    // Apply initial clean filter on load (transparent state)
    if (logoImg) logoImg.style.filter = 'brightness(0) invert(1)';

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          applyScrolled(window.scrollY > THRESHOLD);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
</script>
