---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/logo_hidromont.png';
import { navItems, ctaLabel, ctaHref } from '../../data/nav';
import Button from '../ui/Button.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-white border-b border-border shadow-sm">
  <div class="w-full mx-auto px-6 max-w-container">
    <div class="flex items-center justify-between h-24">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-4 shrink-0 no-underline" aria-label="Hidromont Chile — Inicio">
        <Image
          src={logo}
          alt="Hidromont Chile S.A."
          width={300}
          height={100}
          class="h-20 w-auto object-contain"
          loading="eager"
        />
        <div class="flex flex-col leading-tight">
          <span class="font-heading font-bold text-primary-dark tracking-wide" style="font-size: 1.45rem; line-height: 1.15;">HIDROMONT</span>
          <span class="font-body text-text-muted tracking-widest uppercase" style="font-size: 0.75rem; letter-spacing: 0.18em;">Chile S.A.</span>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          item.children ? (
            <div class="relative group">
              <a
                href={item.href}
                class={`px-4 py-2 text-sm font-semibold font-body rounded-md transition-colors duration-fast ease-standard hover:bg-primary-light hover:text-primary-dark no-underline ${isActive(item.href) ? 'text-primary' : 'text-text'}`}
              >
                {item.label}
                <svg class="inline-block ml-1 w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M2 4l4 4 4-4" />
                </svg>
              </a>
              <div class="absolute top-full left-0 mt-1 w-56 bg-white border border-border rounded-lg shadow-md opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-[opacity,visibility] duration-base ease-standard z-10">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class={`block px-4 py-2.5 text-sm font-body no-underline transition-colors duration-fast hover:bg-primary-light hover:text-primary-dark first:rounded-t-lg last:rounded-b-lg ${isActive(child.href) ? 'text-primary font-semibold' : 'text-text'}`}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class={`px-4 py-2 text-sm font-semibold font-body rounded-md transition-colors duration-fast ease-standard hover:bg-primary-light hover:text-primary-dark no-underline ${isActive(item.href) ? 'text-primary' : 'text-text'}`}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <Button href={ctaHref} size="md">{ctaLabel}</Button>
      </div>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden flex items-center justify-center w-11 h-11 rounded-md text-text hover:bg-primary-light transition-colors duration-fast"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <svg id="icon-menu" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M6 6l12 12M6 18L18 6" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-border bg-white">
    <nav aria-label="Navegación móvil" class="px-4 py-4 space-y-1">
      {navItems.map((item) => (
        item.children ? (
          <details class="group">
            <summary class={`flex items-center justify-between w-full px-3 py-2.5 text-sm font-semibold font-body rounded-md cursor-pointer list-none transition-colors hover:bg-primary-light ${isActive(item.href) ? 'text-primary' : 'text-text'}`}>
              {item.label}
              <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M2 4l4 4 4-4" />
              </svg>
            </summary>
            <div class="mt-1 ml-3 space-y-1 border-l-2 border-primary-light pl-3">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class={`block px-3 py-2 text-sm font-body no-underline rounded-md transition-colors hover:bg-primary-light hover:text-primary-dark ${isActive(child.href) ? 'text-primary font-semibold' : 'text-text-muted'}`}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            class={`block px-3 py-2.5 text-sm font-semibold font-body rounded-md no-underline transition-colors hover:bg-primary-light hover:text-primary-dark ${isActive(item.href) ? 'text-primary bg-primary-light' : 'text-text'}`}
          >
            {item.label}
          </a>
        )
      ))}
      <div class="pt-4 border-t border-border">
        <Button href={ctaHref} class="w-full justify-center">{ctaLabel}</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
    iconMenu?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });
</script>
