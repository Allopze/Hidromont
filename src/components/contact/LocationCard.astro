---
import { company } from '../../data/company';
import EditableText from '../cms/EditableText.astro';
import { getCmsText } from '../../data/cms';

interface Props {
  theme?: 'light' | 'dark';
  class?: string;
  titleId?: string;
  /**
   * Enlace a las indicaciones. En el pie se omite para evitar repetir una
   * acción en todas las páginas; en /contacto ayuda a planificar la visita.
   */
  showDirections?: boolean;
  /** Mapa de Google incrustado (solo desde md; en móvil se ve el panel con el enlace). */
  showEmbeddedMap?: boolean;
}

const {
  theme = 'light',
  class: className = '',
  titleId = 'location-card-title',
  showDirections = true,
  showEmbeddedMap = true,
} = Astro.props;

const destino = 'Hidromont Chile S.A., Avenida Las Industrias 10950, Los Ángeles, Chile';
// Textos del recuadro (Textos del sitio → Recuadro de ubicación).
const texto = {
  titulo: getCmsText('contact.ubicacion', 'ubicacionTitulo', 'Hidromont Chile'),
  mapaTitulo: getCmsText('contact.ubicacion', 'mapaTitulo', 'Ubicación de Hidromont Chile'),
  mapaLugar: getCmsText('contact.ubicacion', 'mapaLugar', 'Los Ángeles, Región del Biobío'),
  mapaEnlace: getCmsText('contact.ubicacion', 'mapaEnlace', 'Abrir en Google Maps'),
  mapaDescripcion: getCmsText(
    'contact.ubicacion',
    'mapaDescripcion',
    'Mapa de la ubicación de Hidromont Chile en Los Ángeles, Región del Biobío'
  ),
};
const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(destino)}`;
// Forma sin clave del embed de Google Maps: no requiere API key ni facturación.
// El dominio ya está autorizado en el CSP de public/_headers (frame-src).
const embedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(destino)}&z=15&hl=es&output=embed`;
---

<section
  class:list={[
    'location-card flex flex-col overflow-hidden border',
    theme === 'dark' ? 'border-white/15 bg-white/5 text-white' : 'border-border bg-white',
    className,
  ]}
  aria-labelledby={titleId}
>
  <div
    class:list={[
      'relative flex min-h-[160px] flex-1 items-stretch',
      /*
       * El fondo tiene que seguir al tema. Estaba fijo en `bg-background-alt`
       * (#F5F8FA, casi blanco), así que en el pie —que es `bg-background-strong`
       * y pide `theme="dark"`— se pintaba una caja clara con el texto blanco de
       * abajo encima: ratio 1.05, es decir invisible, en todas las páginas que
       * muestran el pie con mapa. En oscuro se deja transparente para que se vea
       * el `bg-white/5` de la propia tarjeta sobre el azul del pie.
       */
      theme === 'dark' ? 'bg-transparent' : 'bg-background-alt',
      showEmbeddedMap && 'md:min-h-[260px]',
    ]}
  >
    {
      showEmbeddedMap && (
        <iframe
          src={embedUrl}
          title={texto.mapaDescripcion}
          class:list={[
            'absolute inset-0 hidden h-full w-full border-0 md:block',
            theme === 'dark' && 'map-dark',
          ]}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      )
    }
    <div
      class:list={[
        'absolute inset-0 flex flex-col items-center justify-center gap-3 px-5 py-6 text-center',
        theme === 'dark' ? 'bg-white/5 text-white' : 'bg-background-alt text-primary-dark',
        showEmbeddedMap && 'md:hidden',
      ]}
    >
      <svg
        class="h-8 w-8 text-accent"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path d="M19 10.2c0 5.2-7 11-7 11s-7-5.8-7-11a7 7 0 1 1 14 0Z"></path>
        <circle cx="12" cy="10" r="2.2"></circle>
      </svg>
      <EditableText
        as="p"
        entry="contact.ubicacion"
        field="mapaTitulo"
        class="font-heading text-base font-bold"
      >
        {texto.mapaTitulo}
      </EditableText>
      <EditableText
        as="p"
        entry="contact.ubicacion"
        field="mapaLugar"
        class={`text-sm ${theme === 'dark' ? 'text-white/75' : 'text-text-muted'}`}
      >
        {texto.mapaLugar}
      </EditableText>
      {
        // En móvil el mapa no se incrusta: sin «Cómo llegar» al lado (el pie),
        // este enlace es la única forma de abrirlo.
        (!showEmbeddedMap || !showDirections) && (
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'inline-flex min-h-[44px] items-center justify-center border px-3 text-xs font-semibold no-underline transition-colors focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent',
              theme === 'dark'
                ? 'border-white/30 text-white hover:bg-white/10'
                : 'border-primary text-primary-dark hover:bg-white',
            ]}
          >
            <EditableText entry="contact.ubicacion" field="mapaEnlace">
              {texto.mapaEnlace}
            </EditableText>
          </a>
        )
      }
    </div>
  </div>

  <div class="p-4 md:p-5">
    <h2
      id={titleId}
      class:list={[
        'font-heading text-base font-bold leading-tight',
        theme === 'dark' ? 'text-white' : 'text-primary-dark',
      ]}
    >
      <EditableText entry="contact.ubicacion" field="ubicacionTitulo">{texto.titulo}</EditableText>
    </h2>
    <p
      class:list={[
        'mt-1 text-xs leading-snug',
        theme === 'dark' ? 'text-white/75' : 'text-text-muted',
      ]}
    >
      <EditableText entry="site.company" field="domicilio">{company.domicilio}</EditableText><br
      /><EditableText entry="site.company" field="ciudad">{company.ciudad}</EditableText>
    </p>
    {
      showDirections && (
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'mt-3 inline-flex min-h-[44px] w-fit items-center justify-center border px-3 py-1.5 text-xs font-semibold no-underline transition-colors focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent',
            theme === 'dark'
              ? 'border-white/30 text-white hover:bg-white/10'
              : 'border-primary text-primary-dark hover:bg-white',
          ]}
        >
          <EditableText entry="contact.ubicacion" field="mapaEnlace">
            {texto.mapaEnlace}
          </EditableText>
        </a>
      )
    }
  </div>
</section>

<style>
  /* En el pie, sobre fondo azul oscuro, un mapa a todo color desentona. El
     filtro lo oscurece manteniendo legibles calles y etiquetas. */
  .map-dark {
    filter: invert(90%) hue-rotate(180deg) grayscale(0.2) contrast(1.1);
  }
</style>
