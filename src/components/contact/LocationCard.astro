---
import { company } from '../../data/company';

interface Props {
  theme?: 'light' | 'dark';
  class?: string;
}

const { theme = 'light', class: className = '' } = Astro.props;
const mapsUrl =
  'https://www.google.com/maps/dir/?api=1&destination=Hidromont+Chile+S.A.,+Avenida+Las+Industrias+10950,+Los+Angeles,+Chile';
---

<section
  class:list={[
    'location-card relative isolate flex min-h-[260px] flex-col justify-end overflow-hidden border p-6 md:p-8',
    theme === 'dark'
      ? 'border-white/15 bg-white/5 text-white'
      : 'border-border bg-primary-light text-primary-dark',
    className,
  ]}
  aria-labelledby="location-card-title"
>
  <div class="location-grid absolute inset-0 -z-10 opacity-40" aria-hidden="true"></div>
  <div
    class:list={[
      'mb-auto inline-flex h-12 w-12 items-center justify-center border',
      theme === 'dark' ? 'border-white/20 bg-background-strong' : 'border-primary/20 bg-white',
    ]}
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 24 24"
      class="h-6 w-6 text-primary"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M20 10c0 5.5-8 12-8 12S4 15.5 4 10a8 8 0 1 1 16 0Z"></path>
      <circle cx="12" cy="10" r="2.5"></circle>
    </svg>
  </div>
  <h2 id="location-card-title" class="mt-8 font-heading text-xl font-bold">Hidromont Chile</h2>
  <p
    class:list={[
      'mt-2 text-sm leading-relaxed',
      theme === 'dark' ? 'text-white/75' : 'text-text-muted',
    ]}
  >
    {company.domicilio}<br />{company.ciudad}
  </p>
  <a
    href={mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      'mt-5 inline-flex min-h-[44px] w-fit items-center justify-center border px-4 py-2 text-sm font-semibold no-underline transition-colors focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-accent',
      theme === 'dark'
        ? 'border-white/30 text-white hover:bg-white/10'
        : 'border-primary text-primary-dark hover:bg-white',
    ]}
  >
    Abrir en Google Maps
  </a>
</section>

<style>
  .location-grid {
    background-image:
      linear-gradient(30deg, transparent 48%, currentColor 49%, currentColor 51%, transparent 52%),
      linear-gradient(120deg, transparent 48%, currentColor 49%, currentColor 51%, transparent 52%);
    background-size: 72px 72px;
    color: var(--color-primary);
  }
</style>
