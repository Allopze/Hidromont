---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const redirectTo = '/contacto/gracias';

const servicios = [
  'Tuberías Forzadas y Blindajes',
  'Compuertas',
  'Válvulas Hidráulicas',
  'Turbinas Hidráulicas',
  'Limpiarrejas',
  'Montajes y Fabricaciones Especiales',
  'Otro',
];
---

<form
  id="contacto-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="space-y-6"
  novalidate
>
  <!-- Web3Forms config -->
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Nuevo contacto desde hidromont.cl" />
  <input type="hidden" name="from_name" value="Sitio web Hidromont Chile" />
  <input type="hidden" name="redirect" value={new URL(redirectTo, Astro.site ?? 'https://hidromont.cl').toString()} />
  <!-- Honeypot anti-spam -->
  <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Nombre -->
    <div>
      <label for="nombre" class="block text-sm font-semibold text-text mb-1.5">
        Nombre <span class="text-error" aria-hidden="true">*</span>
      </label>
      <input
        id="nombre"
        name="nombre"
        type="text"
        required
        minlength="2"
        autocomplete="name"
        placeholder="Su nombre completo"
        aria-describedby="nombre-error"
        class="w-full min-h-[44px] border border-border rounded-md px-3.5 py-3 text-text bg-white text-sm transition-[border-color,outline] duration-fast focus:border-primary focus:outline focus:outline-[3px] focus:outline-primary/20"
      />
      <p id="nombre-error" class="mt-1.5 text-xs text-error hidden" aria-live="polite"></p>
    </div>

    <!-- Empresa -->
    <div>
      <label for="empresa" class="block text-sm font-semibold text-text mb-1.5">Empresa</label>
      <input
        id="empresa"
        name="empresa"
        type="text"
        autocomplete="organization"
        placeholder="Nombre de su empresa"
        class="w-full min-h-[44px] border border-border rounded-md px-3.5 py-3 text-text bg-white text-sm transition-[border-color,outline] duration-fast focus:border-primary focus:outline focus:outline-[3px] focus:outline-primary/20"
      />
    </div>

    <!-- Email -->
    <div>
      <label for="email" class="block text-sm font-semibold text-text mb-1.5">
        Correo electrónico <span class="text-error" aria-hidden="true">*</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="correo@empresa.com"
        aria-describedby="email-error"
        class="w-full min-h-[44px] border border-border rounded-md px-3.5 py-3 text-text bg-white text-sm transition-[border-color,outline] duration-fast focus:border-primary focus:outline focus:outline-[3px] focus:outline-primary/20"
      />
      <p id="email-error" class="mt-1.5 text-xs text-error hidden" aria-live="polite"></p>
    </div>

    <!-- Teléfono -->
    <div>
      <label for="telefono" class="block text-sm font-semibold text-text mb-1.5">Teléfono</label>
      <input
        id="telefono"
        name="telefono"
        type="tel"
        autocomplete="tel"
        placeholder="+56 9 1234 5678"
        class="w-full min-h-[44px] border border-border rounded-md px-3.5 py-3 text-text bg-white text-sm transition-[border-color,outline] duration-fast focus:border-primary focus:outline focus:outline-[3px] focus:outline-primary/20"
      />
    </div>
  </div>

  <!-- Servicio -->
  <div>
    <label for="servicio" class="block text-sm font-semibold text-text mb-1.5">Servicio requerido</label>
    <select
      id="servicio"
      name="servicio"
      class="w-full min-h-[44px] border border-border rounded-md px-3.5 py-3 text-text bg-white text-sm transition-[border-color,outline] duration-fast focus:border-primary focus:outline focus:outline-[3px] focus:outline-primary/20"
    >
      <option value="">Seleccione un servicio (opcional)</option>
      {servicios.map((s) => <option value={s}>{s}</option>)}
    </select>
  </div>

  <!-- Mensaje -->
  <div>
    <label for="mensaje" class="block text-sm font-semibold text-text mb-1.5">
      Mensaje <span class="text-error" aria-hidden="true">*</span>
    </label>
    <textarea
      id="mensaje"
      name="mensaje"
      required
      rows={5}
      maxlength={2000}
      placeholder="Describa su proyecto o consulta técnica."
      aria-describedby="mensaje-error"
      class="w-full border border-border rounded-md px-3.5 py-3 text-text bg-white text-sm leading-relaxed resize-y transition-[border-color,outline] duration-fast focus:border-primary focus:outline focus:outline-[3px] focus:outline-primary/20"
    ></textarea>
    <p id="mensaje-error" class="mt-1.5 text-xs text-error hidden" aria-live="polite"></p>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center gap-4">
    <button
      type="submit"
      class="inline-flex items-center justify-center gap-2 bg-primary text-white font-semibold font-body text-base px-6 py-3 min-h-[44px] rounded-md border border-primary hover:bg-primary-dark hover:border-primary-dark transition-[background-color,border-color] duration-base ease-standard focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary/30"
    >
      Enviar consulta
      <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M2 8h12M10 4l4 4-4 4" />
      </svg>
    </button>
    <p class="text-xs text-text-muted">
      Los campos marcados con <span class="text-error" aria-hidden="true">*</span> son obligatorios.
      Te contactaremos a la brevedad.
    </p>
  </div>
</form>

<script>
const form = document.getElementById('contacto-form') as HTMLFormElement | null;

const MENSAJES: Record<string, { valueMissing: string; typeMismatch?: string; tooShort?: string }> = {
  nombre:  { valueMissing: 'Por favor ingrese su nombre.', tooShort: 'El nombre debe tener al menos 2 caracteres.' },
  email:   { valueMissing: 'Por favor ingrese su correo electrónico.', typeMismatch: 'Ingrese un correo válido (ej. correo@empresa.com).' },
  mensaje: { valueMissing: 'Por favor escriba su consulta o mensaje.' },
};

function validateField(field: HTMLInputElement | HTMLTextAreaElement): boolean {
  const errorEl = document.getElementById(`${field.id}-error`);
  if (!errorEl) return field.validity.valid;

  let msg = '';
  if (field.validity.valueMissing)  msg = MENSAJES[field.id]?.valueMissing ?? 'Campo requerido.';
  else if (field.validity.typeMismatch) msg = MENSAJES[field.id]?.typeMismatch ?? 'Valor inválido.';
  else if (field.validity.tooShort) msg = MENSAJES[field.id]?.tooShort ?? 'Valor demasiado corto.';

  const invalid = !!msg;
  field.setAttribute('aria-invalid', String(invalid));
  errorEl.textContent = msg;
  errorEl.classList.toggle('hidden', !invalid);
  if (invalid) {
    field.classList.add('border-error', 'focus:border-error');
    field.classList.remove('border-border');
  } else {
    field.classList.remove('border-error', 'focus:border-error');
    field.classList.add('border-border');
  }
  return !invalid;
}

if (form) {
  const requiredFields = Array.from(
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')
  );

  requiredFields.forEach((field) => {
    field.addEventListener('blur', () => validateField(field));
    field.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') === 'true') validateField(field);
    });
  });

  form.addEventListener('submit', (e) => {
    let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;
    let allValid = true;
    requiredFields.forEach((field) => {
      const valid = validateField(field);
      if (!valid) {
        allValid = false;
        if (!firstInvalid) firstInvalid = field;
      }
    });
    if (!allValid) {
      e.preventDefault();
      (firstInvalid as HTMLElement | null)?.focus();
    }
  });
}
</script>
