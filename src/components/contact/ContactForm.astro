---
import EditableText from '../cms/EditableText.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';
import { getCmsText, getCmsValue } from '../../data/cms';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const redirectTo = '/contacto/gracias';

// Guard de build (FORM-001): el formulario de contacto es el único canal de
// conversión del sitio. Sin la clave de Web3Forms enviaría access_key="" y el
// visitante caería en un error externo en inglés — leads perdidos en silencio.
// Falla el build de producción de forma explícita; en dev se permite seguir.
if (import.meta.env.PROD && !accessKey) {
  throw new Error(
    '[build] Falta PUBLIC_WEB3FORMS_KEY. El formulario de contacto no puede ' +
      'enviarse sin la clave de Web3Forms. Defínala en el entorno de build ' +
      '(ver .env.example) antes de desplegar.'
  );
}

const servicios = getCmsValue<string[]>('contact.form', 'services', [
  'Tuberías Forzadas y Blindajes',
  'Compuertas',
  'Válvulas Hidráulicas',
  'Turbinas Hidráulicas',
  'Limpiarrejas',
  'Montajes y Fabricaciones Especiales',
  'Otro',
]);

const validationMessages = {
  nombre: {
    valueMissing: getCmsText('contact.form', 'nameRequiredError', 'Por favor ingrese su nombre.'),
    tooShort: getCmsText('contact.form', 'nameTooShortError', 'El nombre debe tener al menos 2 caracteres.'),
  },
  email: {
    valueMissing: getCmsText('contact.form', 'emailRequiredError', 'Por favor ingrese su correo electrónico.'),
    typeMismatch: getCmsText('contact.form', 'emailInvalidError', 'Ingrese un correo válido (ej. correo@empresa.com).'),
  },
  mensaje: {
    valueMissing: getCmsText('contact.form', 'messageRequiredError', 'Por favor escriba su consulta o mensaje.'),
  },
  generic: {
    valueMissing: getCmsText('contact.form', 'genericRequiredError', 'Campo requerido.'),
    typeMismatch: getCmsText('contact.form', 'genericInvalidError', 'Valor inválido.'),
    tooShort: getCmsText('contact.form', 'genericTooShortError', 'Valor demasiado corto.'),
  },
};
---

<form
  id="contacto-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="space-y-6"
  novalidate
>
  <!-- Web3Forms config -->
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={getCmsText('contact.form', 'subject', 'Nuevo contacto desde hidromont.cl')} />
  <input type="hidden" name="from_name" value={getCmsText('contact.form', 'fromName', 'Sitio web Hidromont Chile')} />
  <input type="hidden" name="redirect" value={new URL(redirectTo, Astro.site ?? 'https://hidromont.cl').toString()} />
  <!-- Honeypot anti-spam — oculto también a lectores de pantalla (FORM-002):
       display:none + aria-hidden evitan que un usuario de AT lo marque por error
       y su mensaje sea descartado como spam. -->
  <input
    type="checkbox"
    name="botcheck"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Nombre -->
    <div>
      <label for="nombre" class="block text-sm font-semibold text-text mb-1.5">
        <EditableText entry="contact.form" field="nameLabel">{getCmsText('contact.form', 'nameLabel', 'Nombre')}</EditableText>
        <span class="text-error" aria-hidden="true">*</span>
      </label>
      <input
        id="nombre"
        name="nombre"
        type="text"
        required
        aria-required="true"
        minlength="2"
        autocomplete="name"
        placeholder={getCmsText('contact.form', 'namePlaceholder', 'Su nombre completo')}
        aria-describedby="nombre-error"
        class="form-input"
      />
      <p id="nombre-error" class="mt-1.5 text-xs text-error hidden" aria-live="polite"></p>
    </div>

    <!-- Empresa -->
    <div>
      <label for="empresa" class="block text-sm font-semibold text-text mb-1.5">
        <EditableText entry="contact.form" field="companyLabel">{getCmsText('contact.form', 'companyLabel', 'Empresa')}</EditableText>
      </label>
      <input
        id="empresa"
        name="empresa"
        type="text"
        autocomplete="organization"
        placeholder={getCmsText('contact.form', 'companyPlaceholder', 'Nombre de su empresa')}
        class="form-input"
      />
    </div>

    <!-- Email -->
    <div>
      <label for="email" class="block text-sm font-semibold text-text mb-1.5">
        <EditableText entry="contact.form" field="emailLabel">{getCmsText('contact.form', 'emailLabel', 'Correo electrónico')}</EditableText>
        <span class="text-error" aria-hidden="true">*</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        aria-required="true"
        autocomplete="email"
        placeholder={getCmsText('contact.form', 'emailPlaceholder', 'correo@empresa.com')}
        aria-describedby="email-error"
        class="form-input"
      />
      <p id="email-error" class="mt-1.5 text-xs text-error hidden" aria-live="polite"></p>
    </div>

    <!-- Teléfono -->
    <div>
      <label for="telefono" class="block text-sm font-semibold text-text mb-1.5">
        <EditableText entry="contact.form" field="phoneLabel">{getCmsText('contact.form', 'phoneLabel', 'Teléfono')}</EditableText>
      </label>
      <input
        id="telefono"
        name="telefono"
        type="tel"
        autocomplete="tel"
        placeholder={getCmsText('contact.form', 'phonePlaceholder', '+56 9 1234 5678')}
        class="form-input"
      />
    </div>
  </div>

  <!-- Servicio -->
  <div>
    <label for="servicio" class="block text-sm font-semibold text-text mb-1.5">
      <EditableText entry="contact.form" field="serviceLabel">{getCmsText('contact.form', 'serviceLabel', 'Servicio de interés (opcional)')}</EditableText>
    </label>
    <select
      id="servicio"
      name="servicio"
      class="w-full min-h-[44px] border border-border rounded-md px-3.5 py-3 text-text bg-white text-base md:text-sm transition-[border-color,outline] duration-fast focus:border-primary focus:outline focus:outline-[3px] focus:outline-primary/20"
    >
      <option value="">{getCmsText('contact.form', 'servicePlaceholder', 'Seleccione un servicio (opcional)')}</option>
      {servicios.map((s) => <option value={s}>{s}</option>)}
    </select>
  </div>

  <!-- Mensaje -->
  <div>
    <label for="mensaje" class="block text-sm font-semibold text-text mb-1.5">
      <EditableText entry="contact.form" field="messageLabel">{getCmsText('contact.form', 'messageLabel', 'Mensaje')}</EditableText>
      <span class="text-error" aria-hidden="true">*</span>
    </label>
    <textarea
      id="mensaje"
      name="mensaje"
      required
      aria-required="true"
      rows={5}
      maxlength={2000}
      placeholder={getCmsText('contact.form', 'messagePlaceholder', 'Describa su proyecto o consulta técnica.')}
      aria-describedby="mensaje-error"
      class="w-full border border-border rounded-md px-3.5 py-3 text-text bg-white text-base md:text-sm leading-relaxed resize-y transition-[border-color,outline] duration-fast focus:border-primary focus:outline focus:outline-[3px] focus:outline-primary/20"
    ></textarea>
    <p id="mensaje-error" class="mt-1.5 text-xs text-error hidden" aria-live="polite"></p>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center gap-4">
    <button
      type="submit"
      id="contacto-submit"
      class="inline-flex items-center justify-center gap-2 bg-primary text-white font-semibold font-body text-base px-6 py-3 min-h-[44px] rounded-md border border-primary hover:bg-primary-dark hover:border-primary-dark transition-[background-color,border-color,opacity] duration-base ease-standard focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary/30 disabled:opacity-60 disabled:cursor-wait"
    >
      <span id="contacto-submit-text">
        <EditableText entry="contact.form" field="submitLabel">
          {getCmsText('contact.form', 'submitLabel', 'Enviar consulta')}
        </EditableText>
      </span>
      <span id="contacto-submit-loading" class="hidden" aria-hidden="true">
        <svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.25"/><path d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z" fill="currentColor"/></svg>
        Enviando...
      </span>
      <ArrowIcon />
    </button>
    <EditableText as="p" entry="contact.form" field="requiredNote" type="textarea" class="text-xs text-text-muted">
      {getCmsText('contact.form', 'requiredNote', 'Los campos marcados con * son obligatorios. Te contactaremos a la brevedad.')}
    </EditableText>
  </div>
</form>

<script is:inline type="application/json" id="contact-form-messages" set:html={JSON.stringify(validationMessages)} />

<script>
const form = document.getElementById('contacto-form') as HTMLFormElement | null;

const messagesEl = document.getElementById('contact-form-messages');
const MENSAJES = JSON.parse(messagesEl?.textContent ?? '{}') as Record<string, { valueMissing: string; typeMismatch?: string; tooShort?: string }>;
const GENERIC = MENSAJES.generic ?? { valueMissing: 'Campo requerido.', typeMismatch: 'Valor inválido.', tooShort: 'Valor demasiado corto.' };

function validateField(field: HTMLInputElement | HTMLTextAreaElement): boolean {
  const errorEl = document.getElementById(`${field.id}-error`);
  if (!errorEl) return field.validity.valid;

  let msg = '';
  if (field.validity.valueMissing)  msg = MENSAJES[field.id]?.valueMissing ?? GENERIC.valueMissing;
  else if (field.validity.typeMismatch) msg = MENSAJES[field.id]?.typeMismatch ?? GENERIC.typeMismatch ?? GENERIC.valueMissing;
  else if (field.validity.tooShort) msg = MENSAJES[field.id]?.tooShort ?? GENERIC.tooShort ?? GENERIC.valueMissing;

  const invalid = !!msg;
  field.setAttribute('aria-invalid', String(invalid));
  errorEl.textContent = msg;
  errorEl.classList.toggle('hidden', !invalid);
  if (invalid) {
    field.classList.add('border-error', 'focus:border-error');
    field.classList.remove('border-border');
  } else {
    field.classList.remove('border-error', 'focus:border-error');
    field.classList.add('border-border');
  }
  return !invalid;
}

if (form) {
  const requiredFields = Array.from(
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')
  );

  requiredFields.forEach((field) => {
    field.addEventListener('blur', () => validateField(field));
    field.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') === 'true') validateField(field);
    });
  });

  form.addEventListener('submit', (e) => {
    let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;
    let allValid = true;
    requiredFields.forEach((field) => {
      const valid = validateField(field);
      if (!valid) {
        allValid = false;
        if (!firstInvalid) firstInvalid = field;
      }
    });
    if (!allValid) {
      e.preventDefault();
      (firstInvalid as HTMLElement | null)?.focus();
      return;
    }
    // Show loading state
    const submitBtn = document.getElementById('contacto-submit') as HTMLButtonElement | null;
    const submitText = document.getElementById('contacto-submit-text');
    const submitLoading = document.getElementById('contacto-submit-loading');
    const submitArrow = document.getElementById('contacto-submit-arrow');
    if (submitBtn) submitBtn.disabled = true;
    if (submitText) submitText.classList.add('hidden');
    if (submitLoading) submitLoading.classList.remove('hidden');
    if (submitArrow) submitArrow.classList.add('hidden');
  });
}
</script>
