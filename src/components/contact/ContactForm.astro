---
import EditableText from '../cms/EditableText.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';
import { getCmsText, getCmsValue } from '../../data/cms';
import { safeJsonForScript } from '../../utils/safeJson';

// A2-005 / A-12: fallback al buzón corporativo, nunca a una cuenta personal.
// La variable llegó a apuntar a un gmail personal, así que el fallback es la
// última defensa si el build de producción no la define.
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'hidromont@hidromont.cl';

// UIUX-L5 fix: the form always POSTs via fetch to the `/ajax/` endpoint and
// never navigates, so `/contacto/gracias` was unreachable. `action`/`_next`
// now target the non-ajax endpoint so a no-JS submission redirects there
// natively; the JS-enabled path below reads `data-ajax-action` instead of
// `form.action` to keep using the JSON endpoint.
const ajaxAction = `https://formsubmit.co/ajax/${contactEmail}`;
const nativeAction = `https://formsubmit.co/${contactEmail}`;
const nextUrl = new URL('/contacto/gracias', Astro.site).href;

const ccEmails = [
  import.meta.env.FORMSUBMIT_CC_1,
  import.meta.env.FORMSUBMIT_CC_2,
  import.meta.env.FORMSUBMIT_CC_3,
  import.meta.env.FORMSUBMIT_CC_4,
]
  .filter(Boolean)
  .join(',');

const servicios = getCmsValue<string[]>('contact.form', 'services', [
  'Tuberías Forzadas y Blindajes',
  'Compuertas',
  'Válvulas Hidráulicas',
  'Turbinas Hidráulicas',
  'Limpiarrejas',
  'Montajes y Fabricaciones Especiales',
  'Otro',
]);

const validationMessages = {
  nombre: {
    valueMissing: getCmsText('contact.form', 'nameRequiredError', 'Por favor ingrese su nombre.'),
    tooShort: getCmsText(
      'contact.form',
      'nameTooShortError',
      'El nombre debe tener al menos 2 caracteres.'
    ),
  },
  email: {
    valueMissing: getCmsText(
      'contact.form',
      'emailRequiredError',
      'Por favor ingrese su correo electrónico.'
    ),
    typeMismatch: getCmsText(
      'contact.form',
      'emailInvalidError',
      'Ingrese un correo válido (ej. correo@empresa.com).'
    ),
  },
  mensaje: {
    valueMissing: getCmsText(
      'contact.form',
      'messageRequiredError',
      'Por favor escriba su consulta o mensaje.'
    ),
  },
  generic: {
    valueMissing: getCmsText('contact.form', 'genericRequiredError', 'Campo requerido.'),
    typeMismatch: getCmsText('contact.form', 'genericInvalidError', 'Valor inválido.'),
    tooShort: getCmsText('contact.form', 'genericTooShortError', 'Valor demasiado corto.'),
  },
};
---

<form
  id="contacto-form"
  action={nativeAction}
  method="POST"
  class="space-y-6"
  data-ajax-action={ajaxAction}
>
  <!-- FormSubmit.co config -->
  <input
    type="hidden"
    name="_subject"
    value={getCmsText('contact.form', 'subject', 'Nuevo contacto desde hidromontchile.cl')}
  />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_next" value={nextUrl} />
  {ccEmails && <input type="hidden" name="_cc" value={ccEmails} />}
  <!-- Honeypot anti-spam (FORM-002): campo oculto que los bots rellenan y hace descartar el envío. -->
  <input
    type="text"
    name="_honey"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Nombre -->
    <div>
      <label for="nombre" class="block text-sm font-semibold text-text mb-1.5">
        <EditableText entry="contact.form" field="nameLabel"
          >{getCmsText('contact.form', 'nameLabel', 'Nombre')}</EditableText
        >
        <span class="text-error" aria-hidden="true">*</span>
      </label>
      <input
        id="nombre"
        name="nombre"
        type="text"
        required
        aria-required="true"
        minlength="2"
        autocomplete="name"
        placeholder={getCmsText('contact.form', 'namePlaceholder', 'Su nombre completo')}
        aria-describedby="nombre-error"
        class="form-input rounded-none"
      />
      <p id="nombre-error" class="mt-1.5 text-xs text-error hidden" aria-live="polite"></p>
    </div>

    <!-- Empresa -->
    <div>
      <label for="empresa" class="block text-sm font-semibold text-text mb-1.5">
        <EditableText entry="contact.form" field="companyLabel"
          >{getCmsText('contact.form', 'companyLabel', 'Empresa')}</EditableText
        >
      </label>
      <input
        id="empresa"
        name="empresa"
        type="text"
        autocomplete="organization"
        placeholder={getCmsText('contact.form', 'companyPlaceholder', 'Nombre de su empresa')}
        class="form-input rounded-none"
      />
    </div>

    <!-- Email -->
    <div>
      <label for="email" class="block text-sm font-semibold text-text mb-1.5">
        <EditableText entry="contact.form" field="emailLabel"
          >{getCmsText('contact.form', 'emailLabel', 'Correo electrónico')}</EditableText
        >
        <span class="text-error" aria-hidden="true">*</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        aria-required="true"
        autocomplete="email"
        placeholder={getCmsText('contact.form', 'emailPlaceholder', 'correo@empresa.com')}
        aria-describedby="email-error"
        class="form-input rounded-none"
      />
      <p id="email-error" class="mt-1.5 text-xs text-error hidden" aria-live="polite"></p>
    </div>

    <!-- Teléfono -->
    <div>
      <label for="telefono" class="block text-sm font-semibold text-text mb-1.5">
        <EditableText entry="contact.form" field="phoneLabel"
          >{getCmsText('contact.form', 'phoneLabel', 'Teléfono')}</EditableText
        >
      </label>
      <input
        id="telefono"
        name="telefono"
        type="tel"
        autocomplete="tel"
        placeholder={getCmsText('contact.form', 'phonePlaceholder', '+56 9 1234 5678')}
        class="form-input rounded-none"
      />
    </div>
  </div>

  <!-- Servicio -->
  <div>
    <label for="servicio" class="block text-sm font-semibold text-text mb-1.5">
      <EditableText entry="contact.form" field="serviceLabel"
        >{
          getCmsText('contact.form', 'serviceLabel', 'Servicio de interés (opcional)')
        }</EditableText
      >
    </label>
    <select
      id="servicio"
      name="servicio"
      class="w-full min-h-[44px] border border-border rounded-none px-3.5 py-3 text-text bg-white text-base md:text-sm transition-[border-color,outline] duration-fast focus:border-primary focus:outline focus:outline-[3px] focus:outline-primary/20"
    >
      <option value=""
        >{
          getCmsText('contact.form', 'servicePlaceholder', 'Seleccione un servicio (opcional)')
        }</option
      >
      {servicios.map((s) => <option value={s}>{s}</option>)}
    </select>
  </div>

  <!-- Mensaje -->
  <div>
    <label for="mensaje" class="block text-sm font-semibold text-text mb-1.5">
      <EditableText entry="contact.form" field="messageLabel"
        >{getCmsText('contact.form', 'messageLabel', 'Mensaje')}</EditableText
      >
      <span class="text-error" aria-hidden="true">*</span>
    </label>
    <textarea
      id="mensaje"
      name="mensaje"
      required
      aria-required="true"
      rows={5}
      maxlength={2000}
      placeholder={getCmsText(
        'contact.form',
        'messagePlaceholder',
        'Describa su proyecto o consulta técnica.'
      )}
      aria-describedby="mensaje-error"
      class="w-full border border-border rounded-none px-3.5 py-3 text-text bg-white text-base md:text-sm leading-relaxed resize-y transition-[border-color,outline] duration-fast focus:border-primary focus:outline focus:outline-[3px] focus:outline-primary/20"
    ></textarea>
    <p id="mensaje-error" class="mt-1.5 text-xs text-error hidden" aria-live="polite"></p>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center gap-4">
    <button
      type="submit"
      id="contacto-submit"
      class="inline-flex items-center justify-center bg-primary text-white font-semibold font-body text-base px-6 py-3 min-h-[44px] rounded-none border border-primary hover:bg-primary-dark hover:border-primary-dark transition-[background-color,border-color,opacity] duration-base ease-standard focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2 focus-visible:outline-primary/30 disabled:opacity-60 disabled:cursor-wait whitespace-nowrap"
    >
      <span class="grid">
        <span id="contacto-submit-text" class="col-start-1 row-start-1 flex items-center gap-2">
          <EditableText entry="contact.form" field="submitLabel">
            {getCmsText('contact.form', 'submitLabel', 'Enviar consulta')}
          </EditableText>
          <ArrowIcon />
        </span>
        <span
          id="contacto-submit-loading"
          class="col-start-1 row-start-1 flex items-center gap-2 invisible"
          aria-hidden="true"
        >
          <svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none"
            ><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.25"
            ></circle><path d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z" fill="currentColor"></path></svg
          >
          Enviando...
        </span>
      </span>
    </button>
    <EditableText
      as="p"
      entry="contact.form"
      field="requiredNote"
      type="textarea"
      class="text-xs text-text-muted"
    >
      {
        getCmsText(
          'contact.form',
          'requiredNote',
          'Los campos marcados con * son obligatorios. Le contactaremos después de revisar su consulta.'
        )
      }
    </EditableText>
  </div>
  <p id="contacto-submit-status" class="sr-only" role="status" aria-live="polite"></p>
</form>

<div
  id="contacto-success"
  class="hidden py-10 text-center space-y-3"
  role="status"
  aria-live="polite"
  tabindex="-1"
>
  <p class="text-lg font-semibold text-text">
    {getCmsText('contact.form', 'successTitle', '¡Mensaje enviado!')}
  </p>
  <p class="text-sm text-text-muted">
    {
      getCmsText(
        'contact.form',
        'successBody',
        'Hemos recibido su consulta. Le contactaremos después de revisarla.'
      )
    }
  </p>
</div>

<div
  id="contacto-error"
  class="hidden py-4 px-4 border border-error text-error text-sm"
  role="alert"
  aria-live="assertive"
>
  <span id="contacto-error-message">
    {
      getCmsText(
        'contact.form',
        'errorBody',
        'Ocurrió un error al enviar el formulario. Por favor intente nuevamente o escríbanos directamente.'
      )
    }
  </span>
  {' '}
  <a
    href={`mailto:${contactEmail}?subject=${encodeURIComponent('Consulta desde Hidromont.cl')}`}
    class="font-semibold underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-error"
  >
    Contactar por correo ({contactEmail})
  </a>
</div>

<script
  is:inline
  type="application/json"
  id="contact-form-messages"
  set:html={safeJsonForScript(validationMessages)}
/>

<script>
  const form = document.getElementById('contacto-form') as HTMLFormElement | null;

  const messagesEl = document.getElementById('contact-form-messages');
  // JS-5 fix: this used to parse unguarded at module scope — a single malformed
  // CMS value here threw before any listener below got attached, silently
  // disabling client-side validation for the whole form (the submit button
  // still worked, just fell through to a raw POST with no validation feedback).
  let MENSAJES: Record<string, { valueMissing: string; typeMismatch?: string; tooShort?: string }> =
    {};
  try {
    MENSAJES = JSON.parse(messagesEl?.textContent ?? '{}');
  } catch (error) {
    console.error('Error al parsear los mensajes de validación del formulario', error);
  }
  const GENERIC = MENSAJES.generic ?? {
    valueMissing: 'Campo requerido.',
    typeMismatch: 'Valor inválido.',
    tooShort: 'Valor demasiado corto.',
  };

  function validateField(field: HTMLInputElement | HTMLTextAreaElement): boolean {
    const errorEl = document.getElementById(`${field.id}-error`);
    if (!errorEl) return field.validity.valid;

    let msg = '';
    if (field.validity.valueMissing) msg = MENSAJES[field.id]?.valueMissing ?? GENERIC.valueMissing;
    else if (field.validity.typeMismatch)
      msg = MENSAJES[field.id]?.typeMismatch ?? GENERIC.typeMismatch ?? GENERIC.valueMissing;
    else if (field.validity.tooShort)
      msg = MENSAJES[field.id]?.tooShort ?? GENERIC.tooShort ?? GENERIC.valueMissing;

    const invalid = !!msg;
    field.setAttribute('aria-invalid', String(invalid));
    errorEl.textContent = msg;
    errorEl.classList.toggle('hidden', !invalid);
    if (invalid) {
      field.classList.add('border-error', 'focus:border-error');
      field.classList.remove('border-border');
    } else {
      field.classList.remove('border-error', 'focus:border-error');
      field.classList.add('border-border');
    }
    return !invalid;
  }

  if (form) {
    const requiredFields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')
    );
    let isSubmitting = false;

    requiredFields.forEach((field) => {
      field.addEventListener('blur', () => validateField(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validateField(field);
      });
    });

    // Use the custom inline errors only after this script has initialized. If
    // JavaScript never loads, the browser's native required/type/minlength
    // validation remains active for the native POST fallback.
    form.noValidate = true;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isSubmitting) return;

      // A2-004: anti-spam ligero del lado del cliente. Limita a 3 envíos por ventana
      // de 5 minutos (persistente en sessionStorage para sobrevivir recargas dentro de
      // la sesión). Es defensa en profundidad junto al honeypot _honey; el rate-limit
      // server-side real lo provee FormSubmit.co.
      const RATE_LIMIT_MAX = 3;
      const RATE_LIMIT_WINDOW_MS = 5 * 60 * 1000;
      // Store only provider-accepted submissions. Transport failures and
      // provider rejections remain retryable and do not consume this allowance.
      const RATE_KEY = 'hidromont:contact:accepted-submits';
      const errorBanner = document.getElementById('contacto-error');
      const errorMessage = document.getElementById('contacto-error-message');
      // JS-L2 fix: captured once, before any mutation, so the generic-error
      // path can restore it — previously a rate-limit message overwrote this
      // banner's text, and a later network failure just re-showed the banner
      // without resetting it, leaving the stale rate-limit copy on screen.
      const defaultErrorText = errorMessage?.textContent?.trim() ?? '';
      const now = Date.now();
      let timestamps: number[] = [];
      try {
        timestamps = JSON.parse(sessionStorage.getItem(RATE_KEY) ?? '[]').filter(
          (t: number) => Number.isFinite(t) && now - t < RATE_LIMIT_WINDOW_MS
        );
      } catch {
        timestamps = [];
      }
      if (timestamps.length >= RATE_LIMIT_MAX) {
        const retrySec = Math.ceil((RATE_LIMIT_WINDOW_MS - (now - timestamps[0])) / 1000);
        if (errorBanner && errorMessage) {
          errorMessage.textContent = `Ya se aceptaron varios envíos desde este navegador. Intente nuevamente en ${retrySec} segundos o use el correo indicado.`;
          errorBanner.classList.remove('hidden');
        }
        return;
      }

      let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;
      let allValid = true;
      requiredFields.forEach((field) => {
        const valid = validateField(field);
        if (!valid) {
          allValid = false;
          if (!firstInvalid) firstInvalid = field;
        }
      });
      if (!allValid) {
        (firstInvalid as HTMLElement | null)?.focus();
        return;
      }

      const submitBtn = document.getElementById('contacto-submit') as HTMLButtonElement | null;
      const submitText = document.getElementById('contacto-submit-text');
      const submitLoading = document.getElementById('contacto-submit-loading');
      if (submitBtn) submitBtn.disabled = true;
      isSubmitting = true;
      if (submitText) submitText.classList.add('invisible');
      if (submitLoading) submitLoading.classList.remove('invisible');
      if (errorBanner) errorBanner.classList.add('hidden');

      // UIUX-L6 fix: the visible spinner/"Enviando..." span stays aria-hidden
      // (it's a redundant visual echo), so this sr-only status is what
      // actually tells screen reader users a submission is in progress.
      const statusEl = document.getElementById('contacto-submit-status');
      if (statusEl) statusEl.textContent = 'Enviando su consulta, por favor espere…';
      submitBtn?.setAttribute('aria-busy', 'true');

      try {
        const ajaxAction =
          (form as HTMLFormElement).dataset.ajaxAction ?? (form as HTMLFormElement).action;
        const res = await fetch(ajaxAction, {
          method: 'POST',
          body: new FormData(form as HTMLFormElement),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error('provider-error');
        const json = (await res.json()) as { success: string | boolean };
        if (json.success === 'true' || json.success === true) {
          timestamps.push(Date.now());
          try {
            sessionStorage.setItem(RATE_KEY, JSON.stringify(timestamps));
          } catch {
            /* The server remains responsible for rate limiting if storage is unavailable. */
          }
          (form as HTMLFormElement).classList.add('hidden');
          if (statusEl) statusEl.textContent = '';
          // UIUX-10 fix: previously focus stayed on the now-hidden submit
          // button after success — nothing told a keyboard/screen-reader
          // user the page had changed until they happened to tab past it.
          const successEl = document.getElementById('contacto-success');
          successEl?.classList.remove('hidden');
          successEl?.focus();
        } else {
          throw new Error('rejected');
        }
      } catch {
        if (statusEl) statusEl.textContent = '';
        if (errorBanner && errorMessage) {
          errorMessage.textContent = defaultErrorText;
          errorBanner.classList.remove('hidden');
        }
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.classList.remove('invisible');
        if (submitLoading) submitLoading.classList.add('invisible');
      } finally {
        isSubmitting = false;
        submitBtn?.removeAttribute('aria-busy');
      }
    });
  }
</script>
