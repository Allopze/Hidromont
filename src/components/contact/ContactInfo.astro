---
import { company } from '../../data/company';
import EditableText from '../cms/EditableText.astro';
import { getCmsText } from '../../data/cms';
---

<div class="space-y-6">
  <div>
    {
      /* UIUX-L7 fix: this was h3 while the sibling form section (contacto.astro)
         titles itself h2 — same heading depth, so both should share a level. */
    }
    <EditableText
      as="h2"
      entry="contact.info"
      field="title"
      class="font-heading font-semibold text-primary-dark mb-4"
      style="font-size: var(--font-size-h4);"
    >
      {getCmsText('contact.info', 'title', 'Información de contacto')}
    </EditableText>
    <div class="space-y-4">
      <div class="flex gap-3">
        <div class="shrink-0 mt-0.5 text-primary">
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle
              cx="12"
              cy="10"
              r="3"></circle>
          </svg>
        </div>
        <div>
          <EditableText
            as="p"
            entry="contact.info"
            field="addressLabel"
            class="text-sm font-semibold text-text"
          >
            {getCmsText('contact.info', 'addressLabel', 'Dirección')}
          </EditableText>
          <EditableText
            as="p"
            entry="site.company"
            field="domicilio"
            class="text-sm text-text-muted">{company.domicilio}</EditableText
          >
          <EditableText as="p" entry="site.company" field="ciudad" class="text-sm text-text-muted"
            >{company.ciudad}</EditableText
          >
          <div class="flex flex-wrap gap-2 mt-3">
            <a
              href="https://www.google.com/maps/dir/?api=1&destination=Hidromont+Chile+S.A.,+Avenida+Las+Industrias+10950,+Los+Angeles,+Chile"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary text-white text-xs font-semibold rounded-none hover:bg-primary-dark transition-colors no-underline"
            >
              <svg
                class="w-3.5 h-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <EditableText entry="contact.info" field="enlaceGoogleMaps">
                {getCmsText('contact.info', 'enlaceGoogleMaps', 'Google Maps')}
              </EditableText>
            </a>
            <a
              href="https://waze.com/ul?q=Hidromont%20Chile%20S.A.,%20Avenida%20Las%20Industrias%2010950,%20Los%20Angeles,%20Chile&navigate=yes"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white text-text border border-border text-xs font-semibold rounded-none hover:bg-primary-light hover:border-primary hover:text-primary-dark transition-all no-underline"
            >
              <svg class="w-3.5 h-3.5 text-[#33CCFF]" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M13.314 1.59c-.225.003-.45.013-.675.03-2.165.155-4.295.924-6.069 2.327-2.194 1.732-3.296 4.325-3.496 7.05h.002c-.093 1.22-.23 2.15-.469 2.63-.238.479-.42.638-1.24.639C.27 14.259-.4 15.612.266 16.482c1.248 1.657 2.902 2.705 4.72 3.364a2.198 2.198 0 00-.033.367 2.198 2.198 0 002.2 2.197 2.198 2.198 0 002.128-1.668c1.307.12 2.607.14 3.824.1.364-.012.73-.045 1.094-.092a2.198 2.198 0 002.127 1.66 2.198 2.198 0 002.2-2.197 2.198 2.198 0 00-.151-.797 12.155 12.155 0 002.303-1.549c2.094-1.807 3.511-4.399 3.302-7.404-.112-1.723-.761-3.298-1.748-4.608-2.143-2.86-5.53-4.309-8.918-4.265zm.366 1.54c.312.008.623.027.933.063 2.48.288 4.842 1.496 6.4 3.577v.001c.829 1.1 1.355 2.386 1.446 3.792v.003c.173 2.477-.965 4.583-2.777 6.147a10.66 10.66 0 01-2.375 1.535 2.198 2.198 0 00-.98-.234 2.198 2.198 0 00-1.934 1.158 9.894 9.894 0 01-1.338.146 27.323 27.323 0 01-3.971-.148 2.198 2.198 0 00-1.932-1.156 2.198 2.198 0 00-1.347.463c-1.626-.553-3.078-1.422-4.155-2.762 1.052-.096 1.916-.6 2.319-1.408.443-.889.53-1.947.625-3.198v-.002c.175-2.391 1.11-4.536 2.92-5.964h.002c1.77-1.402 3.978-2.061 6.164-2.012z"
                ></path>
              </svg>
              <EditableText entry="contact.info" field="enlaceWaze">
                {getCmsText('contact.info', 'enlaceWaze', 'Waze')}
              </EditableText>
            </a>
          </div>
        </div>
      </div>

      <div class="flex gap-3">
        <div class="shrink-0 mt-0.5 text-primary">
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          >
            <path
              d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.68A2 2 0 012.18 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 8.15a16 16 0 006.94 6.94l1.52-1.52a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"
            ></path>
          </svg>
        </div>
        <div>
          <EditableText
            as="p"
            entry="contact.info"
            field="phoneLabel"
            class="text-sm font-semibold text-text"
          >
            {getCmsText('contact.info', 'phoneLabel', 'Teléfono')}
          </EditableText>
          <a
            href={`tel:${company.telefono.replace(/\s/g, '')}`}
            class="inline-flex min-h-[24px] items-center text-sm text-primary hover:text-primary-dark"
          >
            <EditableText entry="site.company" field="telefono">{company.telefono}</EditableText>
          </a>
        </div>
      </div>

      <div class="flex gap-3">
        <div class="shrink-0 mt-0.5 text-primary">
          <svg
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          >
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path><polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div>
          <EditableText
            as="p"
            entry="contact.info"
            field="emailLabel"
            class="text-sm font-semibold text-text"
          >
            {getCmsText('contact.info', 'emailLabel', 'Correo electrónico')}
          </EditableText>
          <a
            href={`mailto:${company.email}`}
            class="inline-flex min-h-[24px] items-center text-sm text-primary hover:text-primary-dark"
          >
            <EditableText entry="site.company" field="email">{company.email}</EditableText>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
