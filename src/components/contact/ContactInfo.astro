---
import { company } from '../../data/company';
import EditableText from '../cms/EditableText.astro';
import { getCmsText } from '../../data/cms';
---

<div class="space-y-6">
  <div>
    <EditableText as="h3" entry="contact.info" field="title" class="font-heading font-semibold text-primary-dark mb-4" style="font-size: var(--font-size-h4);">
      {getCmsText('contact.info', 'title', 'Información de contacto')}
    </EditableText>
    <div class="space-y-4">
      <div class="flex gap-3">
        <div class="shrink-0 mt-0.5 text-primary">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div>
          <EditableText as="p" entry="contact.info" field="addressLabel" class="text-sm font-semibold text-text">
            {getCmsText('contact.info', 'addressLabel', 'Dirección')}
          </EditableText>
          <EditableText as="p" entry="site.company" field="domicilio" class="text-sm text-text-muted">{company.domicilio}</EditableText>
          <EditableText as="p" entry="site.company" field="ciudad" class="text-sm text-text-muted">{company.ciudad}</EditableText>
          <EditableText as="p" entry="site.company" field="casillaPostal" class="text-xs text-text-muted mt-0.5">{company.casillaPostal}</EditableText>
        </div>
      </div>

      <div class="flex gap-3">
        <div class="shrink-0 mt-0.5 text-primary">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.68A2 2 0 012.18 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 8.15a16 16 0 006.94 6.94l1.52-1.52a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
          </svg>
        </div>
        <div>
          <EditableText as="p" entry="contact.info" field="phoneLabel" class="text-sm font-semibold text-text">
            {getCmsText('contact.info', 'phoneLabel', 'Teléfono')}
          </EditableText>
          <a href={`tel:${company.telefono.replace(/\s/g, '')}`} class="text-sm text-primary hover:text-primary-dark">
            <EditableText entry="site.company" field="telefono">{company.telefono}</EditableText>
          </a>
        </div>
      </div>

      <div class="flex gap-3">
        <div class="shrink-0 mt-0.5 text-primary">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div>
          <EditableText as="p" entry="contact.info" field="emailLabel" class="text-sm font-semibold text-text">
            {getCmsText('contact.info', 'emailLabel', 'Correo electrónico')}
          </EditableText>
          <a href={`mailto:${company.email}`} class="text-sm text-primary hover:text-primary-dark">
            <EditableText entry="site.company" field="email">{company.email}</EditableText>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="p-5 bg-primary-light rounded-lg border border-border">
    <EditableText as="p" entry="contact.info" field="note" type="textarea" class="text-sm text-text-muted leading-relaxed">
      {getCmsText('contact.info', 'note', 'Envíenos sus antecedentes y nuestro equipo técnico responderá a la brevedad. Si necesita compartir planos, fichas técnicas u otros documentos, indíquelo en su mensaje y se los solicitaremos por correo.')}
    </EditableText>
  </div>
</div>
