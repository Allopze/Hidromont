---
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  bullets?: string[];
}

const { title, description, href, icon, bullets } = Astro.props;

const icons: Record<string, string> = {
  pipe: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8H3M21 16H3M5 8V16M19 8V16M3 12h1M20 12h1"/></svg>`,
  gate: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 9h18M3 15h18M9 9v6M15 9v6"/></svg>`,
  valve: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 2v5M12 17v5M2 12h5M17 12h5"/></svg>`,
  turbine: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 9V3M12 21v-6M9 12H3M21 12h-6M15.5 8.5l-2-2M10.5 15.5l-2-2M15.5 15.5l-2 2M10.5 8.5l-2 2"/></svg>`,
  rack: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M8 4v16M12 4v16M16 4v16M4 8h16M4 12h16M4 16h16"/></svg>`,
  crane: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 8h20L12 2zM4 8v14h16V8M8 12h8M8 16h8"/></svg>`,
};

const iconSvg = icon ? (icons[icon] ?? icons.pipe) : icons.pipe;
---

<article class="bg-surface border border-border rounded-lg p-8 flex flex-col gap-5 transition-[border-color,box-shadow,transform] duration-slow ease-standard hover:border-primary hover:shadow-md hover:-translate-y-0.5 group">
  <!-- Icon -->
  <div
    class="w-12 h-12 text-primary"
    aria-hidden="true"
    set:html={iconSvg}
  />

  <!-- Content -->
  <div class="flex-1">
    <h3 class="font-heading font-semibold text-primary-dark mb-2" style="font-size: var(--font-size-h4);">
      {title}
    </h3>
    <p class="text-text-muted text-sm leading-relaxed">{description}</p>

    {bullets && bullets.length > 0 && (
      <ul class="mt-4 space-y-1.5">
        {bullets.slice(0, 4).map((b) => (
          <li class="flex items-start gap-2 text-sm text-text-muted">
            <span class="mt-1 shrink-0 w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true" />
            {b}
          </li>
        ))}
      </ul>
    )}
  </div>

  <Button href={href} variant="link" class="self-start mt-auto group-hover:text-primary-dark">
    Ver servicio
    <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M3 8h10M9 4l4 4-4 4" />
    </svg>
  </Button>
</article>
