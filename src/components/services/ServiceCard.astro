---
import type { IconoServicio } from '../../data/content-vocabulary';
import { ICONOS_SERVICIO_SVG } from '../../data/iconos-servicio';
import Button from '../ui/Button.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';
import EditableText from '../cms/EditableText.astro';
import { getCmsText } from '../../data/cms';

interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
  /** Icono subido desde el CMS; si está, sustituye a `icon`. */
  iconoPropio?: string;
  bullets?: string[];
  /** Cuántos elementos de `bullets` se ven. */
  maxBullets?: number;
  compact?: boolean;
  /**
   * La ficha del servicio en el CMS (`servicios.<slug>`). Con ella el título,
   * el resumen y los tipos de la tarjeta se editan pulsándolos, igual que en
   * la página del servicio; sin ella la tarjeta es solo texto.
   */
  cmsEntry?: string;
}

const {
  title,
  description,
  href,
  icon,
  iconoPropio,
  bullets,
  maxBullets = 3,
  compact = false,
  cmsEntry,
} = Astro.props;
const bulletsVisibles = bullets?.slice(0, maxBullets) ?? [];

// El icono propio (subido desde el CMS) se pinta con una máscara del color del
// texto, igual que los de la lista: así un SVG o PNG de un solo color queda
// en el azul del sitio y cambia de color al pasar el puntero como los demás.
const iconSvg = ICONOS_SERVICIO_SVG[icon as IconoServicio] ?? ICONOS_SERVICIO_SVG.pipe;
// Solo una ruta local de imagen: el valor va dentro de un `style`.
const iconoSeguro =
  iconoPropio && /^\/[\w\-./]+\.(png|webp|jpe?g)$/i.test(iconoPropio) ? iconoPropio : undefined;
const cmsEditingEnabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_CMS === '1';
// Con el editor, el icono se cambia pulsándolo: elegir otro de la lista o
// subir uno propio. `data-cms-icono` dice cuál de la lista está puesto.
const marcasIcono =
  cmsEditingEnabled && cmsEntry
    ? {
        'data-cms-entry': cmsEntry,
        'data-cms-field': 'iconoPropio',
        'data-cms-type': 'icono',
        'data-cms-icono': icon ?? 'pipe',
      }
    : {};
---

<article
  class:list={[
    'card-lift bg-surface border border-border rounded-none flex flex-col hover:border-primary hover:bg-primary-light hover:shadow-md group',
    compact ? 'p-6 gap-4' : 'p-8 gap-5',
  ]}
>
  <!-- Icon -->
  {
    iconoSeguro ? (
      <div class="w-12 h-12 text-primary" aria-hidden="true" {...marcasIcono}>
        <span class="icono-propio" style={`--icono: url('${iconoSeguro}')`} />
      </div>
    ) : (
      <div class="w-12 h-12 text-primary" aria-hidden="true" {...marcasIcono} set:html={iconSvg} />
    )
  }

  <!-- Content -->
  <div class="flex-1">
    <EditableText
      as="h3"
      entry={cmsEntry}
      field="titulo"
      class="font-heading font-semibold text-primary-dark mb-2"
      style="font-size: var(--font-size-h4);"
    >
      {title}
    </EditableText>
    <EditableText
      as="p"
      entry={cmsEntry}
      field="resumen"
      type="textarea"
      class="text-text-muted text-sm leading-relaxed"
    >
      {description}
    </EditableText>

    {
      !compact && bulletsVisibles.length > 0 && (
        <EditableText
          as="ul"
          entry={cmsEntry}
          field="tipos"
          type="list"
          listMax={maxBullets}
          class="mt-4 space-y-1.5"
        >
          {bulletsVisibles.map((b) => (
            <li class="flex items-start gap-2 text-sm text-text-muted">
              <span class="mt-1 shrink-0 w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true" />
              {b}
            </li>
          ))}
        </EditableText>
      )
    }
  </div>

  <Button href={href} variant="link" class="self-start mt-auto group-hover:text-primary-dark">
    <EditableText entry="plantilla.tarjetas" field="verServicio">
      {getCmsText('plantilla.tarjetas', 'verServicio', 'Ver servicio')}
    </EditableText>
    <ArrowIcon class="transition-transform group-hover:translate-x-0.5" />
  </Button>
</article>
