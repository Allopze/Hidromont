# =============================================================================
# Perfil de producción — cPanel con Node.js, CMS y sitio en el mismo proceso
# =============================================================================
#
# El proceso `npm start` (server.mjs → cms/server.ts) sirve a la vez el sitio
# estático de dist/ y la API del CMS. Con esta topología, «Publicar» compila
# dist/ y el cambio queda en línea sin pasos adicionales.
#
# A cambio, el CMS queda expuesto a internet: los guards de arranque de
# cms/server.ts rechazan las combinaciones peligrosas, pero conviene revisar
# cada valor de este archivo antes de desplegar.
#
# Copiar como `.env` en el servidor y completar lo marcado con <>.

# --- Sitio y proceso ---------------------------------------------------------
NODE_ENV=production
# Passenger (cPanel) suele exigir escuchar en localhost y él hace de proxy.
# Verificar con el proveedor: si el proceso debe atender directamente, usar
# 0.0.0.0 y asegurarse de que HTTPS esté delante.
CMS_HOST=127.0.0.1
CMS_PORT=8787
CMS_STATIC_DIR=dist

# --- Contenido y medios ------------------------------------------------------
CMS_DATABASE_PATH=./cms/data/hidromont-cms.sqlite
# IMPORTANTE: fuera de public/. Astro copia public/ entero a dist/ en cada
# build, así que apuntarlo ahí duplicaría los originales en cada compilación.
# El guard de arranque aborta si esta ruta cae dentro de public/.
# Debe sobrevivir a un redespliegue: no la coloques en el árbol que se
# sincroniza con git.
CMS_UPLOAD_DIR=./uploads/cms
CMS_UPLOAD_MAX_BYTES=8388608

# --- Sesión y acceso ---------------------------------------------------------
# Con el CMS accesible desde internet, esto NO es negociable.
CMS_COOKIE_SECURE=1
CMS_COOKIE_NAME=hidromont_cms_session
CMS_SESSION_DAYS=7
# Debe quedar SIN definir: el escape hatch existe solo para LAN sin HTTPS.
CMS_ALLOW_INSECURE_COOKIE=
# Activar solo si hay un reverse proxy de confianza que fije X-Forwarded-For
# él mismo. Passenger lo hace; verificarlo antes de poner 1, porque si no
# cualquier cliente puede falsificar su IP y evadir el rate-limit de login.
CMS_TRUST_PROXY=1
CMS_ALLOWED_ORIGINS=https://hidromont.cl,https://www.hidromont.cl
CMS_ADMIN_EMAIL=<correo del administrador>
# Generar una contraseña larga y única. El arranque falla con la de por
# defecto si el host no es local.
CMS_ADMIN_PASSWORD=<contraseña fuerte>

# --- Publicación -------------------------------------------------------------
# `npm run build` es lo que hace que publicar actualice el sitio servido.
# `npm run check` solo valida y no reconstruye nada.
CMS_PUBLISH_CHECK_COMMAND=npm run build
# Un build completo con procesado de imágenes tarda bastante más en hosting
# compartido que en local. Medirlo en el servidor y ajustar.
CMS_PUBLISH_TIMEOUT_MS=600000

# --- Editor visual -----------------------------------------------------------
# 1 porque la barra del CMS *es* el overlay: sin él no hay interfaz de
# administración en el servidor. Consecuencia aceptada: cada página pública
# carga el JS del overlay, que queda inerte sin sesión iniciada.
PUBLIC_ENABLE_CMS=1
# Vacío: el overlay habla con el mismo origen que sirve la página.
PUBLIC_CMS_API_BASE=

# --- Formulario de contacto --------------------------------------------------
PUBLIC_CONTACT_EMAIL=hidromont@hidromont.cl
FORMSUBMIT_CC_1=
FORMSUBMIT_CC_2=
FORMSUBMIT_CC_3=
FORMSUBMIT_CC_4=

# --- Monitoreo ---------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
