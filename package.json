{
  "name": "hidromont-chile-web",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "cms": "tsx cms/server.ts",
    "start": "node server.mjs",
    "dev:cms": "concurrently \"npm run dev\" \"npm run cms\"",
    "cms:import": "tsx cms/scripts/import.ts",
    "cms:export": "tsx cms/scripts/export.ts",
    "cms:backup": "tsx cms/scripts/backup.ts",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@sentry/node": "^10.56.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.8.5",
    "gray-matter": "^4.0.3",
    "nanoid": "^3.3.12",
    "sharp": "^0.33.5",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/tailwind": "^5.1.5",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource/roboto-condensed": "^5.1.1",
    "@fontsource/roboto-mono": "^5.1.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "^4.1.8",
    "astro": "^4.16.18",
    "concurrently": "^10.0.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  }
}
