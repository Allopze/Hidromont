{
  "name": "hidromont-chile-web",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "cms": "tsx cms/server.ts",
    "start": "node server.mjs",
    "dev:cms": "concurrently \"npm run dev\" \"npm run cms\"",
    "cms:import": "tsx cms/scripts/import.ts",
    "cms:sync-media": "tsx cms/scripts/sync-media.ts",
    "cms:fix-orphan-media": "tsx cms/scripts/fix-orphan-media.ts",
    "cms:import-gallery": "tsx cms/scripts/import-gallery-json.ts",
    "cms:export": "tsx cms/scripts/export.ts",
    "cms:backup": "tsx cms/scripts/backup.ts",
    "cms:migrate-audited-content": "tsx cms/scripts/migrate-audited-content.ts",
    "cms:reset-password": "tsx cms/scripts/reset-password.ts",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "prettier --write",
      "eslint"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@sentry/node": "^10.56.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.8.5",
    "gray-matter": "^4.0.3",
    "nanoid": "^3.3.12",
    "sharp": "^0.33.5",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "3.2.0",
    "@astrojs/tailwind": "^5.1.5",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource/roboto-condensed": "^5.1.1",
    "@fontsource/roboto-mono": "^5.1.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.8",
    "astro": "^4.16.19",
    "concurrently": "^10.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
